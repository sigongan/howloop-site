/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # Always revalidate HTML. Asset filenames are content-hashed and change on
  # every deploy, so a stale HTML page would point at CSS that no longer
  # exists — which renders the page unstyled.
  Cache-Control: public, max-age=0, must-revalidate

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/og-default.svg
  Cache-Control: public, max-age=604800

/desk/*
  X-Robots-Tag: noindex, nofollow

/desk
  X-Robots-Tag: noindex, nofollow

/trade/*
  X-Robots-Tag: noindex, nofollow

/trade
  X-Robots-Tag: noindex, nofollow

# Machine-readable snapshots support the bank explorer; the explorer itself is
# the indexable page with source, scope and freshness explanations.
/data/*
  X-Robots-Tag: noindex
