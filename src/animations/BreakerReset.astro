---
/* Consumer unit: finding the tripped switch and isolating what caused it. */
---

<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="bk">
  <!-- consumer unit -->
  <rect class="box" x="90" y="70" width="620" height="230" rx="12" />
  <path class="ln thin" d="M90 128 H710" />
  <text class="label" x="112" y="112">Consumer unit</text>

  <!-- busbar -->
  <rect class="bus" x="120" y="160" width="560" height="10" rx="5" />

  <!-- main switch -->
  <g class="main">
    <rect class="switchbody" x="120" y="176" width="54" height="92" rx="6" />
    <rect class="toggle" x="132" y="186" width="30" height="34" rx="4" />
    <text class="tiny" x="147" y="288" text-anchor="middle">main</text>
  </g>

  <!-- circuit breakers -->
  <g class="breakers">
    <g class="brk b1">
      <rect class="switchbody" x="212" y="176" width="54" height="92" rx="6" />
      <rect class="toggle" x="224" y="186" width="30" height="34" rx="4" />
    </g>
    <g class="brk b2">
      <rect class="switchbody" x="284" y="176" width="54" height="92" rx="6" />
      <rect class="toggle" x="296" y="186" width="30" height="34" rx="4" />
    </g>
    <!-- the tripped one -->
    <g class="brk b3 tripped">
      <rect class="switchbody" x="356" y="176" width="54" height="92" rx="6" />
      <rect class="toggle" x="368" y="186" width="30" height="34" rx="4" />
      <text class="tiny" x="383" y="288" text-anchor="middle">kitchen</text>
    </g>
    <g class="brk b4">
      <rect class="switchbody" x="428" y="176" width="54" height="92" rx="6" />
      <rect class="toggle" x="440" y="186" width="30" height="34" rx="4" />
    </g>
    <g class="brk b5">
      <rect class="switchbody" x="500" y="176" width="54" height="92" rx="6" />
      <rect class="toggle" x="512" y="186" width="30" height="34" rx="4" />
    </g>
    <g class="brk b6">
      <rect class="switchbody" x="572" y="176" width="54" height="92" rx="6" />
      <rect class="toggle" x="584" y="186" width="30" height="34" rx="4" />
    </g>
  </g>

  <!-- the "one is out of line" marker -->
  <g class="spot">
    <path class="dashline" d="M120 234 H660" />
    <circle class="ring" cx="383" cy="222" r="46" />
  </g>

  <!-- appliances on that circuit -->
  <g class="loads">
    <g class="load l1">
      <rect x="0" y="0" width="96" height="70" rx="8" />
      <text x="48" y="42" text-anchor="middle">kettle</text>
    </g>
    <g class="load l2">
      <rect x="0" y="0" width="96" height="70" rx="8" />
      <text x="48" y="42" text-anchor="middle">toaster</text>
    </g>
    <g class="load l3 culprit">
      <rect x="0" y="0" width="96" height="70" rx="8" />
      <text x="48" y="42" text-anchor="middle">heater</text>
    </g>
  </g>

  <!-- culprit flag -->
  <g class="flag">
    <circle class="flagbg" cx="562" cy="392" r="24" />
    <path class="flagmark" d="M562 380 V396 M562 404 v2" />
  </g>

  <g class="done">
    <circle class="tickbg" cx="700" cy="392" r="32" />
    <path class="tick" d="M685 392 l10 11 l20 -23" />
  </g>
</svg>

<style>
  .bk {
    --dur: 0.6s;
    --ease: cubic-bezier(0.65, 0, 0.35, 1);
  }

  .bk .box {
    fill: var(--surface);
    stroke: var(--ink);
    stroke-width: 5;
  }

  .bk .ln {
    fill: none;
    stroke: var(--ink);
    stroke-width: 5;
  }

  .bk .thin {
    stroke-width: 3;
  }

  .bk .label {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    fill: var(--ink-2);
  }

  .bk .tiny {
    font-family: var(--font-mono);
    font-size: 14px;
    fill: var(--ink-3);
  }

  .bk .bus {
    fill: var(--ink-3);
  }

  .bk .switchbody {
    fill: var(--paper-deep);
    stroke: var(--ink);
    stroke-width: 3.5;
  }

  .bk .toggle {
    fill: var(--ink);
    transition: transform var(--dur) var(--ease), fill var(--dur) var(--ease);
  }

  /* the tripped breaker starts in the down position */
  .bk .tripped .toggle {
    transform: translateY(48px);
    fill: var(--danger);
  }

  .bk .tripped .switchbody {
    stroke: var(--danger);
  }

  /* --- spotlight ---------------------------------------------------------- */
  .bk .spot {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .bk .dashline {
    fill: none;
    stroke: var(--brand);
    stroke-width: 3;
    stroke-dasharray: 10 9;
  }

  .bk .ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4;
    animation: bk-pulse 1.8s ease-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes bk-pulse {
    0%,
    100% {
      transform: scale(0.94);
      opacity: 0.55;
    }
    50% {
      transform: scale(1.06);
      opacity: 1;
    }
  }

  /* --- loads -------------------------------------------------------------- */
  .bk .load rect {
    fill: var(--surface);
    stroke: var(--ink);
    stroke-width: 3.5;
    transition: stroke var(--dur) var(--ease), fill var(--dur) var(--ease);
  }

  .bk .load text {
    font-family: var(--font-body);
    font-size: 17px;
    fill: var(--ink-2);
  }

  .bk .load {
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .bk .l1 {
    transform: translate(206px, 358px);
  }
  .bk .l2 {
    transform: translate(344px, 358px);
  }
  .bk .l3 {
    transform: translate(482px, 358px);
  }

  .bk .flag {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .bk .flagbg {
    fill: var(--danger);
  }

  .bk .flagmark {
    stroke: #fff;
    stroke-width: 5;
    stroke-linecap: round;
    fill: none;
  }

  .bk .done {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.6);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .bk .tickbg {
    fill: var(--brand);
  }

  .bk .tick {
    fill: none;
    stroke: #fff;
    stroke-width: 5.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ======================================================================
     Step states
     ====================================================================== */

  /* 0 — spot the switch that is out of line with the others */
  :global([data-step='0']) .bk .spot {
    opacity: 1;
  }

  /* 1 — unplug everything on that circuit first */
  :global([data-step='1']) .bk .load {
    opacity: 0.22;
    transform: translate(var(--x, 0), 400px);
  }

  :global([data-step='1']) .bk .l1 {
    transform: translate(206px, 410px);
  }
  :global([data-step='1']) .bk .l2 {
    transform: translate(344px, 410px);
  }
  :global([data-step='1']) .bk .l3 {
    transform: translate(482px, 410px);
  }

  /* 2 — push it fully OFF, then back ON */
  :global([data-step='2']) .bk .load {
    opacity: 0.22;
  }

  :global([data-step='2']) .bk .tripped .toggle {
    transform: translateY(0);
    fill: var(--brand);
  }

  :global([data-step='2']) .bk .tripped .switchbody {
    stroke: var(--brand);
  }

  /* 3 — plug things back one at a time */
  :global([data-step='3']) .bk .tripped .toggle {
    transform: translateY(0);
    fill: var(--brand);
  }

  :global([data-step='3']) .bk .tripped .switchbody {
    stroke: var(--brand);
  }

  :global([data-step='3']) .bk .l3 {
    opacity: 0.22;
    transform: translate(482px, 410px);
  }

  /* 4 — the one that trips it again is the faulty appliance */
  :global([data-step='4']) .bk .culprit rect {
    stroke: var(--danger);
    fill: var(--danger-tint);
  }

  :global([data-step='4']) .bk .flag {
    opacity: 1;
  }

  :global([data-step='4']) .bk .done {
    opacity: 1;
    transform: scale(1);
  }
</style>
