---
/*
 * Burnt-on carbon — high-fidelity vector.
 *
 * The whole guide turns on one idea: the black layer is not dirt. It is oil
 * that polymerised into varnish and then carbonised. So the animation zooms
 * into the base and names the layers, because once you can see them the choice
 * of method is obvious.
 */
---

<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="bp">
  <defs>
    <linearGradient id="bpSteel" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#79818a" />
      <stop offset="0.14" stop-color="#eaeef1" />
      <stop offset="0.38" stop-color="#c0c7ce" />
      <stop offset="0.62" stop-color="#949ca4" />
      <stop offset="0.86" stop-color="#dfe4e8" />
      <stop offset="1" stop-color="#6e767e" />
    </linearGradient>

    <linearGradient id="bpSteelV" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e9edf0" />
      <stop offset="0.4" stop-color="#b6bec5" />
      <stop offset="1" stop-color="#848c94" />
    </linearGradient>

    <linearGradient id="bpVarnish" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#a8763a" />
      <stop offset="0.5" stop-color="#7d5222" />
      <stop offset="1" stop-color="#553516" />
    </linearGradient>

    <linearGradient id="bpCarbon" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3a3632" />
      <stop offset="0.45" stop-color="#221f1c" />
      <stop offset="1" stop-color="#0e0d0c" />
    </linearGradient>

    <linearGradient id="bpWater" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9adcca" stop-opacity="0.7" />
      <stop offset="1" stop-color="#37a086" stop-opacity="0.45" />
    </linearGradient>

    <linearGradient id="bpPaste" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#dfe3e6" />
    </linearGradient>

    <filter id="bpShadow" x="-30%" y="-30%" width="160%" height="180%">
      <feDropShadow dx="0" dy="7" stdDeviation="8" flood-color="#14171c" flood-opacity="0.2" />
    </filter>
    <filter id="bpShadowSm" x="-40%" y="-40%" width="180%" height="200%">
      <feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="#14171c" flood-opacity="0.28" />
    </filter>
    <filter id="bpRough" x="-25%" y="-25%" width="150%" height="150%">
      <feTurbulence type="fractalNoise" baseFrequency="1.3" numOctaves="3" seed="5" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="7" xChannelSelector="R" yChannelSelector="G" />
    </filter>

    <clipPath id="bpLensClip">
      <rect x="300" y="110" width="472" height="292" rx="16" />
    </clipPath>
  </defs>

  <!-- ============ left: the pan ============ -->
  <g class="pan">
    <g filter="url(#bpShadow)">
      <path class="panbody" d="M52 236 L92 348 H226 L266 236 Z" />
      <rect class="panhandle" x="252" y="206" width="14" height="46" rx="6" transform="rotate(28 259 229)" />
    </g>
    <path class="panrim" d="M52 236 H266" />
    <path class="pancarbon" d="M92 348 H226 L232 366 H86 Z" />
    <circle class="marker" cx="158" cy="356" r="38" />
  </g>

  <!-- magnifier cone -->
  <path class="cone" d="M198 342 L300 114 L300 398 L198 372 Z" />

  <!-- ============ right: the base, magnified ============ -->
  <g filter="url(#bpShadow)">
    <rect class="lens" x="300" y="110" width="472" height="292" rx="16" />
  </g>
  <text class="lenstag" x="316" y="136">the base, magnified</text>

  <g clip-path="url(#bpLensClip)">
    <!-- the pan metal -->
    <rect class="metal" x="300" y="300" width="472" height="102" />
    <path class="metaltop" d="M300 300 H772" />

    <!-- polymerised oil -->
    <rect class="varnish" x="300" y="266" width="472" height="34" />

    <!-- carbonised crust -->
    <g class="carbon">
      <rect class="carbonband" x="300" y="222" width="472" height="46" />
      <path class="carbonlump" d="M340 224 q 30 -20 58 -2 q 34 -18 62 2 q 40 -22 76 0 q 36 -16 68 2 q 30 -14 62 0 v 12 H340 Z" />
    </g>

    <!-- soak water -->
    <g class="soak">
      <rect class="water" x="300" y="150" width="472" height="76" />
      <g class="bubbles">
        <circle cx="368" cy="206" r="8" /><circle cx="452" cy="196" r="6" />
        <circle cx="540" cy="208" r="9" /><circle cx="628" cy="192" r="6" />
        <circle cx="700" cy="204" r="7" />
      </g>
    </g>

    <!-- heat from below -->
    <g class="heat">
      <path class="heatarrow" d="M380 396 V352 M366 366 l14 -14 l14 14" />
      <path class="heatarrow" d="M536 396 V352 M522 366 l14 -14 l14 14" />
      <path class="heatarrow" d="M692 396 V352 M678 366 l14 -14 l14 14" />
    </g>

    <!-- paste + scrub -->
    <g class="paste">
      <rect class="pastelayer" x="300" y="188" width="472" height="38" rx="10" />
      <path class="scrub" d="M400 168 a 34 20 0 1 0 0.1 0" />
      <path class="scrub s2" d="M560 168 a 34 20 0 1 0 0.1 0" />
      <path class="scrub s3" d="M700 168 a 34 20 0 1 0 0.1 0" />
    </g>

    <!-- the thin protective film at the end -->
    <g class="film">
      <rect class="filmlayer" x="300" y="292" width="472" height="8" />
    </g>
  </g>

  <!-- layer labels -->
  <g class="labels">
    <g class="lab lab--carbon">
      <path class="lead" d="M470 244 L604 176" />
      <circle class="leaddot" cx="470" cy="244" r="4.5" />
      <g class="tagbox tagbox--bad">
        <rect x="586" y="150" width="176" height="32" rx="16" />
        <text x="674" y="171">carbonised</text>
      </g>
    </g>
    <g class="lab lab--varnish">
      <path class="lead" d="M400 282 L338 190" />
      <circle class="leaddot" cx="400" cy="282" r="4.5" />
      <g class="tagbox tagbox--warn">
        <rect x="316" y="164" width="228" height="32" rx="16" />
        <text x="430" y="185">polymerised oil</text>
      </g>
    </g>
    <g class="lab lab--metal">
      <path class="lead" d="M660 340 L716 340" />
      <circle class="leaddot" cx="660" cy="340" r="4.5" />
      <g class="tagbox">
        <rect x="620" y="356" width="140" height="32" rx="16" />
        <text x="690" y="377">the metal</text>
      </g>
    </g>
  </g>

  <!-- material chips -->
  <g class="materials">
    <g class="chip chip--steel">
      <rect x="0" y="0" width="150" height="36" rx="18" />
      <text x="75" y="24">stainless</text>
    </g>
    <g class="chip chip--nonstick">
      <rect x="0" y="0" width="150" height="36" rx="18" />
      <text x="75" y="24">non-stick</text>
    </g>
    <g class="chip chip--alu">
      <rect x="0" y="0" width="150" height="36" rx="18" />
      <text x="75" y="24">aluminium</text>
    </g>
  </g>

  <g class="notdirt">
    <g class="tagbox tagbox--bad">
      <rect x="24" y="60" width="248" height="32" rx="16" />
      <text x="148" y="81">not dirt — soap won't work</text>
    </g>
  </g>

  <g class="softentag">
    <g class="tagbox tagbox--ok">
      <rect x="24" y="60" width="256" height="32" rx="16" />
      <text x="152" y="81">simmer to soften first</text>
    </g>
  </g>

  <g class="protecttag">
    <g class="tagbox tagbox--ok">
      <rect x="24" y="60" width="270" height="32" rx="16" />
      <text x="159" y="81">dry, then a thin oil wipe</text>
    </g>
  </g>

  <g class="done">
    <circle class="tickbg" cx="148" cy="150" r="34" />
    <path class="tick" d="M132 150 l11 12 l21 -25" />
  </g>
</svg>

<style>
  .bp {
    --dur: 0.65s;
    --ease: cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* ---------- pan ---------- */
  .bp .panbody {
    fill: url(#bpSteelV);
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linejoin: round;
  }

  .bp .panrim {
    fill: none;
    stroke: var(--ink);
    stroke-width: 6;
    stroke-linecap: round;
  }

  .bp .panhandle {
    fill: #2c3238;
  }

  .bp .pancarbon {
    fill: url(#bpCarbon);
    filter: url(#bpRough);
    transition: opacity var(--dur) var(--ease);
  }

  .bp .marker {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4;
    stroke-dasharray: 10 9;
    animation: bp-spin 16s linear infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes bp-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .bp .cone {
    fill: color-mix(in srgb, var(--ink) 6%, transparent);
    stroke: color-mix(in srgb, var(--ink) 16%, transparent);
    stroke-width: 2;
  }

  /* ---------- lens ---------- */
  .bp .lens {
    fill: #f7f5f1;
    stroke: color-mix(in srgb, var(--ink) 22%, transparent);
    stroke-width: 3;
  }

  .bp .lenstag {
    font-family: var(--font-mono);
    font-size: 16px;
    fill: var(--ink-3);
  }

  .bp .metal {
    fill: url(#bpSteel);
  }

  .bp .metaltop {
    stroke: #ffffff;
    stroke-width: 3;
    opacity: 0.55;
    fill: none;
  }

  .bp .varnish {
    fill: url(#bpVarnish);
    transition: opacity var(--dur) var(--ease), height var(--dur) var(--ease),
      y var(--dur) var(--ease);
  }

  .bp .carbonband,
  .bp .carbonlump {
    fill: url(#bpCarbon);
    filter: url(#bpRough);
  }

  .bp .carbon {
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  /* ---------- soak / heat ---------- */
  .bp .soak,
  .bp .heat,
  .bp .paste,
  .bp .film {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .bp .water {
    fill: url(#bpWater);
  }

  .bp .bubbles circle {
    fill: none;
    stroke: #2f9c80;
    stroke-width: 3;
    animation: bp-rise 2.2s ease-in-out infinite;
  }

  .bp .bubbles circle:nth-child(2) {
    animation-delay: -0.45s;
  }
  .bp .bubbles circle:nth-child(3) {
    animation-delay: -0.9s;
  }
  .bp .bubbles circle:nth-child(4) {
    animation-delay: -1.35s;
  }
  .bp .bubbles circle:nth-child(5) {
    animation-delay: -1.8s;
  }

  @keyframes bp-rise {
    0% {
      transform: translateY(16px);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      transform: translateY(-58px);
      opacity: 0;
    }
  }

  .bp .heatarrow {
    fill: none;
    stroke: var(--accent);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: bp-pulse 1.6s ease-in-out infinite;
  }

  @keyframes bp-pulse {
    0%,
    100% {
      opacity: 0.45;
    }
    50% {
      opacity: 1;
    }
  }

  /* ---------- paste + scrub ---------- */
  .bp .pastelayer {
    fill: url(#bpPaste);
    stroke: #c7ccd1;
    stroke-width: 2;
  }

  .bp .scrub {
    fill: none;
    stroke: var(--brand);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 10 12;
    animation: bp-circle 1.4s linear infinite;
  }

  .bp .s2 {
    animation-delay: -0.45s;
  }
  .bp .s3 {
    animation-delay: -0.9s;
  }

  @keyframes bp-circle {
    to {
      stroke-dashoffset: -44;
    }
  }

  .bp .filmlayer {
    fill: #d8a253;
    opacity: 0.55;
  }

  /* ---------- material chips ---------- */
  .bp .materials {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .bp .chip rect {
    fill: #ffffff;
    stroke: var(--line);
    stroke-width: 3;
  }

  .bp .chip text {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    fill: var(--ink-2);
    text-anchor: middle;
  }

  .bp .chip--steel {
    transform: translate(24px, 178px);
  }
  .bp .chip--nonstick {
    transform: translate(24px, 226px);
  }
  .bp .chip--alu {
    transform: translate(24px, 274px);
  }

  /* ---------- callouts ---------- */
  .bp .tagbox rect {
    fill: var(--ink);
  }

  .bp .tagbox text {
    fill: #fff;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    text-anchor: middle;
  }

  .bp .tagbox--warn rect {
    fill: var(--accent-deep);
  }
  .bp .tagbox--bad rect {
    fill: var(--danger);
  }
  .bp .tagbox--ok rect {
    fill: var(--brand);
  }

  .bp .lead {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .bp .leaddot {
    fill: var(--ink);
  }

  .bp .labels,
  .bp .lab,
  .bp .notdirt,
  .bp .softentag,
  .bp .protecttag {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .bp .done {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.6);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .bp .tickbg {
    fill: var(--brand);
  }

  .bp .tick {
    fill: none;
    stroke: #fff;
    stroke-width: 5.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ======================================================================
     Step states
     ====================================================================== */

  /* 0 — name the layers: this is why detergent does nothing */
  :global([data-step='0']) .bp .labels,
  :global([data-step='0']) .bp .lab,
  :global([data-step='0']) .bp .notdirt {
    opacity: 1;
  }

  /* 1 — the material decides the method */
  :global([data-step='1']) .bp .materials {
    opacity: 1;
  }

  :global([data-step='1']) .bp .labels,
  :global([data-step='1']) .bp .lab--metal {
    opacity: 1;
  }

  /* 2 — simmer water and soap to soften it */
  :global([data-step='2']) .bp .soak,
  :global([data-step='2']) .bp .heat,
  :global([data-step='2']) .bp .softentag {
    opacity: 1;
  }

  :global([data-step='2']) .bp .carbon {
    transform: translateY(-4px);
  }

  /* 3 — paste and circular scrub: the crust comes off in layers */
  :global([data-step='3']) .bp .paste {
    opacity: 1;
  }

  :global([data-step='3']) .bp .carbon {
    opacity: 0;
  }

  :global([data-step='3']) .bp .varnish {
    opacity: 0.45;
  }

  :global([data-step='3']) .bp .pancarbon {
    opacity: 0.35;
  }

  /* 4 — bare metal, dried, thin oil film so it does not come back */
  :global([data-step='4']) .bp .carbon,
  :global([data-step='4']) .bp .varnish,
  :global([data-step='4']) .bp .pancarbon {
    opacity: 0;
  }

  :global([data-step='4']) .bp .film,
  :global([data-step='4']) .bp .protecttag {
    opacity: 1;
  }

  :global([data-step='4']) .bp .done {
    opacity: 1;
    transform: scale(1);
  }
</style>
