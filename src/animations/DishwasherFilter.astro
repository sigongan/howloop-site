---
/*
 * Dishwasher not cleaning — high-fidelity vector.
 *
 * Cutaway of the tub. The machine recirculates the same water, so a blocked
 * filter starves the spray arm and redeposits the food it just washed off.
 * The animation follows the water, because that is the whole explanation.
 */
---

<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="dw">
  <defs>
    <linearGradient id="dwTub" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#8d949b" />
      <stop offset="0.12" stop-color="#e3e8ec" />
      <stop offset="0.45" stop-color="#c4cbd1" />
      <stop offset="0.75" stop-color="#a2aab1" />
      <stop offset="1" stop-color="#7d848b" />
    </linearGradient>

    <linearGradient id="dwSteelV" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#eef1f4" />
      <stop offset="0.45" stop-color="#b8c0c7" />
      <stop offset="1" stop-color="#868e96" />
    </linearGradient>

    <linearGradient id="dwFilter" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#cfd6dc" />
      <stop offset="0.5" stop-color="#9aa3ab" />
      <stop offset="1" stop-color="#6d757d" />
    </linearGradient>

    <linearGradient id="dwGunk" x1="0" y1="0" x2="0.6" y2="1">
      <stop offset="0" stop-color="#8a7a52" />
      <stop offset="0.55" stop-color="#5f523a" />
      <stop offset="1" stop-color="#3a3226" />
    </linearGradient>

    <linearGradient id="dwPlate" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#dfe3e7" />
    </linearGradient>

    <filter id="dwShadow" x="-30%" y="-30%" width="160%" height="180%">
      <feDropShadow dx="0" dy="7" stdDeviation="8" flood-color="#14171c" flood-opacity="0.2" />
    </filter>
    <filter id="dwShadowSm" x="-40%" y="-40%" width="180%" height="200%">
      <feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="#14171c" flood-opacity="0.28" />
    </filter>
    <filter id="dwRough" x="-30%" y="-30%" width="160%" height="160%">
      <feTurbulence type="fractalNoise" baseFrequency="1" numOctaves="3" seed="9" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="6" xChannelSelector="R" yChannelSelector="G" />
    </filter>

    <clipPath id="dwTubClip">
      <rect x="96" y="76" width="608" height="348" rx="8" />
    </clipPath>
  </defs>

  <!-- tub -->
  <g filter="url(#dwShadow)">
    <rect class="tub" x="90" y="70" width="620" height="360" rx="10" />
  </g>
  <rect class="tubline" x="90" y="70" width="620" height="360" rx="10" />
  <text class="lenstag" x="106" y="60">dishwasher tub, cut through</text>

  <g clip-path="url(#dwTubClip)">
    <!-- plate on the rack -->
    <g class="plate">
      <ellipse class="platebody" cx="300" cy="176" rx="86" ry="18" />
      <g class="soil">
        <circle cx="272" cy="172" r="7" /><circle cx="306" cy="180" r="5" />
        <circle cx="334" cy="170" r="6" />
      </g>
    </g>

    <!-- rack tines -->
    <g class="rack">
      <path d="M180 196 V166" /><path d="M216 196 V166" /><path d="M252 196 V166" />
      <path d="M348 196 V166" /><path d="M384 196 V166" /><path d="M420 196 V166" />
      <path class="rackbar" d="M160 196 H560" />
    </g>

    <!-- spray arm -->
    <g class="arm">
      <rect class="armbody" x="200" y="316" width="360" height="22" rx="11" />
      <circle class="hub" cx="380" cy="327" r="18" />
      <g class="holes">
        <circle cx="248" cy="322" r="5" /><circle cx="296" cy="322" r="5" />
        <circle cx="344" cy="322" r="5" />
        <circle cx="416" cy="322" r="5" /><circle cx="464" cy="322" r="5" />
        <circle class="hole--blocked" cx="512" cy="322" r="5" />
      </g>
    </g>

    <!-- jets -->
    <g class="jets jets--weak">
      <path d="M248 314 V292" /><path d="M296 314 V286" /><path d="M344 314 V294" />
      <path d="M416 314 V288" /><path d="M464 314 V296" />
    </g>
    <g class="jets jets--strong">
      <path d="M248 314 V206" /><path d="M296 314 V196" /><path d="M344 314 V202" />
      <path d="M416 314 V194" /><path d="M464 314 V204" /><path d="M512 314 V200" />
    </g>

    <!-- sump and filter -->
    <path class="sump" d="M300 424 V392 H500 V424" />
    <g class="filter">
      <rect class="filterbody" x="330" y="352" width="140" height="44" rx="8" />
      <g class="mesh">
        <path d="M340 360 V388" /><path d="M356 360 V388" /><path d="M372 360 V388" />
        <path d="M388 360 V388" /><path d="M404 360 V388" /><path d="M420 360 V388" />
        <path d="M436 360 V388" /><path d="M452 360 V388" />
      </g>
      <g class="gunk">
        <path
          class="gunkmass"
          d="M334 356 q 28 -12 52 2 q 30 -14 58 0 q 22 -8 24 6 v 12 H334 Z"
        />
      </g>
    </g>

    <!-- water path arrows -->
    <g class="path">
      <path class="pathline" d="M400 392 V344" />
      <path class="patharrow" d="M388 356 l12 -14 l12 14" />
    </g>
  </g>

  <!-- filter removed, under the tap -->
  <g class="filterout">
    <g filter="url(#dwShadowSm)">
      <rect class="filterbody" x="0" y="0" width="140" height="44" rx="8" />
    </g>
    <g class="mesh">
      <path d="M10 8 V36" /><path d="M26 8 V36" /><path d="M42 8 V36" />
      <path d="M58 8 V36" /><path d="M74 8 V36" /><path d="M90 8 V36" />
      <path d="M106 8 V36" /><path d="M122 8 V36" />
    </g>
    <g class="rinse">
      <path class="rinseline" d="M70 -70 V-6" />
      <path class="rinseline r2" d="M44 -58 V-6" />
      <path class="rinseline r3" d="M96 -58 V-6" />
    </g>
  </g>

  <!-- callouts -->
  <g class="labels">
    <g class="lab lab--filter">
      <path class="lead" d="M400 358 L602 330" />
      <circle class="leaddot" cx="400" cy="358" r="4.5" />
      <g class="tagbox tagbox--bad">
        <rect x="586" y="304" width="196" height="32" rx="16" />
        <text x="684" y="325">blocked filter</text>
      </g>
      <circle class="marker marker--sm" cx="400" cy="372" r="66" />
    </g>
    <g class="lab lab--recirc">
      <path class="lead" d="M300 190 L128 148" />
      <circle class="leaddot" cx="300" cy="190" r="4.5" />
      <g class="tagbox tagbox--warn">
        <rect x="10" y="122" width="240" height="32" rx="16" />
        <text x="130" y="143">same water, recirculated</text>
      </g>
    </g>
    <g class="lab lab--hole">
      <path class="lead" d="M512 316 L620 252" />
      <circle class="leaddot" cx="512" cy="316" r="4.5" />
      <g class="tagbox tagbox--warn">
        <rect x="596" y="226" width="192" height="32" rx="16" />
        <text x="692" y="247">blocked jet hole</text>
      </g>
      <circle class="marker marker--sm marker--hole" cx="512" cy="322" r="30" />
    </g>
  </g>

  <g class="hottag">
    <g class="tagbox tagbox--ok">
      <rect x="10" y="122" width="266" height="32" rx="16" />
      <text x="143" y="143">run an empty hot cycle</text>
    </g>
  </g>

  <g class="done">
    <circle class="tickbg" cx="140" cy="250" r="34" />
    <path class="tick" d="M124 250 l11 12 l21 -25" />
  </g>
</svg>

<style>
  .dw {
    --dur: 0.65s;
    --ease: cubic-bezier(0.65, 0, 0.35, 1);
  }

  .dw .tub {
    fill: url(#dwTub);
  }

  .dw .tubline {
    fill: none;
    stroke: var(--ink);
    stroke-width: 5;
  }

  .dw .lenstag {
    font-family: var(--font-mono);
    font-size: 16px;
    fill: var(--ink-3);
  }

  /* ---------- plate + rack ---------- */
  .dw .platebody {
    fill: url(#dwPlate);
    stroke: var(--ink);
    stroke-width: 3;
  }

  .dw .soil circle {
    fill: url(#dwGunk);
    filter: url(#dwRough);
    transition: opacity var(--dur) var(--ease);
  }

  .dw .rack path {
    fill: none;
    stroke: #dfe4e8;
    stroke-width: 4;
    stroke-linecap: round;
  }

  .dw .rackbar {
    stroke-width: 5;
  }

  /* ---------- spray arm ---------- */
  .dw .armbody {
    fill: url(#dwSteelV);
    stroke: #7d848b;
    stroke-width: 2;
  }

  .dw .hub {
    fill: #6d757d;
  }

  .dw .holes circle {
    fill: #2c3238;
  }

  .dw .hole--blocked {
    fill: url(#dwGunk);
    transition: fill var(--dur) var(--ease);
  }

  /* ---------- jets ---------- */
  .dw .jets path {
    fill: none;
    stroke: #2f9c80;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 12 12;
    animation: dw-jet 0.7s linear infinite;
  }

  @keyframes dw-jet {
    to {
      stroke-dashoffset: -24;
    }
  }

  .dw .jets {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  /* ---------- sump + filter ---------- */
  .dw .sump {
    fill: none;
    stroke: #7d848b;
    stroke-width: 5;
    stroke-linejoin: round;
  }

  .dw .filterbody {
    fill: url(#dwFilter);
    stroke: #5f666e;
    stroke-width: 2.5;
  }

  .dw .mesh path {
    fill: none;
    stroke: #4e565e;
    stroke-width: 2.5;
  }

  .dw .gunkmass {
    fill: url(#dwGunk);
    filter: url(#dwRough);
  }

  .dw .gunk {
    transition: opacity var(--dur) var(--ease);
  }

  .dw .filter {
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .dw .filterout {
    transform: translate(560px, 150px);
    opacity: 0;
    transition: opacity var(--dur) var(--ease), transform 0.8s var(--ease);
  }

  .dw .rinse {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .dw .rinseline {
    fill: none;
    stroke: #2f9c80;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 12 11;
    animation: dw-jet 0.8s linear infinite;
  }

  .dw .r2 {
    animation-delay: -0.3s;
    opacity: 0.6;
  }
  .dw .r3 {
    animation-delay: -0.6s;
    opacity: 0.6;
  }

  /* ---------- water path ---------- */
  .dw .path {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .dw .pathline {
    fill: none;
    stroke: #2f9c80;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 12 12;
    animation: dw-jet 0.8s linear infinite;
  }

  .dw .patharrow {
    fill: none;
    stroke: #2f9c80;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- callouts ---------- */
  .dw .marker {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4;
    stroke-dasharray: 10 9;
    animation: dw-spin 16s linear infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .dw .marker--sm {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  @keyframes dw-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .dw .tagbox rect {
    fill: var(--ink);
  }

  .dw .tagbox text {
    fill: #fff;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    text-anchor: middle;
  }

  .dw .tagbox--warn rect {
    fill: var(--accent-deep);
  }
  .dw .tagbox--bad rect {
    fill: var(--danger);
  }
  .dw .tagbox--ok rect {
    fill: var(--brand);
  }

  .dw .lead {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .dw .leaddot {
    fill: var(--ink);
  }

  .dw .labels,
  .dw .lab,
  .dw .hottag {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .dw .done {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.6);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .dw .tickbg {
    fill: var(--brand);
  }

  .dw .tick {
    fill: none;
    stroke: #fff;
    stroke-width: 5.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ======================================================================
     Step states
     ====================================================================== */

  /* 0 — weak jets and food back on the plate */
  :global([data-step='0']) .dw .jets--weak,
  :global([data-step='0']) .dw .path {
    opacity: 1;
  }

  :global([data-step='0']) .dw .labels,
  :global([data-step='0']) .dw .lab--filter,
  :global([data-step='0']) .dw .lab--recirc {
    opacity: 1;
  }

  :global([data-step='0']) .dw .marker--sm {
    opacity: 1;
  }

  :global([data-step='0']) .dw .lab--hole,
  :global([data-step='0']) .dw .marker--hole {
    opacity: 0;
  }

  /* 1 — twist the filter out */
  :global([data-step='1']) .dw .filter {
    opacity: 0;
  }

  :global([data-step='1']) .dw .filterout,
  :global([data-step='2']) .dw .filterout {
    opacity: 1;
    transform: translate(520px, 120px);
  }

  :global([data-step='1']) .dw .labels,
  :global([data-step='1']) .dw .lab--filter {
    opacity: 1;
  }

  /* 2 — rinse and brush it */
  :global([data-step='2']) .dw .filter {
    opacity: 0;
  }

  :global([data-step='2']) .dw .filterout .gunk {
    opacity: 0;
  }

  :global([data-step='2']) .dw .rinse {
    opacity: 1;
  }

  /* 3 — clear the spray arm holes */
  :global([data-step='3']) .dw .filter {
    opacity: 1;
  }

  :global([data-step='3']) .dw .gunk {
    opacity: 0;
  }

  :global([data-step='3']) .dw .labels,
  :global([data-step='3']) .dw .lab--hole {
    opacity: 1;
  }

  :global([data-step='3']) .dw .marker--hole {
    opacity: 1;
  }

  /* 4 — full-pressure jets, clean plate */
  :global([data-step='4']) .dw .gunk {
    opacity: 0;
  }

  :global([data-step='4']) .dw .hole--blocked {
    fill: #2c3238;
  }

  :global([data-step='4']) .dw .jets--strong,
  :global([data-step='4']) .dw .path,
  :global([data-step='4']) .dw .hottag {
    opacity: 1;
  }

  :global([data-step='4']) .dw .soil circle {
    opacity: 0;
  }

  :global([data-step='4']) .dw .done {
    opacity: 1;
    transform: scale(1);
  }
</style>
