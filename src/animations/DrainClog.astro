---
/* Unclog a bathroom sink — cross-section of basin, tailpiece and clog. */
---

<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="dc">
  <!-- counter surface -->
  <path class="ln surface" d="M120 150 H680" />
  <path class="fill-soft" d="M120 150 H210 V132 H120 Z" />
  <path class="fill-soft" d="M590 132 H680 V150 H590 Z" />

  <!-- basin walls -->
  <path class="ln" d="M210 132 C 216 224, 302 252, 368 254" />
  <path class="ln" d="M590 132 C 584 224, 498 252, 432 254" />

  <!-- standing water in the basin (steps 0 & 3) -->
  <path
    class="water"
    d="M232 196 C 246 236, 312 252, 368 254 L432 254 C 488 252, 554 236, 568 196 Z"
  />

  <!-- tailpiece + trap -->
  <path class="ln" d="M368 254 V392 C 368 452, 470 452, 470 392 V300" />
  <path class="ln" d="M432 254 V392 C 432 410, 508 410, 508 392 V300" />
  <path class="ln thin" d="M470 300 H508" />

  <!-- the clog, wedged in the tailpiece -->
  <g class="clog clog--stuck">
    <path
      class="clogmass"
      d="M378 320 C 392 300, 424 306, 422 326 C 440 330, 436 356, 416 356 C 408 372, 380 368, 380 350 C 366 344, 366 326, 378 320 Z"
    />
    <path class="hair" d="M382 318 C 400 330, 396 350, 412 358" />
    <path class="hair" d="M416 314 C 400 332, 410 348, 388 352" />
  </g>

  <!-- stopper -->
  <g class="stopper">
    <ellipse class="fill-ink" cx="400" cy="252" rx="34" ry="9" />
    <path class="ln thin" d="M400 252 V214" />
    <circle class="fill-ink" cx="400" cy="208" r="9" />
  </g>

  <!-- the zip tool -->
  <g class="tool">
    <path class="toolshaft" d="M400 40 V352" />
    <g class="barbs">
      <path d="M400 300 l-13 -11" /><path d="M400 300 l13 -11" />
      <path d="M400 276 l-13 -11" /><path d="M400 276 l13 -11" />
      <path d="M400 252 l-13 -11" /><path d="M400 252 l13 -11" />
      <path d="M400 228 l-13 -11" /><path d="M400 228 l13 -11" />
      <path d="M400 204 l-13 -11" /><path d="M400 204 l13 -11" />
    </g>
    <rect class="toolgrip" x="378" y="14" width="44" height="34" rx="10" />
    <!-- clog riding up on the barbs -->
    <g class="clog clog--onTool">
      <path
        class="clogmass"
        d="M378 320 C 392 300, 424 306, 422 326 C 440 330, 436 356, 416 356 C 408 372, 380 368, 380 350 C 366 344, 366 326, 378 320 Z"
      />
      <path class="hair" d="M382 318 C 400 330, 396 350, 412 358" />
    </g>
  </g>

  <!-- hot-water flush -->
  <g class="flush">
    <path class="flowline" d="M400 268 V332" />
    <path class="flowline f2" d="M382 274 V330" />
    <path class="flowline f3" d="M418 274 V330" />
    <path class="arrow" d="M392 336 l8 12 l8 -12" />
  </g>

  <!-- success tick -->
  <g class="done">
    <circle class="tickbg" cx="640" cy="392" r="34" />
    <path class="tick" d="M624 392 l11 12 l21 -25" />
  </g>
</svg>

<style>
  .dc {
    --dur: 0.65s;
    --ease: cubic-bezier(0.65, 0, 0.35, 1);
  }

  .dc .ln {
    fill: none;
    stroke: var(--ink);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .dc .thin {
    stroke-width: 3.5;
  }

  .dc .surface {
    stroke-width: 6;
  }

  .dc .fill-soft {
    fill: var(--paper-deep);
    stroke: var(--ink);
    stroke-width: 3;
  }

  .dc .fill-ink {
    fill: var(--ink);
  }

  /* --- water ------------------------------------------------------------- */
  .dc .water {
    fill: color-mix(in srgb, var(--brand) 22%, transparent);
    opacity: 1;
    transition: opacity var(--dur) var(--ease);
  }

  /* --- clog -------------------------------------------------------------- */
  .dc .clogmass {
    fill: color-mix(in srgb, var(--ink) 72%, var(--accent));
  }

  .dc .hair {
    fill: none;
    stroke: var(--paper);
    stroke-width: 2.5;
    stroke-linecap: round;
    opacity: 0.6;
  }

  .dc .clog--onTool {
    opacity: 0;
  }

  .dc .clog {
    transition: opacity var(--dur) var(--ease);
  }

  /* --- stopper ----------------------------------------------------------- */
  .dc .stopper {
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }

  /* --- tool -------------------------------------------------------------- */
  .dc .tool {
    transform: translateY(-330px);
    transition: transform 0.85s var(--ease);
  }

  .dc .toolshaft {
    fill: none;
    stroke: var(--accent);
    stroke-width: 7;
    stroke-linecap: round;
  }

  .dc .barbs path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4.5;
    stroke-linecap: round;
  }

  .dc .toolgrip {
    fill: var(--accent);
  }

  /* --- flush ------------------------------------------------------------- */
  .dc .flush {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .dc .flowline {
    fill: none;
    stroke: var(--brand);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 16 14;
    animation: dc-flow 0.9s linear infinite;
  }

  .dc .f2 {
    animation-delay: -0.3s;
    opacity: 0.65;
  }

  .dc .f3 {
    animation-delay: -0.6s;
    opacity: 0.65;
  }

  @keyframes dc-flow {
    to {
      stroke-dashoffset: -30;
    }
  }

  .dc .arrow {
    fill: none;
    stroke: var(--brand);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* --- done -------------------------------------------------------------- */
  .dc .done {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
    transform: scale(0.6);
  }

  .dc .tickbg {
    fill: var(--brand);
  }

  .dc .tick {
    fill: none;
    stroke: #fff;
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ======================================================================
     Step states
     ====================================================================== */

  /* 0 — the problem: water standing, stopper in place */

  /* 1 — pop the stopper out */
  :global([data-step='1']) .dc .stopper,
  :global([data-step='2']) .dc .stopper,
  :global([data-step='3']) .dc .stopper {
    transform: translateY(-150px) rotate(-14deg);
  }

  /* 2 — feed the tool down past the clog */
  :global([data-step='2']) .dc .tool {
    transform: translateY(0);
  }

  /* 3 — pull it out; the clog comes with it */
  :global([data-step='3']) .dc .tool {
    transform: translateY(-300px);
    transition-delay: 0.15s;
  }

  :global([data-step='3']) .dc .clog--stuck {
    opacity: 0;
  }

  :global([data-step='3']) .dc .clog--onTool {
    opacity: 1;
  }

  :global([data-step='3']) .dc .water {
    opacity: 0.25;
  }

  /* 4 — flush, refit, done */
  :global([data-step='4']) .dc .clog--stuck,
  :global([data-step='4']) .dc .clog--onTool {
    opacity: 0;
  }

  :global([data-step='4']) .dc .tool {
    transform: translateY(-430px);
  }

  :global([data-step='4']) .dc .water {
    opacity: 0;
  }

  :global([data-step='4']) .dc .flush {
    opacity: 1;
  }

  :global([data-step='4']) .dc .done {
    opacity: 1;
    transform: scale(1);
  }
</style>
