---
/*
 * Descaling a kettle — high-fidelity vector.
 *
 * Brushed stainless in section. The crust on the element gets a rough edge
 * because limescale is rock, not dirt — that distinction is the whole guide.
 */
---

<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="kt">
  <defs>
    <linearGradient id="ktSteel" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7f878f" />
      <stop offset="0.12" stop-color="#e9edf0" />
      <stop offset="0.34" stop-color="#c3cad0" />
      <stop offset="0.58" stop-color="#9aa2aa" />
      <stop offset="0.82" stop-color="#dfe4e8" />
      <stop offset="1" stop-color="#727a82" />
    </linearGradient>

    <linearGradient id="ktSteelDark" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#3f464d" />
      <stop offset="0.3" stop-color="#6b737b" />
      <stop offset="0.7" stop-color="#4a525a" />
      <stop offset="1" stop-color="#2c3238" />
    </linearGradient>

    <linearGradient id="ktScale" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f3e7cf" />
      <stop offset="0.5" stop-color="#dcc9a3" />
      <stop offset="1" stop-color="#b99f74" />
    </linearGradient>

    <linearGradient id="ktWater" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9adcca" stop-opacity="0.7" />
      <stop offset="1" stop-color="#37a086" stop-opacity="0.45" />
    </linearGradient>

    <linearGradient id="ktVinegar" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffd79a" stop-opacity="0.7" />
      <stop offset="1" stop-color="#e0a24a" stop-opacity="0.5" />
    </linearGradient>

    <filter id="ktShadow" x="-30%" y="-30%" width="160%" height="180%">
      <feDropShadow dx="0" dy="7" stdDeviation="8" flood-color="#14171c" flood-opacity="0.2" />
    </filter>
    <filter id="ktShadowSm" x="-40%" y="-40%" width="180%" height="200%">
      <feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="#14171c" flood-opacity="0.28" />
    </filter>
    <filter id="ktRough" x="-25%" y="-25%" width="150%" height="150%">
      <feTurbulence type="fractalNoise" baseFrequency="1.1" numOctaves="3" seed="11" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="6" xChannelSelector="R" yChannelSelector="G" />
    </filter>

    <clipPath id="ktBodyClip">
      <path d="M252 132 C 246 202, 242 322, 254 400 C 258 424, 274 436, 302 436 H478 C 506 436, 522 424, 526 400 C 538 322, 534 202, 528 132 Z" />
    </clipPath>
  </defs>

  <!-- kettle body -->
  <g filter="url(#ktShadow)">
    <path
      class="body"
      d="M252 132 C 246 202, 242 322, 254 400 C 258 424, 274 436, 302 436 H478 C 506 436, 522 424, 526 400 C 538 322, 534 202, 528 132 Z"
    />
  </g>

  <!-- spout and handle -->
  <path class="spout" d="M252 168 L188 128 L182 176 L248 216" />
  <path class="handle" d="M534 168 C 610 178, 616 340, 536 372" />

  <!-- contents -->
  <g clip-path="url(#ktBodyClip)">
    <g class="liquidwrap">
      <rect class="liquid liquid--water" x="240" y="200" width="300" height="240" />
      <rect class="liquid liquid--vinegar" x="240" y="200" width="300" height="240" />
      <path class="liquidline" d="M240 200 H540" />
    </g>

    <!-- limescale on the element and lower walls -->
    <g class="scale">
      <path
        class="crust"
        d="M256 398 q 20 -22 40 0 q 18 -20 38 0 q 22 -24 44 0 q 20 -18 40 0 q 22 -22 44 0 q 18 -16 34 0 v 16 H256 Z"
      />
      <path class="fleck f1" d="M296 344 q 12 -14 24 0 q -12 12 -24 0 Z" />
      <path class="fleck f2" d="M442 314 q 14 -16 28 0 q -14 14 -28 0 Z" />
      <path class="fleck f3" d="M358 272 q 10 -12 20 0 q -10 10 -20 0 Z" />
      <path class="fleck f4" d="M488 358 q 11 -13 22 0 q -11 11 -22 0 Z" />
    </g>

    <!-- bubbles while the acid works -->
    <g class="bubbles">
      <circle cx="306" cy="360" r="9" /><circle cx="378" cy="330" r="7" />
      <circle cx="450" cy="352" r="10" /><circle cx="496" cy="316" r="6" />
      <circle cx="338" cy="300" r="6" />
    </g>
  </g>

  <!-- lid -->
  <path class="lid" d="M240 132 H540" />
  <g filter="url(#ktShadowSm)">
    <rect class="lidknob" x="366" y="98" width="48" height="34" rx="11" />
  </g>

  <!-- base -->
  <g filter="url(#ktShadowSm)">
    <rect class="base" x="262" y="436" width="256" height="26" rx="9" />
  </g>

  <!-- 1:1 mix card -->
  <g class="mix">
    <g filter="url(#ktShadowSm)">
      <rect class="mixcard" x="586" y="140" width="188" height="104" rx="16" />
    </g>
    <text class="mixtitle" x="608" y="180">1 : 1</text>
    <text class="mixsub" x="608" y="208">white vinegar</text>
    <text class="mixsub" x="608" y="230">+ water</text>
  </g>

  <!-- timer -->
  <g class="timer">
    <g filter="url(#ktShadowSm)">
      <circle class="timerbg" cx="680" cy="330" r="46" />
    </g>
    <path class="timerarc" d="M680 290 A 40 40 0 1 1 679 290" />
    <path class="hands" d="M680 330 V300 M680 330 h24" />
    <text class="tag mid" x="680" y="400">30 min</text>
  </g>

  <!-- rinse -->
  <g class="rinse">
    <path class="rinseline" d="M390 56 V126" />
    <path class="rinseline r2" d="M356 70 V126" />
    <path class="rinseline r3" d="M424 70 V126" />
  </g>

  <!-- callouts -->
  <g class="labels">
    <g class="lab lab--crust">
      <path class="lead" d="M390 396 L200 340" />
      <circle class="leaddot" cx="390" cy="396" r="4.5" />
      <g class="tagbox tagbox--warn">
        <rect x="24" y="314" width="180" height="32" rx="16" />
        <text x="114" y="335">limescale, not dirt</text>
      </g>
      <circle class="marker marker--sm" cx="390" cy="398" r="60" />
    </g>
  </g>

  <g class="scrubtag">
    <g class="tagbox tagbox--bad">
      <rect x="24" y="314" width="246" height="32" rx="16" />
      <text x="147" y="335">never scrape or scour</text>
    </g>
  </g>

  <g class="rinsetag">
    <g class="tagbox tagbox--ok">
      <rect x="24" y="314" width="256" height="32" rx="16" />
      <text x="152" y="335">boil clean water twice</text>
    </g>
  </g>

  <g class="done">
    <circle class="tickbg" cx="114" cy="420" r="34" />
    <path class="tick" d="M98 420 l11 12 l21 -25" />
  </g>
</svg>

<style>
  .kt {
    --dur: 0.65s;
    --ease: cubic-bezier(0.65, 0, 0.35, 1);
  }

  .kt .body {
    fill: url(#ktSteel);
    stroke: var(--ink);
    stroke-width: 5;
    stroke-linejoin: round;
  }

  .kt .spout {
    fill: url(#ktSteel);
    stroke: var(--ink);
    stroke-width: 5;
    stroke-linejoin: round;
  }

  .kt .handle {
    fill: none;
    stroke: url(#ktSteelDark);
    stroke-width: 16;
    stroke-linecap: round;
  }

  .kt .lid {
    fill: none;
    stroke: var(--ink);
    stroke-width: 6;
    stroke-linecap: round;
  }

  .kt .lidknob {
    fill: url(#ktSteelDark);
  }

  .kt .base {
    fill: url(#ktSteelDark);
  }

  .kt .tag {
    font-family: var(--font-mono);
    font-size: 17px;
    fill: var(--ink-3);
  }

  .kt .mid {
    text-anchor: middle;
  }

  /* ---------- liquid ---------- */
  .kt .liquidwrap {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .kt .liquid--water {
    fill: url(#ktWater);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .kt .liquid--vinegar {
    fill: url(#ktVinegar);
    transition: opacity var(--dur) var(--ease);
  }

  .kt .liquidline {
    fill: none;
    stroke: #c98f34;
    stroke-width: 3;
    opacity: 0.7;
  }

  /* ---------- scale ---------- */
  .kt .crust {
    fill: url(#ktScale);
    filter: url(#ktRough);
  }

  .kt .fleck {
    fill: url(#ktScale);
    filter: url(#ktRough);
  }

  .kt .scale,
  .kt .fleck,
  .kt .crust {
    transition: opacity var(--dur) var(--ease);
  }

  /* ---------- mix card ---------- */
  .kt .mix {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .kt .mixcard {
    fill: #ffffff;
    stroke: var(--brand);
    stroke-width: 3;
  }

  .kt .mixtitle {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    fill: var(--brand-deep);
  }

  .kt .mixsub {
    font-family: var(--font-body);
    font-size: 17px;
    fill: var(--ink-2);
  }

  /* ---------- bubbles ---------- */
  .kt .bubbles {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .kt .bubbles circle {
    fill: none;
    stroke: #2f9c80;
    stroke-width: 3;
    animation: kt-rise 2.4s ease-in-out infinite;
  }

  .kt .bubbles circle:nth-child(2) {
    animation-delay: -0.5s;
  }
  .kt .bubbles circle:nth-child(3) {
    animation-delay: -1s;
  }
  .kt .bubbles circle:nth-child(4) {
    animation-delay: -1.5s;
  }
  .kt .bubbles circle:nth-child(5) {
    animation-delay: -2s;
  }

  @keyframes kt-rise {
    0% {
      transform: translateY(20px);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      transform: translateY(-130px);
      opacity: 0;
    }
  }

  /* ---------- timer ---------- */
  .kt .timer {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .kt .timerbg {
    fill: #ffffff;
    stroke: var(--ink);
    stroke-width: 3;
  }

  .kt .timerarc {
    fill: none;
    stroke: #dfe3e7;
    stroke-width: 7;
  }

  .kt .hands {
    fill: none;
    stroke: var(--ink);
    stroke-width: 4.5;
    stroke-linecap: round;
  }

  /* ---------- rinse ---------- */
  .kt .rinse {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .kt .rinseline {
    fill: none;
    stroke: #2f9c80;
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 14 12;
    animation: kt-flow 0.9s linear infinite;
  }

  .kt .r2 {
    animation-delay: -0.3s;
    opacity: 0.6;
  }
  .kt .r3 {
    animation-delay: -0.6s;
    opacity: 0.6;
  }

  @keyframes kt-flow {
    to {
      stroke-dashoffset: -26;
    }
  }

  /* ---------- callouts ---------- */
  .kt .marker {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4;
    stroke-dasharray: 10 9;
    animation: kt-spin 16s linear infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .kt .marker--sm {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  @keyframes kt-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .kt .tagbox rect {
    fill: var(--ink);
  }

  .kt .tagbox text {
    fill: #fff;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    text-anchor: middle;
  }

  .kt .tagbox--warn rect {
    fill: var(--accent-deep);
  }
  .kt .tagbox--bad rect {
    fill: var(--danger);
  }
  .kt .tagbox--ok rect {
    fill: var(--brand);
  }

  .kt .lead {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .kt .leaddot {
    fill: var(--ink);
  }

  .kt .labels,
  .kt .lab,
  .kt .scrubtag,
  .kt .rinsetag {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .kt .done {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.6);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .kt .tickbg {
    fill: var(--brand);
  }

  .kt .tick {
    fill: none;
    stroke: #fff;
    stroke-width: 5.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ======================================================================
     Step states
     ====================================================================== */

  /* 0 — the crust on the element is what slows the boil */
  :global([data-step='0']) .kt .labels,
  :global([data-step='0']) .kt .lab {
    opacity: 1;
  }

  :global([data-step='0']) .kt .marker--sm {
    opacity: 1;
  }

  /* 1 — half vinegar, half water */
  :global([data-step='1']) .kt .liquidwrap,
  :global([data-step='2']) .kt .liquidwrap,
  :global([data-step='3']) .kt .liquidwrap {
    opacity: 1;
  }

  :global([data-step='1']) .kt .mix,
  :global([data-step='2']) .kt .mix {
    opacity: 1;
  }

  /* 2 — boil once, then leave it */
  :global([data-step='2']) .kt .bubbles,
  :global([data-step='2']) .kt .timer,
  :global([data-step='3']) .kt .timer {
    opacity: 1;
  }

  :global([data-step='2']) .kt .fleck {
    opacity: 0.3;
  }

  /* 3 — pour out and wipe; never scrape */
  :global([data-step='3']) .kt .fleck {
    opacity: 0;
  }

  :global([data-step='3']) .kt .crust {
    opacity: 0.22;
  }

  :global([data-step='3']) .kt .scrubtag {
    opacity: 1;
  }

  /* 4 — two clean boils before you drink from it */
  :global([data-step='4']) .kt .scale {
    opacity: 0;
  }

  :global([data-step='4']) .kt .liquidwrap {
    opacity: 1;
  }

  :global([data-step='4']) .kt .liquid--vinegar {
    opacity: 0;
  }

  :global([data-step='4']) .kt .liquid--water {
    opacity: 1;
  }

  :global([data-step='4']) .kt .rinse,
  :global([data-step='4']) .kt .rinsetag {
    opacity: 1;
  }

  :global([data-step='4']) .kt .done {
    opacity: 1;
    transform: scale(1);
  }
</style>
