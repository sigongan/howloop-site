---
/* A phone storage bar that empties one category at a time. */
---

<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="ps">
  <!-- phone -->
  <rect class="body" x="250" y="30" width="300" height="440" rx="34" />
  <rect class="screen" x="266" y="60" width="268" height="380" rx="20" />
  <rect class="notch" x="366" y="42" width="68" height="9" rx="5" />

  <text class="title" x="290" y="112">Storage</text>
  <text class="used used--before" x="290" y="150"
    ><tspan class="usednum">126</tspan> GB of 128 GB used</text
  >
  <text class="used used--after" x="290" y="150"
    ><tspan class="usednum">61</tspan> GB of 128 GB used</text
  >

  <!-- the bar -->
  <g class="bar">
    <rect class="track" x="290" y="176" width="220" height="26" rx="13" />
    <g class="segs">
      <rect class="seg seg--photos" x="290" y="176" height="26" />
      <rect class="seg seg--bin" y="176" height="26" />
      <rect class="seg seg--apps" y="176" height="26" />
      <rect class="seg seg--media" y="176" height="26" />
      <rect class="seg seg--sys" y="176" height="26" />
    </g>
  </g>

  <!-- legend rows -->
  <g class="legend">
    <g class="row row--photos">
      <circle cx="298" cy="248" r="8" />
      <text x="316" y="255">Photos &amp; video</text>
      <text class="amt" x="500" y="255" text-anchor="end">54 GB</text>
    </g>
    <g class="row row--bin">
      <circle cx="298" cy="292" r="8" />
      <text x="316" y="299">Recently deleted</text>
      <text class="amt" x="500" y="299" text-anchor="end">18 GB</text>
    </g>
    <g class="row row--apps">
      <circle cx="298" cy="336" r="8" />
      <text x="316" y="343">Unused apps</text>
      <text class="amt" x="500" y="343" text-anchor="end">26 GB</text>
    </g>
    <g class="row row--media">
      <circle cx="298" cy="380" r="8" />
      <text x="316" y="387">Offline downloads</text>
      <text class="amt" x="500" y="387" text-anchor="end">21 GB</text>
    </g>
    <g class="row row--sys">
      <circle cx="298" cy="424" r="8" />
      <text x="316" y="431">System</text>
      <text class="amt" x="500" y="431" text-anchor="end">7 GB</text>
    </g>
  </g>

  <!-- floating "freed" chips -->
  <g class="freed">
    <g class="chip chip--1">
      <rect x="0" y="0" width="110" height="42" rx="21" />
      <text x="22" y="28">+18 GB</text>
    </g>
    <g class="chip chip--2">
      <rect x="0" y="0" width="110" height="42" rx="21" />
      <text x="22" y="28">+26 GB</text>
    </g>
    <g class="chip chip--3">
      <rect x="0" y="0" width="110" height="42" rx="21" />
      <text x="22" y="28">+21 GB</text>
    </g>
  </g>

  <g class="done">
    <circle class="tickbg" cx="660" cy="120" r="34" />
    <path class="tick" d="M644 120 l11 12 l21 -25" />
  </g>
</svg>

<style>
  .ps {
    --dur: 0.75s;
    --ease: cubic-bezier(0.65, 0, 0.35, 1);
  }

  .ps .body {
    fill: var(--ink);
  }

  .ps .screen {
    fill: var(--surface);
  }

  .ps .notch {
    fill: color-mix(in srgb, var(--paper) 35%, var(--ink));
  }

  .ps .title {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    fill: var(--ink);
  }

  .ps .used {
    font-family: var(--font-body);
    font-size: 17px;
    fill: var(--ink-3);
  }

  .ps .usednum {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    fill: var(--danger);
  }

  .ps .used--after {
    opacity: 0;
  }

  .ps .used--after .usednum {
    fill: var(--brand);
  }

  .ps .used {
    transition: opacity var(--dur) var(--ease);
  }

  .ps .track {
    fill: var(--line-soft);
  }

  .ps .seg {
    transition: width var(--dur) var(--ease), x var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
  }

  /* widths are proportional to GB across a 220px track (126 GB total) */
  .ps .seg--photos {
    fill: color-mix(in srgb, var(--brand) 85%, #000);
    width: 94px;
    x: 290px;
  }

  .ps .seg--bin {
    fill: var(--danger);
    width: 31px;
    x: 384px;
  }

  .ps .seg--apps {
    fill: var(--accent);
    width: 46px;
    x: 415px;
  }

  .ps .seg--media {
    fill: color-mix(in srgb, var(--accent) 45%, var(--brand));
    width: 37px;
    x: 461px;
  }

  .ps .seg--sys {
    fill: var(--ink-3);
    width: 12px;
    x: 498px;
  }

  /* --- legend ------------------------------------------------------------ */
  .ps .row text {
    font-family: var(--font-body);
    font-size: 18px;
    fill: var(--ink-2);
  }

  .ps .row .amt {
    font-family: var(--font-mono);
    fill: var(--ink);
  }

  .ps .row {
    transition: opacity var(--dur) var(--ease);
  }

  .ps .row--photos circle {
    fill: color-mix(in srgb, var(--brand) 85%, #000);
  }
  .ps .row--bin circle {
    fill: var(--danger);
  }
  .ps .row--apps circle {
    fill: var(--accent);
  }
  .ps .row--media circle {
    fill: color-mix(in srgb, var(--accent) 45%, var(--brand));
  }
  .ps .row--sys circle {
    fill: var(--ink-3);
  }

  .ps .legend .row {
    opacity: 0.32;
  }

  /* --- freed chips ------------------------------------------------------- */
  .ps .chip rect {
    fill: var(--brand);
  }

  .ps .chip text {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    fill: #fff;
  }

  .ps .chip {
    opacity: 0;
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .ps .chip--1 {
    transform: translate(590px, 280px) scale(0.7);
  }
  .ps .chip--2 {
    transform: translate(590px, 324px) scale(0.7);
  }
  .ps .chip--3 {
    transform: translate(590px, 368px) scale(0.7);
  }

  .ps .done {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.6);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .ps .tickbg {
    fill: var(--brand);
  }

  .ps .tick {
    fill: none;
    stroke: #fff;
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ======================================================================
     Step states
     ====================================================================== */

  /* 0 — see what is actually eating the space */
  :global([data-step='0']) .ps .legend .row {
    opacity: 1;
  }

  /* 1 — empty Recently Deleted */
  :global([data-step='1']) .ps .row--bin {
    opacity: 1;
  }

  :global([data-step='1']) .ps .seg--bin,
  :global([data-step='2']) .ps .seg--bin,
  :global([data-step='3']) .ps .seg--bin,
  :global([data-step='4']) .ps .seg--bin {
    width: 0px;
    opacity: 0;
  }

  :global([data-step='1']) .ps .seg--apps,
  :global([data-step='2']) .ps .seg--apps,
  :global([data-step='3']) .ps .seg--apps,
  :global([data-step='4']) .ps .seg--apps {
    x: 384px;
  }

  :global([data-step='1']) .ps .seg--media,
  :global([data-step='2']) .ps .seg--media {
    x: 430px;
  }

  :global([data-step='1']) .ps .seg--sys,
  :global([data-step='2']) .ps .seg--sys {
    x: 467px;
  }

  :global([data-step='1']) .ps .chip--1,
  :global([data-step='2']) .ps .chip--1,
  :global([data-step='3']) .ps .chip--1,
  :global([data-step='4']) .ps .chip--1 {
    opacity: 1;
    transform: translate(590px, 280px) scale(1);
  }

  /* 2 — offload the apps you never open */
  :global([data-step='2']) .ps .row--apps {
    opacity: 1;
  }

  :global([data-step='2']) .ps .seg--apps,
  :global([data-step='3']) .ps .seg--apps,
  :global([data-step='4']) .ps .seg--apps {
    width: 0px;
    opacity: 0;
  }

  :global([data-step='2']) .ps .seg--media,
  :global([data-step='3']) .ps .seg--media,
  :global([data-step='4']) .ps .seg--media {
    x: 384px;
  }

  :global([data-step='2']) .ps .seg--sys,
  :global([data-step='3']) .ps .seg--sys {
    x: 421px;
  }

  :global([data-step='2']) .ps .chip--2,
  :global([data-step='3']) .ps .chip--2,
  :global([data-step='4']) .ps .chip--2 {
    opacity: 1;
    transform: translate(590px, 324px) scale(1);
  }

  /* 3 — clear offline downloads */
  :global([data-step='3']) .ps .row--media {
    opacity: 1;
  }

  :global([data-step='3']) .ps .seg--media,
  :global([data-step='4']) .ps .seg--media {
    width: 0px;
    opacity: 0;
  }

  :global([data-step='3']) .ps .seg--sys,
  :global([data-step='4']) .ps .seg--sys {
    x: 384px;
  }

  :global([data-step='3']) .ps .chip--3,
  :global([data-step='4']) .ps .chip--3 {
    opacity: 1;
    transform: translate(590px, 368px) scale(1);
  }

  /* 4 — back in the green */
  :global([data-step='4']) .ps .legend .row {
    opacity: 1;
  }

  :global([data-step='4']) .ps .used--before {
    opacity: 0;
  }

  :global([data-step='4']) .ps .used--after {
    opacity: 1;
  }

  :global([data-step='4']) .ps .done {
    opacity: 1;
    transform: scale(1);
  }
</style>
