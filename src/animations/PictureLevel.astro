---
/* The paper-template trick for hanging a picture level on the first try. */
---

<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="pl">
  <!-- wall -->
  <rect class="wall" x="0" y="0" width="800" height="500" />
  <path class="skirting" d="M0 452 H800" />

  <!-- the frame, seen from the back at step 0 -->
  <g class="frame">
    <rect class="framebody" x="0" y="0" width="250" height="180" rx="6" />
    <rect class="framemat" x="18" y="18" width="214" height="144" rx="3" />
    <path class="hangwire" d="M40 44 C 96 92, 154 92, 210 44" />
    <circle class="hangpoint" cx="125" cy="80" r="9" />
  </g>

  <!-- paper template -->
  <g class="paper">
    <rect class="paperbody" x="0" y="0" width="250" height="180" rx="4" />
    <path class="papertrace" d="M12 12 H238 V168 H12 Z" />
    <g class="marker">
      <path class="cross" d="M108 80 H142 M125 63 V97" />
      <circle class="crosshair" cx="125" cy="80" r="15" />
    </g>
    <g class="tape">
      <rect x="-14" y="-12" width="46" height="20" rx="3" transform="rotate(-16 9 -2)" />
      <rect x="218" y="-12" width="46" height="20" rx="3" transform="rotate(14 241 -2)" />
    </g>
  </g>

  <!-- spirit level -->
  <g class="level">
    <rect class="levelbody" x="0" y="0" width="260" height="34" rx="8" />
    <rect class="levelvial" x="106" y="8" width="48" height="18" rx="9" />
    <circle class="bubble" cx="130" cy="17" r="6" />
  </g>

  <!-- nail going in -->
  <g class="nail">
    <path class="nailshaft" d="M0 -60 V0" />
    <path class="nailhead" d="M-13 -60 H13" />
    <g class="hook">
      <path d="M-16 0 H16 L4 26 Z" />
    </g>
  </g>

  <!-- hung frame -->
  <g class="hung">
    <rect class="framebody" x="0" y="0" width="250" height="180" rx="6" />
    <rect class="framemat" x="18" y="18" width="214" height="144" rx="3" />
    <path class="art" d="M40 132 L96 74 L134 112 L170 82 L210 132 Z" />
    <circle class="sun" cx="186" cy="56" r="14" />
  </g>

  <!-- eye-level guide -->
  <g class="guideline">
    <path class="dash" d="M40 200 H760" />
    <text class="tag" x="40" y="188">centre ≈ 145 cm / 57 in from the floor</text>
  </g>

  <g class="done">
    <circle class="tickbg" cx="700" cy="400" r="34" />
    <path class="tick" d="M684 400 l11 12 l21 -25" />
  </g>
</svg>

<style>
  .pl {
    --dur: 0.7s;
    --ease: cubic-bezier(0.65, 0, 0.35, 1);
  }

  .pl .wall {
    fill: var(--paper-deep);
  }

  .pl .skirting {
    stroke: var(--ink);
    stroke-width: 6;
    fill: none;
  }

  .pl .tag {
    font-family: var(--font-mono);
    font-size: 17px;
    fill: var(--ink-3);
  }

  /* --- frame ------------------------------------------------------------- */
  .pl .frame {
    transform: translate(70px, 130px);
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }

  .pl .framebody {
    fill: color-mix(in srgb, var(--ink) 88%, var(--accent));
  }

  .pl .framemat {
    fill: var(--paper);
  }

  .pl .hangwire {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 4;
  }

  .pl .hangpoint {
    fill: var(--accent);
  }

  /* --- paper ------------------------------------------------------------- */
  .pl .paper {
    transform: translate(430px, 150px);
    opacity: 0;
    transition: transform 0.8s var(--ease), opacity var(--dur) var(--ease);
  }

  .pl .paperbody {
    fill: #fff;
    stroke: var(--line);
    stroke-width: 2;
  }

  .pl .papertrace {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 3;
    stroke-dasharray: 9 8;
  }

  .pl .cross {
    stroke: var(--accent);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .pl .crosshair {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
  }

  .pl .marker {
    opacity: 0;
    transition: opacity 0.4s var(--ease) 0.25s;
  }

  .pl .tape rect {
    fill: color-mix(in srgb, var(--brand) 32%, #fff);
    stroke: color-mix(in srgb, var(--brand) 55%, transparent);
    stroke-width: 2;
  }

  .pl .tape {
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }

  /* --- level ------------------------------------------------------------- */
  .pl .level {
    transform: translate(420px, 116px) rotate(-4deg);
    opacity: 0;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }

  .pl .levelbody {
    fill: var(--ink);
  }

  .pl .levelvial {
    fill: color-mix(in srgb, var(--brand) 30%, #fff);
  }

  .pl .bubble {
    fill: var(--brand);
    transition: transform var(--dur) var(--ease);
  }

  /* --- nail -------------------------------------------------------------- */
  .pl .nail {
    transform: translate(555px, 230px);
    opacity: 0;
    transition: transform var(--dur) var(--ease), opacity 0.3s var(--ease);
  }

  .pl .nailshaft {
    stroke: var(--ink);
    stroke-width: 6;
    fill: none;
  }

  .pl .nailhead {
    stroke: var(--ink);
    stroke-width: 8;
    stroke-linecap: round;
    fill: none;
  }

  .pl .hook path {
    fill: var(--ink-2);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }

  /* --- hung -------------------------------------------------------------- */
  .pl .hung {
    transform: translate(430px, 150px);
    opacity: 0;
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .pl .art {
    fill: color-mix(in srgb, var(--brand) 55%, var(--paper));
  }

  .pl .sun {
    fill: var(--accent);
  }

  /* --- guides ------------------------------------------------------------ */
  .pl .guideline {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .pl .dash {
    fill: none;
    stroke: var(--brand);
    stroke-width: 3;
    stroke-dasharray: 12 10;
  }

  .pl .done {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.6);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .pl .tickbg {
    fill: var(--brand);
  }

  .pl .tick {
    fill: none;
    stroke: #fff;
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ======================================================================
     Step states
     ====================================================================== */

  /* 0 — trace the frame on paper and mark where the hanger sits */
  :global([data-step='0']) .pl .paper {
    opacity: 1;
    transform: translate(430px, 150px);
  }

  :global([data-step='0']) .pl .marker {
    opacity: 1;
  }

  /* 1 — tape it to the wall and level it */
  :global([data-step='1']) .pl .frame {
    transform: translate(70px, 130px) rotate(-4deg);
    opacity: 0.35;
  }

  :global([data-step='1']) .pl .paper,
  :global([data-step='2']) .pl .paper {
    opacity: 1;
    transform: translate(420px, 150px);
  }

  :global([data-step='1']) .pl .marker,
  :global([data-step='2']) .pl .marker {
    opacity: 1;
  }

  :global([data-step='1']) .pl .tape,
  :global([data-step='2']) .pl .tape {
    opacity: 1;
  }

  :global([data-step='1']) .pl .level,
  :global([data-step='2']) .pl .level {
    opacity: 1;
    transform: translate(415px, 112px) rotate(0deg);
  }

  :global([data-step='1']) .pl .guideline,
  :global([data-step='2']) .pl .guideline {
    opacity: 1;
  }

  /* 2 — drive the nail straight through the mark */
  :global([data-step='2']) .pl .frame {
    opacity: 0.35;
  }

  :global([data-step='2']) .pl .nail {
    opacity: 1;
    transform: translate(545px, 230px);
  }

  /* 3 — tear the paper away, hook is exactly where the mark was */
  :global([data-step='3']) .pl .paper {
    opacity: 0;
    transform: translate(420px, 420px) rotate(22deg);
  }

  :global([data-step='3']) .pl .frame {
    opacity: 0.35;
  }

  :global([data-step='3']) .pl .nail,
  :global([data-step='4']) .pl .nail {
    opacity: 1;
    transform: translate(545px, 230px);
  }

  :global([data-step='3']) .pl .hook path,
  :global([data-step='4']) .pl .hook path {
    opacity: 1;
  }

  /* 4 — hang it; level first try */
  :global([data-step='4']) .pl .frame {
    opacity: 0;
    transform: translate(70px, 130px) scale(0.9);
  }

  :global([data-step='4']) .pl .paper {
    opacity: 0;
  }

  :global([data-step='4']) .pl .hung {
    opacity: 1;
  }

  :global([data-step='4']) .pl .guideline {
    opacity: 1;
  }

  :global([data-step='4']) .pl .done {
    opacity: 1;
    transform: scale(1);
  }
</style>
