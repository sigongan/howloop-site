---
/* Cutaway of a panel radiator: trapped air at the top, bleed valve, water. */
---

<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="rd">
  <!-- wall + radiator shell -->
  <path class="ln wall" d="M60 430 H740" />
  <rect class="shell" x="150" y="110" width="480" height="290" rx="14" />

  <!-- fins -->
  <g class="fins">
    <path d="M210 130 V380" /><path d="M270 130 V380" />
    <path d="M330 130 V380" /><path d="M390 130 V380" />
    <path d="M450 130 V380" /><path d="M510 130 V380" />
    <path d="M570 130 V380" />
  </g>

  <!-- water inside, rising as air leaves -->
  <g class="waterwrap">
    <rect class="water" x="158" y="0" width="464" height="284" />
  </g>

  <!-- trapped air pocket -->
  <g class="air">
    <rect class="airfill" x="158" y="118" width="464" height="96" rx="6" />
    <text class="tag" x="330" y="172">trapped air</text>
  </g>

  <!-- legs / pipes -->
  <path class="ln" d="M200 400 V430" />
  <path class="ln" d="M580 400 V430" />

  <!-- bleed valve, top right -->
  <g class="valve">
    <rect class="valvebody" x="622" y="128" width="30" height="30" rx="5" />
    <path class="ln thin" d="M652 143 H676" />
  </g>

  <!-- the key -->
  <g class="key">
    <rect class="keyhead" x="0" y="0" width="30" height="30" rx="5" />
    <rect class="keyshaft" x="28" y="9" width="52" height="12" rx="6" />
    <path class="turnarrow" d="M14 -18 A 26 26 0 0 0 -14 4" />
    <path class="turnarrow" d="M-20 -4 l6 10 l10 -6" />
  </g>

  <!-- cloth under the valve -->
  <path class="cloth" d="M600 190 h96 l-14 44 h-68 Z" />

  <!-- escaping air -->
  <g class="hiss">
    <path class="hissline" d="M660 138 H720" />
    <path class="hissline h2" d="M660 150 H706" />
    <path class="hissline h3" d="M660 128 H700" />
  </g>

  <!-- the dribble that tells you to stop -->
  <g class="drip">
    <circle cx="668" cy="160" r="6" />
    <circle cx="668" cy="182" r="5" />
  </g>

  <!-- cold top / hot bottom markers -->
  <g class="temp">
    <g class="cold">
      <circle cx="110" cy="170" r="22" />
      <text x="110" y="177" text-anchor="middle">cold</text>
    </g>
    <g class="hot">
      <circle cx="110" cy="340" r="22" />
      <text x="110" y="347" text-anchor="middle">hot</text>
    </g>
  </g>

  <!-- boiler pressure gauge -->
  <g class="gauge">
    <circle class="gaugebg" cx="706" cy="360" r="46" />
    <path class="gaugearc" d="M676 382 A 38 38 0 1 1 736 382" />
    <path class="needle" d="M706 360 L688 336" />
    <circle class="hub" cx="706" cy="360" r="6" />
    <text class="tag mid" x="706" y="424">boiler pressure</text>
  </g>

  <g class="done">
    <circle class="tickbg" cx="110" cy="90" r="32" />
    <path class="tick" d="M95 90 l10 11 l20 -23" />
  </g>
</svg>

<style>
  .rd {
    --dur: 0.7s;
    --ease: cubic-bezier(0.65, 0, 0.35, 1);
  }

  .rd .ln {
    fill: none;
    stroke: var(--ink);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .rd .thin {
    stroke-width: 4;
  }

  .rd .wall {
    stroke-width: 6;
  }

  .rd .shell {
    fill: var(--paper-deep);
    stroke: var(--ink);
    stroke-width: 5;
  }

  .rd .fins path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
    opacity: 0.28;
  }

  .rd .tag {
    font-family: var(--font-mono);
    font-size: 17px;
    fill: var(--ink-3);
  }

  .rd .mid {
    text-anchor: middle;
  }

  /* --- water / air -------------------------------------------------------- */
  .rd .waterwrap {
    transform: translateY(214px);
    transition: transform 1s var(--ease);
  }

  .rd .water {
    fill: color-mix(in srgb, var(--brand) 22%, transparent);
  }

  .rd .air {
    opacity: 1;
    transition: opacity var(--dur) var(--ease);
  }

  .rd .airfill {
    fill: color-mix(in srgb, var(--ink) 8%, transparent);
    stroke: var(--ink-3);
    stroke-width: 2.5;
    stroke-dasharray: 8 7;
  }

  /* --- valve + key -------------------------------------------------------- */
  .rd .valvebody {
    fill: var(--ink);
  }

  .rd .key {
    transform: translate(700px, 128px);
    opacity: 0;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }

  .rd .keyhead,
  .rd .keyshaft {
    fill: var(--accent);
  }

  .rd .turnarrow {
    fill: none;
    stroke: var(--accent-deep);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .rd .cloth {
    fill: color-mix(in srgb, var(--brand) 18%, var(--paper));
    stroke: var(--brand);
    stroke-width: 2.5;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  /* --- hiss / drip -------------------------------------------------------- */
  .rd .hiss,
  .rd .drip {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .rd .hissline {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 10 10;
    animation: rd-hiss 0.7s linear infinite;
  }

  .rd .h2 {
    animation-delay: -0.25s;
    opacity: 0.6;
  }
  .rd .h3 {
    animation-delay: -0.5s;
    opacity: 0.6;
  }

  @keyframes rd-hiss {
    to {
      stroke-dashoffset: -20;
    }
  }

  .rd .drip circle {
    fill: var(--brand);
    animation: rd-drip 1.4s ease-in infinite;
  }

  .rd .drip circle:nth-child(2) {
    animation-delay: -0.7s;
  }

  @keyframes rd-drip {
    0% {
      transform: translateY(-10px);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      transform: translateY(46px);
      opacity: 0;
    }
  }

  /* --- temperature markers ------------------------------------------------ */
  .rd .temp {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .rd .cold circle {
    fill: var(--surface);
    stroke: var(--ink-3);
    stroke-width: 3;
  }

  .rd .hot circle {
    fill: var(--accent-tint);
    stroke: var(--accent);
    stroke-width: 3;
  }

  .rd .temp text {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    fill: var(--ink-2);
  }

  /* --- gauge -------------------------------------------------------------- */
  .rd .gauge {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .rd .gaugebg {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 3;
  }

  .rd .gaugearc {
    fill: none;
    stroke: var(--brand-tint-2);
    stroke-width: 7;
    stroke-linecap: round;
  }

  .rd .needle {
    stroke: var(--accent);
    stroke-width: 5;
    stroke-linecap: round;
    fill: none;
    transform-box: fill-box;
    transform-origin: 100% 100%;
    transition: transform var(--dur) var(--ease);
  }

  .rd .hub {
    fill: var(--ink);
  }

  .rd .done {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.6);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .rd .tickbg {
    fill: var(--brand);
  }

  .rd .tick {
    fill: none;
    stroke: #fff;
    stroke-width: 5.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ======================================================================
     Step states
     ====================================================================== */

  /* 0 — the symptom: cold at the top, hot at the bottom */
  :global([data-step='0']) .rd .temp {
    opacity: 1;
  }

  /* 1 — heating off, radiator cool, cloth ready */
  :global([data-step='1']) .rd .cloth,
  :global([data-step='2']) .rd .cloth,
  :global([data-step='3']) .rd .cloth,
  :global([data-step='4']) .rd .cloth {
    opacity: 1;
  }

  :global([data-step='1']) .rd .key,
  :global([data-step='2']) .rd .key,
  :global([data-step='3']) .rd .key {
    opacity: 1;
    transform: translate(622px, 128px);
  }

  /* 2 — turn the key slowly anticlockwise; air hisses out */
  :global([data-step='2']) .rd .hiss {
    opacity: 1;
  }

  :global([data-step='2']) .rd .turnarrow {
    opacity: 1;
  }

  :global([data-step='2']) .rd .waterwrap {
    transform: translateY(160px);
  }

  :global([data-step='2']) .rd .airfill {
    opacity: 0.5;
  }

  /* 3 — water dribbles: close it immediately */
  :global([data-step='3']) .rd .drip {
    opacity: 1;
  }

  :global([data-step='3']) .rd .waterwrap,
  :global([data-step='4']) .rd .waterwrap {
    transform: translateY(118px);
  }

  :global([data-step='3']) .rd .air,
  :global([data-step='4']) .rd .air {
    opacity: 0;
  }

  /* 4 — top the boiler pressure back up */
  :global([data-step='4']) .rd .key {
    opacity: 0;
    transform: translate(700px, 128px);
  }

  :global([data-step='4']) .rd .gauge {
    opacity: 1;
  }

  :global([data-step='4']) .rd .needle {
    transform: rotate(38deg);
  }

  :global([data-step='4']) .rd .done {
    opacity: 1;
    transform: scale(1);
  }
</style>
