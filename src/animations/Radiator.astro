---
/*
 * Bleeding a radiator — high-fidelity vector.
 *
 * Painted steel panel in section. Trapped air sits at the top because that is
 * where air always goes; the bleed valve is the only way out.
 */
---

<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="rd">
  <defs>
    <linearGradient id="rdSteel" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="0.12" stop-color="#f0f2f4" />
      <stop offset="0.6" stop-color="#e2e6e9" />
      <stop offset="1" stop-color="#cdd2d7" />
    </linearGradient>

    <linearGradient id="rdWater" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8ed6c3" stop-opacity="0.8" />
      <stop offset="1" stop-color="#31967b" stop-opacity="0.55" />
    </linearGradient>

    <linearGradient id="rdKey" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffa95c" />
      <stop offset="0.45" stop-color="#ee6c1e" />
      <stop offset="1" stop-color="#a94709" />
    </linearGradient>

    <linearGradient id="rdChrome" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7d858f" />
      <stop offset="0.2" stop-color="#eef1f4" />
      <stop offset="0.55" stop-color="#aab2ba" />
      <stop offset="1" stop-color="#6d747d" />
    </linearGradient>

    <filter id="rdShadow" x="-30%" y="-30%" width="160%" height="180%">
      <feDropShadow dx="0" dy="7" stdDeviation="8" flood-color="#14171c" flood-opacity="0.2" />
    </filter>
    <filter id="rdShadowSm" x="-40%" y="-40%" width="180%" height="200%">
      <feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="#14171c" flood-opacity="0.28" />
    </filter>

    <clipPath id="rdPanelClip">
      <rect x="152" y="112" width="476" height="286" rx="12" />
    </clipPath>
  </defs>

  <!-- wall and floor -->
  <path class="wall" d="M60 430 H740" />

  <!-- radiator panel -->
  <g filter="url(#rdShadow)">
    <rect class="panel" x="150" y="110" width="480" height="290" rx="14" />
  </g>

  <g clip-path="url(#rdPanelClip)">
    <!-- water inside -->
    <g class="waterwrap">
      <rect class="water" x="152" y="0" width="476" height="290" />
      <path class="waterline" d="M152 0 H628" />
    </g>

    <!-- trapped air -->
    <g class="air">
      <rect class="airfill" x="152" y="112" width="476" height="98" />
    </g>

    <!-- convector fins, seen through the cut -->
    <g class="fins">
      <path d="M210 124 V386" /><path d="M270 124 V386" /><path d="M330 124 V386" />
      <path d="M390 124 V386" /><path d="M450 124 V386" /><path d="M510 124 V386" />
      <path d="M570 124 V386" />
    </g>
  </g>

  <rect class="panelline" x="150" y="110" width="480" height="290" rx="14" />

  <!-- pipes -->
  <g filter="url(#rdShadowSm)">
    <path class="pipe" d="M200 400 V430" />
    <path class="pipe" d="M580 400 V430" />
  </g>

  <!-- bleed valve, top right -->
  <g class="valve">
    <rect class="valvebody" x="620" y="126" width="32" height="32" rx="6" />
    <rect class="valvesq" x="628" y="134" width="16" height="16" rx="3" />
  </g>

  <!-- the key -->
  <g class="key">
    <g filter="url(#rdShadowSm)">
      <rect class="keyhead" x="0" y="0" width="32" height="32" rx="6" />
      <rect class="keyshaft" x="30" y="10" width="56" height="12" rx="6" />
    </g>
    <path class="turnarrow" d="M16 -20 A 28 28 0 0 0 -14 4" />
    <path class="turnarrow" d="M-20 -4 l6 10 l10 -6" />
  </g>

  <!-- cloth -->
  <path class="cloth" d="M596 194 h104 l-16 48 h-72 Z" />

  <!-- escaping air -->
  <g class="hiss">
    <path class="hissline" d="M658 136 H722" />
    <path class="hissline h2" d="M658 148 H708" />
    <path class="hissline h3" d="M658 126 H702" />
  </g>

  <!-- the dribble that means stop -->
  <g class="drip">
    <circle cx="666" cy="162" r="6" />
    <circle cx="666" cy="184" r="5" />
  </g>

  <!-- cold / hot -->
  <g class="temp">
    <g class="cold">
      <circle cx="104" cy="168" r="26" />
      <text x="104" y="175" text-anchor="middle">cold</text>
    </g>
    <g class="hot">
      <circle cx="104" cy="344" r="26" />
      <text x="104" y="351" text-anchor="middle">hot</text>
    </g>
  </g>

  <!-- boiler pressure gauge -->
  <g class="gauge">
    <g filter="url(#rdShadowSm)">
      <circle class="gaugebg" cx="700" cy="356" r="48" />
    </g>
    <path class="gaugearc" d="M668 380 A 40 40 0 1 1 732 380" />
    <path class="gaugeband" d="M686 372 A 40 40 0 0 1 714 372" />
    <path class="needle" d="M700 356 L680 330" />
    <circle class="hub" cx="700" cy="356" r="6" />
  </g>

  <!-- callouts -->
  <g class="labels">
    <g class="lab lab--air">
      <path class="lead" d="M390 160 L390 92" />
      <circle class="leaddot" cx="390" cy="160" r="4.5" />
      <g class="tagbox tagbox--warn">
        <rect x="300" y="60" width="180" height="32" rx="16" />
        <text x="390" y="81">trapped air</text>
      </g>
    </g>
    <g class="lab lab--valve">
      <path class="lead" d="M636 158 L700 216" />
      <circle class="leaddot" cx="636" cy="158" r="4.5" />
      <g class="tagbox">
        <rect x="620" y="216" width="168" height="32" rx="16" />
        <text x="704" y="237">bleed valve</text>
      </g>
      <circle class="marker marker--sm" cx="636" cy="142" r="42" />
    </g>
  </g>

  <g class="cooltag">
    <g class="tagbox tagbox--bad">
      <rect x="30" y="60" width="252" height="32" rx="16" />
      <text x="156" y="81">heating off, let it cool</text>
    </g>
  </g>

  <g class="stoptag">
    <g class="tagbox tagbox--bad">
      <rect x="30" y="60" width="272" height="32" rx="16" />
      <text x="166" y="81">water appears — close it</text>
    </g>
  </g>

  <g class="pressuretag">
    <g class="tagbox tagbox--ok">
      <rect x="30" y="60" width="284" height="32" rx="16" />
      <text x="172" y="81">top the boiler back up</text>
    </g>
  </g>

  <g class="done">
    <circle class="tickbg" cx="104" cy="256" r="34" />
    <path class="tick" d="M88 256 l11 12 l21 -25" />
  </g>
</svg>

<style>
  .rd {
    --dur: 0.65s;
    --ease: cubic-bezier(0.65, 0, 0.35, 1);
  }

  .rd .wall {
    fill: none;
    stroke: var(--ink);
    stroke-width: 6;
    stroke-linecap: round;
  }

  .rd .panel {
    fill: url(#rdSteel);
  }

  .rd .panelline {
    fill: none;
    stroke: var(--ink);
    stroke-width: 5;
  }

  .rd .fins path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
    opacity: 0.16;
  }

  .rd .pipe {
    fill: none;
    stroke: url(#rdChrome);
    stroke-width: 11;
    stroke-linecap: round;
  }

  /* ---------- water / air ---------- */
  .rd .waterwrap {
    transform: translateY(210px);
    transition: transform 1s var(--ease);
  }

  .rd .water {
    fill: url(#rdWater);
  }

  .rd .waterline {
    fill: none;
    stroke: #2f9c80;
    stroke-width: 4;
  }

  .rd .air {
    transition: opacity var(--dur) var(--ease);
  }

  .rd .airfill {
    fill: #ffffff;
    stroke: var(--ink-3);
    stroke-width: 2.5;
    stroke-dasharray: 9 8;
    opacity: 0.85;
  }

  /* ---------- valve + key ---------- */
  .rd .valvebody {
    fill: url(#rdChrome);
    stroke: #5f666e;
    stroke-width: 2;
  }

  .rd .valvesq {
    fill: #4a5158;
  }

  .rd .key {
    transform: translate(700px, 126px);
    opacity: 0;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }

  .rd .keyhead,
  .rd .keyshaft {
    fill: url(#rdKey);
  }

  .rd .turnarrow {
    fill: none;
    stroke: #a94709;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .rd .cloth {
    fill: #e8f4ef;
    stroke: #2f9c80;
    stroke-width: 2.5;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  /* ---------- hiss / drip ---------- */
  .rd .hiss,
  .rd .drip {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .rd .hissline {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 10 10;
    animation: rd-hiss 0.7s linear infinite;
  }

  .rd .h2 {
    animation-delay: -0.25s;
    opacity: 0.6;
  }
  .rd .h3 {
    animation-delay: -0.5s;
    opacity: 0.6;
  }

  @keyframes rd-hiss {
    to {
      stroke-dashoffset: -20;
    }
  }

  .rd .drip circle {
    fill: #37a086;
    animation: rd-drip 1.4s ease-in infinite;
  }

  .rd .drip circle:nth-child(2) {
    animation-delay: -0.7s;
  }

  @keyframes rd-drip {
    0% {
      transform: translateY(-10px);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      transform: translateY(48px);
      opacity: 0;
    }
  }

  /* ---------- temperature ---------- */
  .rd .temp {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .rd .cold circle {
    fill: #eef4f8;
    stroke: #7f9bb0;
    stroke-width: 3;
  }

  .rd .hot circle {
    fill: var(--accent-tint);
    stroke: var(--accent);
    stroke-width: 3;
  }

  .rd .temp text {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    fill: var(--ink-2);
  }

  /* ---------- gauge ---------- */
  .rd .gauge {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .rd .gaugebg {
    fill: #ffffff;
    stroke: var(--ink);
    stroke-width: 3;
  }

  .rd .gaugearc {
    fill: none;
    stroke: #dfe3e7;
    stroke-width: 8;
    stroke-linecap: round;
  }

  .rd .gaugeband {
    fill: none;
    stroke: var(--brand);
    stroke-width: 8;
    stroke-linecap: round;
  }

  .rd .needle {
    stroke: var(--danger);
    stroke-width: 5;
    stroke-linecap: round;
    fill: none;
    transform-box: fill-box;
    transform-origin: 100% 100%;
    transition: transform var(--dur) var(--ease);
  }

  .rd .hub {
    fill: var(--ink);
  }

  /* ---------- callouts ---------- */
  .rd .marker {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4;
    stroke-dasharray: 10 9;
    animation: rd-spin 16s linear infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .rd .marker--sm {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  @keyframes rd-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .rd .tagbox rect {
    fill: var(--ink);
  }

  .rd .tagbox text {
    fill: #fff;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    text-anchor: middle;
  }

  .rd .tagbox--warn rect {
    fill: var(--accent-deep);
  }
  .rd .tagbox--bad rect {
    fill: var(--danger);
  }
  .rd .tagbox--ok rect {
    fill: var(--brand);
  }

  .rd .lead {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .rd .leaddot {
    fill: var(--ink);
  }

  .rd .labels,
  .rd .lab,
  .rd .cooltag,
  .rd .stoptag,
  .rd .pressuretag {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .rd .done {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.6);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .rd .tickbg {
    fill: var(--brand);
  }

  .rd .tick {
    fill: none;
    stroke: #fff;
    stroke-width: 5.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ======================================================================
     Step states
     ====================================================================== */

  /* 0 — cold at the top, hot at the bottom: that is air, not sludge */
  :global([data-step='0']) .rd .temp {
    opacity: 1;
  }

  :global([data-step='0']) .rd .labels,
  :global([data-step='0']) .rd .lab--air {
    opacity: 1;
  }

  /* 1 — heating off, cooled, cloth and key ready */
  :global([data-step='1']) .rd .cooltag {
    opacity: 1;
  }

  :global([data-step='1']) .rd .cloth,
  :global([data-step='2']) .rd .cloth,
  :global([data-step='3']) .rd .cloth,
  :global([data-step='4']) .rd .cloth {
    opacity: 1;
  }

  :global([data-step='1']) .rd .key,
  :global([data-step='2']) .rd .key,
  :global([data-step='3']) .rd .key {
    opacity: 1;
    transform: translate(620px, 126px);
  }

  :global([data-step='1']) .rd .labels,
  :global([data-step='1']) .rd .lab--valve {
    opacity: 1;
  }

  :global([data-step='1']) .rd .marker--sm {
    opacity: 1;
  }

  /* 2 — quarter turn anticlockwise; air hisses out and water rises */
  :global([data-step='2']) .rd .hiss,
  :global([data-step='2']) .rd .turnarrow {
    opacity: 1;
  }

  :global([data-step='2']) .rd .waterwrap {
    transform: translateY(158px);
  }

  :global([data-step='2']) .rd .airfill {
    opacity: 0.5;
  }

  /* 3 — water dribbles: close it now */
  :global([data-step='3']) .rd .drip,
  :global([data-step='3']) .rd .stoptag {
    opacity: 1;
  }

  :global([data-step='3']) .rd .waterwrap,
  :global([data-step='4']) .rd .waterwrap {
    transform: translateY(112px);
  }

  :global([data-step='3']) .rd .air,
  :global([data-step='4']) .rd .air {
    opacity: 0;
  }

  /* 4 — the step everyone forgets: boiler pressure */
  :global([data-step='4']) .rd .key {
    opacity: 0;
    transform: translate(700px, 126px);
  }

  :global([data-step='4']) .rd .gauge,
  :global([data-step='4']) .rd .pressuretag {
    opacity: 1;
  }

  :global([data-step='4']) .rd .needle {
    transform: rotate(38deg);
  }

  :global([data-step='4']) .rd .done {
    opacity: 1;
    transform: scale(1);
  }
</style>
