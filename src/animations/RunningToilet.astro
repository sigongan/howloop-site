---
/* Cutaway of a toilet tank: fill valve, float, overflow tube, flapper, chain. */
---

<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="rt">
  <!-- tank shell -->
  <path class="ln" d="M150 96 V424 H650 V96" />
  <path class="ln lid" d="M136 84 H664" />

  <!-- water -->
  <g class="waterwrap">
    <rect class="water" x="156" y="0" width="488" height="424" />
    <path class="waterline" d="M156 0 H644" />
  </g>

  <!-- overflow tube -->
  <rect class="tube" x="470" y="182" width="38" height="240" rx="4" />
  <ellipse class="tubelip" cx="489" cy="182" rx="19" ry="6" />
  <path class="ln thin dashed" d="M156 208 H470" />
  <text class="tag" x="166" y="200">fill line</text>

  <!-- fill valve + float -->
  <path class="ln" d="M232 422 V150" />
  <rect class="valvecap" x="206" y="126" width="52" height="26" rx="8" />
  <path class="ln thin refill" d="M258 160 C 330 160, 400 168, 470 190" />
  <g class="float">
    <rect class="floatcup" x="196" y="0" width="72" height="58" rx="10" />
  </g>

  <!-- flush valve seat + flapper -->
  <path class="ln" d="M540 422 H630" />
  <g class="flapper">
    <path class="flapbody" d="M528 414 C 528 396, 556 388, 578 396 L612 410 C 620 414, 616 422, 606 422 H536 C 530 422, 528 419, 528 414 Z" />
  </g>

  <!-- chain + lever -->
  <path class="ln lever" d="M150 150 H300" />
  <circle class="pivot" cx="150" cy="150" r="9" />
  <path class="chain" d="M300 150 C 340 250, 420 330, 560 396" />

  <!-- water escaping into the tube (the running sound) -->
  <g class="spill">
    <path class="flow" d="M470 190 C 480 200, 484 210, 486 224" />
    <path class="flow d2" d="M508 190 C 500 200, 494 210, 492 224" />
  </g>

  <!-- leak past the flapper -->
  <g class="leak">
    <path class="dyeline" d="M560 418 C 566 436, 572 452, 578 470" />
    <path class="dyeline d2" d="M586 418 C 590 438, 592 454, 594 470" />
  </g>

  <!-- dye drops for the test -->
  <g class="dye">
    <circle cx="360" cy="150" r="9" />
    <circle cx="392" cy="176" r="7" />
    <circle cx="336" cy="188" r="6" />
  </g>

  <!-- done -->
  <g class="done">
    <circle class="tickbg" cx="700" cy="150" r="34" />
    <path class="tick" d="M684 150 l11 12 l21 -25" />
  </g>
</svg>

<style>
  .rt {
    --dur: 0.7s;
    --ease: cubic-bezier(0.65, 0, 0.35, 1);
  }

  .rt .ln {
    fill: none;
    stroke: var(--ink);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rt .thin {
    stroke-width: 3;
  }

  .rt .dashed {
    stroke-dasharray: 10 9;
    stroke: var(--ink-3);
  }

  .rt .lid {
    stroke-width: 7;
  }

  .rt .tag {
    font-family: var(--font-mono);
    font-size: 17px;
    fill: var(--ink-3);
  }

  /* --- water ------------------------------------------------------------- */
  .rt .waterwrap {
    transform: translateY(150px);
    transition: transform var(--dur) var(--ease);
  }

  .rt .water {
    fill: color-mix(in srgb, var(--brand) 20%, transparent);
  }

  .rt .waterline {
    fill: none;
    stroke: var(--brand);
    stroke-width: 4;
  }

  /* --- parts ------------------------------------------------------------- */
  .rt .tube {
    fill: var(--paper-deep);
    stroke: var(--ink);
    stroke-width: 4;
  }

  .rt .tubelip {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 4;
  }

  .rt .valvecap {
    fill: var(--ink);
  }

  .rt .refill {
    stroke: var(--ink-3);
  }

  .rt .float {
    transform: translateY(178px);
    transition: transform var(--dur) var(--ease);
  }

  .rt .floatcup {
    fill: var(--accent);
    stroke: var(--accent-deep);
    stroke-width: 3;
  }

  .rt .flapper {
    transform-box: fill-box;
    transform-origin: 100% 100%;
    transform: rotate(-13deg);
    transition: transform var(--dur) var(--ease);
  }

  .rt .flapbody {
    fill: color-mix(in srgb, var(--ink) 85%, var(--accent));
  }

  .rt .lever,
  .rt .pivot {
    stroke: var(--ink);
  }

  .rt .pivot {
    fill: var(--paper);
    stroke-width: 5;
  }

  .rt .chain {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 4;
    stroke-dasharray: 3 7;
    stroke-linecap: round;
    transition: d var(--dur) var(--ease), stroke var(--dur) var(--ease);
  }

  /* --- flows ------------------------------------------------------------- */
  .rt .flow,
  .rt .dyeline {
    fill: none;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 12 12;
    animation: rt-flow 0.8s linear infinite;
  }

  .rt .flow {
    stroke: var(--brand);
  }

  .rt .dyeline {
    stroke: var(--accent);
  }

  .rt .d2 {
    animation-delay: -0.4s;
    opacity: 0.7;
  }

  @keyframes rt-flow {
    to {
      stroke-dashoffset: -24;
    }
  }

  .rt .spill,
  .rt .leak,
  .rt .dye {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .rt .dye circle {
    fill: var(--accent);
    animation: rt-drop 1.6s ease-in-out infinite;
  }

  .rt .dye circle:nth-child(2) {
    animation-delay: -0.5s;
  }

  .rt .dye circle:nth-child(3) {
    animation-delay: -1s;
  }

  @keyframes rt-drop {
    0% {
      transform: translateY(-26px);
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    100% {
      transform: translateY(60px);
      opacity: 0;
    }
  }

  .rt .done {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.6);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .rt .tickbg {
    fill: var(--brand);
  }

  .rt .tick {
    fill: none;
    stroke: #fff;
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ======================================================================
     Step states
     ====================================================================== */

  /* 0 — the problem: water above the overflow tube, pouring in */
  :global([data-step='0']) .rt .spill {
    opacity: 1;
  }

  /* 1 — dye test: colour seeps past a bad flapper */
  :global([data-step='1']) .rt .dye,
  :global([data-step='1']) .rt .leak {
    opacity: 1;
  }

  :global([data-step='1']) .rt .spill {
    opacity: 1;
  }

  /* 2 — free the chain, reseat the flapper */
  :global([data-step='2']) .rt .flapper,
  :global([data-step='3']) .rt .flapper,
  :global([data-step='4']) .rt .flapper {
    transform: rotate(0deg);
  }

  :global([data-step='2']) .rt .chain,
  :global([data-step='3']) .rt .chain,
  :global([data-step='4']) .rt .chain {
    d: path('M300 150 C 350 268, 430 350, 560 396');
    stroke: var(--brand-deep);
  }

  :global([data-step='2']) .rt .spill {
    opacity: 1;
  }

  /* 3 — drop the float; the fill stops below the tube */
  :global([data-step='3']) .rt .waterwrap,
  :global([data-step='4']) .rt .waterwrap {
    transform: translateY(208px);
  }

  :global([data-step='3']) .rt .float,
  :global([data-step='4']) .rt .float {
    transform: translateY(224px);
  }

  /* 4 — silence */
  :global([data-step='4']) .rt .done {
    opacity: 1;
    transform: scale(1);
  }
</style>
