---
/*
 * Running toilet — high-fidelity vector.
 *
 * Cutaway of a gravity-flush tank. Only two parts can cause a permanent run —
 * the flapper and the float — so those are the only two ever marked.
 */
---

<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="rt">
  <defs>
    <linearGradient id="rtPorcelain" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#e6e9ec" />
      <stop offset="0.08" stop-color="#ffffff" />
      <stop offset="0.6" stop-color="#f2f4f6" />
      <stop offset="1" stop-color="#d8dce0" />
    </linearGradient>

    <linearGradient id="rtWater" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9adcca" stop-opacity="0.85" />
      <stop offset="1" stop-color="#37a086" stop-opacity="0.55" />
    </linearGradient>

    <linearGradient id="rtRubber" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3c434a" />
      <stop offset="0.5" stop-color="#22282e" />
      <stop offset="1" stop-color="#12161a" />
    </linearGradient>

    <linearGradient id="rtPlastic" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#f3f5f7" />
      <stop offset="0.5" stop-color="#d5dade" />
      <stop offset="1" stop-color="#aeb5bb" />
    </linearGradient>

    <linearGradient id="rtFloat" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffa95c" />
      <stop offset="0.45" stop-color="#ee6c1e" />
      <stop offset="1" stop-color="#a94709" />
    </linearGradient>

    <filter id="rtShadow" x="-30%" y="-30%" width="160%" height="180%">
      <feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#14171c" flood-opacity="0.2" />
    </filter>
    <filter id="rtShadowSm" x="-40%" y="-40%" width="180%" height="200%">
      <feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="#14171c" flood-opacity="0.3" />
    </filter>

    <clipPath id="rtTankClip">
      <rect x="156" y="96" width="488" height="328" />
    </clipPath>
  </defs>

  <!-- tank shell -->
  <g filter="url(#rtShadow)">
    <path class="tank" d="M150 92 H650 V430 H150 Z" />
  </g>
  <path class="tankline" d="M150 92 V430 H650 V92" />
  <g filter="url(#rtShadowSm)">
    <rect class="lid" x="134" y="72" width="532" height="20" rx="6" />
  </g>

  <g clip-path="url(#rtTankClip)">
    <!-- water -->
    <g class="waterwrap">
      <rect class="water" x="156" y="0" width="488" height="424" />
      <path class="waterline" d="M156 0 H644" />
    </g>

    <!-- overflow tube -->
    <rect class="tube" x="470" y="182" width="38" height="242" rx="4" />
    <ellipse class="tubelip" cx="489" cy="182" rx="19" ry="6" />

    <!-- target fill line -->
    <path class="dashed" d="M170 208 H460" />
    <text class="tag" x="172" y="200">fill line — 25 mm below the tube</text>

    <!-- fill valve + float -->
    <rect class="valve" x="222" y="150" width="22" height="274" rx="4" />
    <rect class="valvecap" x="204" y="124" width="58" height="28" rx="9" />
    <path class="refill" d="M262 162 C 334 162, 402 170, 470 192" />
    <g class="float">
      <rect class="floatcup" x="192" y="0" width="82" height="62" rx="12" />
      <path class="floathi" d="M202 10 H264" />
    </g>

    <!-- flush valve seat + flapper -->
    <rect class="seat" x="524" y="414" width="112" height="12" rx="4" />
    <g class="flapper">
      <path
        class="flapbody"
        d="M528 412 C 528 392, 558 384, 580 393 L614 408 C 622 412, 618 422, 608 422 H536 C 530 422, 528 418, 528 412 Z"
      />
    </g>

    <!-- chain + lever -->
    <path class="lever" d="M150 148 H302" />
    <circle class="pivot" cx="150" cy="148" r="10" />
    <path class="chain" d="M302 148 C 342 250, 422 330, 562 394" />

    <!-- water pouring into the overflow tube -->
    <g class="spill">
      <path class="flow" d="M472 192 C 480 202, 484 212, 486 226" />
      <path class="flow d2" d="M506 192 C 498 202, 494 212, 492 226" />
    </g>

    <!-- dye leaking past the flapper -->
    <g class="leak">
      <path class="dyeline" d="M560 420 C 566 438, 572 454, 578 476" />
      <path class="dyeline d2" d="M588 420 C 592 440, 594 456, 596 476" />
    </g>

    <!-- dye drops -->
    <g class="dye">
      <circle cx="360" cy="152" r="9" />
      <circle cx="394" cy="178" r="7" />
      <circle cx="334" cy="190" r="6" />
    </g>
  </g>

  <!-- callouts -->
  <g class="labels">
    <g class="lab lab--flapper">
      <path class="lead" d="M574 404 L676 366" />
      <circle class="leaddot" cx="574" cy="404" r="4.5" />
      <g class="tagbox tagbox--warn">
        <rect x="656" y="340" width="136" height="32" rx="16" />
        <text x="724" y="361">the flapper</text>
      </g>
      <circle class="marker marker--sm" cx="576" cy="406" r="52" />
    </g>
    <g class="lab lab--float">
      <path class="lead" d="M232 190 L108 156" />
      <circle class="leaddot" cx="232" cy="190" r="4.5" />
      <g class="tagbox tagbox--warn">
        <rect x="10" y="130" width="126" height="32" rx="16" />
        <text x="73" y="151">the float</text>
      </g>
      <circle class="marker marker--sm marker--float" cx="232" cy="188" r="54" />
    </g>
  </g>

  <g class="dyetag">
    <g class="tagbox">
      <rect x="238" y="230" width="252" height="32" rx="16" />
      <text x="364" y="251">dye test — wait 20 minutes</text>
    </g>
  </g>

  <g class="done">
    <circle class="tickbg" cx="716" cy="150" r="36" />
    <path class="tick" d="M699 150 l12 13 l22 -26" />
  </g>
</svg>

<style>
  .rt {
    --dur: 0.65s;
    --ease: cubic-bezier(0.65, 0, 0.35, 1);
  }

  .rt .tank {
    fill: url(#rtPorcelain);
  }

  .rt .tankline {
    fill: none;
    stroke: var(--ink);
    stroke-width: 5;
    stroke-linejoin: round;
  }

  .rt .lid {
    fill: url(#rtPorcelain);
    stroke: var(--ink);
    stroke-width: 4;
  }

  .rt .tag {
    font-family: var(--font-mono);
    font-size: 16px;
    fill: var(--ink-3);
  }

  .rt .dashed {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 3;
    stroke-dasharray: 10 9;
  }

  /* ---------- water ---------- */
  .rt .waterwrap {
    transform: translateY(150px);
    transition: transform var(--dur) var(--ease);
  }

  .rt .water {
    fill: url(#rtWater);
  }

  .rt .waterline {
    fill: none;
    stroke: #2f9c80;
    stroke-width: 4;
  }

  /* ---------- parts ---------- */
  .rt .tube {
    fill: url(#rtPlastic);
    stroke: #8f979e;
    stroke-width: 2.5;
  }

  .rt .tubelip {
    fill: #eef1f3;
    stroke: #8f979e;
    stroke-width: 2.5;
  }

  .rt .valve {
    fill: url(#rtPlastic);
    stroke: #8f979e;
    stroke-width: 2;
  }

  .rt .valvecap {
    fill: #2a3038;
  }

  .rt .refill {
    fill: none;
    stroke: #9aa2a9;
    stroke-width: 5;
    stroke-linecap: round;
  }

  .rt .float {
    transform: translateY(176px);
    transition: transform var(--dur) var(--ease);
  }

  .rt .floatcup {
    fill: url(#rtFloat);
  }

  .rt .floathi {
    stroke: #fff;
    stroke-width: 3;
    opacity: 0.45;
    fill: none;
    stroke-linecap: round;
  }

  .rt .seat {
    fill: #b9c0c6;
  }

  .rt .flapper {
    transform-box: fill-box;
    transform-origin: 100% 100%;
    transform: rotate(-14deg);
    transition: transform var(--dur) var(--ease);
  }

  .rt .flapbody {
    fill: url(#rtRubber);
  }

  .rt .lever {
    fill: none;
    stroke: #9aa2a9;
    stroke-width: 7;
    stroke-linecap: round;
  }

  .rt .pivot {
    fill: #eef1f3;
    stroke: var(--ink);
    stroke-width: 4;
  }

  .rt .chain {
    fill: none;
    stroke: #7f878e;
    stroke-width: 4;
    stroke-dasharray: 3 7;
    stroke-linecap: round;
    transition: d var(--dur) var(--ease), stroke var(--dur) var(--ease);
  }

  /* ---------- flows ---------- */
  .rt .flow,
  .rt .dyeline {
    fill: none;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 12 12;
    animation: rt-flow 0.8s linear infinite;
  }

  .rt .flow {
    stroke: #2f9c80;
  }

  .rt .dyeline {
    stroke: var(--accent);
  }

  .rt .d2 {
    animation-delay: -0.4s;
    opacity: 0.7;
  }

  @keyframes rt-flow {
    to {
      stroke-dashoffset: -24;
    }
  }

  .rt .spill,
  .rt .leak,
  .rt .dye {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .rt .dye circle {
    fill: var(--accent);
    animation: rt-drop 1.6s ease-in-out infinite;
  }

  .rt .dye circle:nth-child(2) {
    animation-delay: -0.5s;
  }
  .rt .dye circle:nth-child(3) {
    animation-delay: -1s;
  }

  @keyframes rt-drop {
    0% {
      transform: translateY(-26px);
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    100% {
      transform: translateY(60px);
      opacity: 0;
    }
  }

  /* ---------- callouts ---------- */
  .rt .marker {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4;
    stroke-dasharray: 10 9;
    animation: rt-spin 16s linear infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .rt .marker--sm {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  @keyframes rt-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .rt .tagbox rect {
    fill: var(--ink);
  }

  .rt .tagbox text {
    fill: #fff;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    text-anchor: middle;
  }

  .rt .tagbox--warn rect {
    fill: var(--accent-deep);
  }

  .rt .lead {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .rt .leaddot {
    fill: var(--ink);
  }

  .rt .labels,
  .rt .lab,
  .rt .dyetag {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .rt .done {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.6);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .rt .tickbg {
    fill: var(--brand);
  }

  .rt .tick {
    fill: none;
    stroke: #fff;
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ======================================================================
     Step states
     ====================================================================== */

  /* 0 — water above the tube: it is pouring away continuously */
  :global([data-step='0']) .rt .spill {
    opacity: 1;
  }

  /* 1 — dye test: colour reaching the bowl means the flapper leaks */
  :global([data-step='1']) .rt .dye,
  :global([data-step='1']) .rt .leak,
  :global([data-step='1']) .rt .spill,
  :global([data-step='1']) .rt .dyetag {
    opacity: 1;
  }

  :global([data-step='1']) .rt .labels,
  :global([data-step='1']) .rt .lab--flapper {
    opacity: 1;
  }

  :global([data-step='1']) .rt .marker--sm {
    opacity: 1;
  }

  :global([data-step='1']) .rt .lab--float,
  :global([data-step='1']) .rt .marker--float {
    opacity: 0;
  }

  /* 2 — free the chain, reseat the flapper */
  :global([data-step='2']) .rt .flapper,
  :global([data-step='3']) .rt .flapper,
  :global([data-step='4']) .rt .flapper {
    transform: rotate(0deg);
  }

  :global([data-step='2']) .rt .chain,
  :global([data-step='3']) .rt .chain,
  :global([data-step='4']) .rt .chain {
    d: path('M302 148 C 352 268, 432 348, 562 394');
    stroke: var(--brand-deep);
  }

  :global([data-step='2']) .rt .spill {
    opacity: 1;
  }

  :global([data-step='2']) .rt .labels,
  :global([data-step='2']) .rt .lab--flapper {
    opacity: 1;
  }

  /* 3 — drop the float so the fill stops below the tube */
  :global([data-step='3']) .rt .waterwrap,
  :global([data-step='4']) .rt .waterwrap {
    transform: translateY(208px);
  }

  :global([data-step='3']) .rt .float,
  :global([data-step='4']) .rt .float {
    transform: translateY(226px);
  }

  :global([data-step='3']) .rt .labels,
  :global([data-step='3']) .rt .lab--float {
    opacity: 1;
  }

  :global([data-step='3']) .rt .marker--float {
    opacity: 1;
  }

  /* 4 — silence */
  :global([data-step='4']) .rt .done {
    opacity: 1;
    transform: scale(1);
  }
</style>
