---
/*
 * Dripping tap — high-fidelity vector.
 *
 * Whole tap on the left for orientation, magnified cut-through of the head on
 * the right. The washer and the seat are the only two parts that matter, so
 * they are the only two things ever marked.
 */
---

<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="tw">
  <defs>
    <linearGradient id="twChrome" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7d858f" />
      <stop offset="0.18" stop-color="#eef1f4" />
      <stop offset="0.42" stop-color="#b7bfc7" />
      <stop offset="0.68" stop-color="#8b939c" />
      <stop offset="0.86" stop-color="#dde2e7" />
      <stop offset="1" stop-color="#6d747d" />
    </linearGradient>

    <linearGradient id="twChromeV" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e7ebef" />
      <stop offset="0.35" stop-color="#aab2bb" />
      <stop offset="0.7" stop-color="#828a94" />
      <stop offset="1" stop-color="#c9d0d7" />
    </linearGradient>

    <linearGradient id="twBrass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e8cf8f" />
      <stop offset="0.4" stop-color="#c2a04f" />
      <stop offset="1" stop-color="#8a6c25" />
    </linearGradient>

    <linearGradient id="twRubberOld" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5c534b" />
      <stop offset="1" stop-color="#2f2a25" />
    </linearGradient>

    <linearGradient id="twRubberNew" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3a4148" />
      <stop offset="0.5" stop-color="#22282e" />
      <stop offset="1" stop-color="#13171b" />
    </linearGradient>

    <linearGradient id="twPorcelain" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#e3e6e9" />
    </linearGradient>

    <filter id="twShadow" x="-30%" y="-30%" width="160%" height="180%">
      <feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#14171c" flood-opacity="0.2" />
    </filter>
    <filter id="twShadowSm" x="-40%" y="-40%" width="180%" height="200%">
      <feDropShadow dx="0" dy="3" stdDeviation="3.5" flood-color="#14171c" flood-opacity="0.28" />
    </filter>

    <clipPath id="twLensClip">
      <rect x="300" y="96" width="472" height="316" rx="16" />
    </clipPath>
  </defs>

  <!-- ============ left: the tap on a basin ============ -->
  <g class="scene">
    <path class="basin" d="M40 372 H236 C 232 424, 196 452, 138 452 C 80 452, 44 424, 40 372 Z" />
    <path class="counter" d="M28 372 H248" />
    <g filter="url(#twShadow)">
      <rect class="tapbase" x="104" y="286" width="64" height="86" rx="8" />
      <path class="tapspout" d="M136 300 V236 C 136 214, 158 202, 178 214 L196 226" />
      <rect class="taphandle" x="112" y="196" width="48" height="26" rx="8" />
      <rect class="tapstem" x="128" y="214" width="16" height="30" />
    </g>
    <circle class="marker" cx="196" cy="252" r="30" />
    <g class="drip">
      <circle cx="196" cy="266" r="7" />
      <circle cx="196" cy="266" r="6" />
    </g>
  </g>

  <!-- magnifier cone -->
  <path class="cone" d="M172 200 L300 100 L300 408 L172 300 Z" />

  <!-- ============ right: cut-through of the tap head ============ -->
  <g filter="url(#twShadow)">
    <rect class="lens" x="300" y="96" width="472" height="316" rx="16" />
  </g>
  <text class="lenstag" x="316" y="122">tap head, cut through</text>

  <g clip-path="url(#twLensClip)">
    <!-- tap body walls -->
    <path class="bodywall" d="M418 150 V330 H470 V150 Z" />
    <path class="bodywall" d="M640 150 V330 H588 V150 Z" />

    <!-- inlet: water arrives from below and can only leave past the seat -->
    <path class="inletfill" d="M470 330 H588 V392 H470 Z" />

    <!-- the seat: a brass ring the washer presses onto -->
    <g class="seatgroup">
      <path class="seat" d="M470 318 H508 V332 H470 Z" />
      <path class="seat" d="M550 318 H588 V332 H470" />
      <path class="seat" d="M550 318 H588 V332 H550 Z" />
      <g class="scoring">
        <path d="M486 318 l6 -8" /><path d="M496 318 l6 -8" />
        <path d="M558 318 l6 -8" /><path d="M568 318 l6 -8" />
      </g>
    </g>

    <!-- the moving assembly: spindle + jumper + washer -->
    <g class="spindleset">
      <rect class="headnut" x="432" y="182" width="194" height="34" rx="5" />
      <rect class="spindle" x="510" y="216" width="38" height="72" rx="4" />
      <rect class="jumper" x="486" y="288" width="86" height="18" rx="4" />
      <rect class="washer washer--old" x="490" y="304" width="78" height="14" rx="3" />
      <rect class="washer washer--new" x="490" y="304" width="78" height="14" rx="3" />
      <path class="washercrack" d="M512 306 l10 12 M540 306 l-8 12" />
    </g>

    <!-- water squeezing past a worn washer -->
    <g class="leak">
      <path class="leakline" d="M528 330 V392" />
    </g>

    <!-- clean shut-off -->
    <g class="sealed">
      <path class="sealline" d="M488 312 H570" />
    </g>
  </g>

  <!-- ---------- markers and labels ---------- -->
  <g class="labels">
    <g class="lab lab--washer">
      <path class="lead" d="M528 300 L664 258" />
      <circle class="leaddot" cx="528" cy="300" r="4.5" />
      <g class="tagbox tagbox--warn">
        <rect x="606" y="232" width="150" height="32" rx="16" />
        <text x="681" y="253">the washer</text>
      </g>
      <circle class="marker marker--sm" cx="528" cy="306" r="54" />
    </g>
    <g class="lab lab--seat">
      <path class="lead" d="M492 326 L392 366" />
      <circle class="leaddot" cx="492" cy="326" r="4.5" />
      <g class="tagbox">
        <rect x="316" y="348" width="150" height="32" rx="16" />
        <text x="391" y="369">the seat</text>
      </g>
      <circle class="marker marker--sm marker--seat" cx="500" cy="324" r="42" />
    </g>
  </g>

  <g class="watertag">
    <g class="tagbox tagbox--bad">
      <rect x="596" y="348" width="168" height="32" rx="16" />
      <text x="680" y="369">water off first</text>
    </g>
  </g>

  <g class="done">
    <circle class="tickbg" cx="138" cy="120" r="36" />
    <path class="tick" d="M121 120 l12 13 l22 -26" />
  </g>
</svg>

<style>
  .tw {
    --dur: 0.6s;
    --ease: cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* ---------- left scene ---------- */
  .tw .basin {
    fill: url(#twPorcelain);
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linejoin: round;
  }

  .tw .counter {
    fill: none;
    stroke: var(--ink);
    stroke-width: 6;
    stroke-linecap: round;
  }

  .tw .tapbase,
  .tw .tapstem {
    fill: url(#twChrome);
  }

  .tw .taphandle {
    fill: url(#twChromeV);
    stroke: #6d747d;
    stroke-width: 2;
  }

  .tw .tapspout {
    fill: none;
    stroke: url(#twChrome);
    stroke-width: 26;
    stroke-linecap: round;
  }

  .tw .marker {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4;
    stroke-dasharray: 10 9;
    animation: tw-spin 16s linear infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .tw .marker--sm {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .tw .marker--seat {
    stroke: var(--danger);
  }

  @keyframes tw-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .tw .drip circle {
    fill: color-mix(in srgb, var(--brand) 55%, #7fd7c0);
    animation: tw-drip 2s ease-in infinite;
  }

  .tw .drip circle:nth-child(2) {
    animation-delay: -1s;
  }

  @keyframes tw-drip {
    0% {
      transform: translateY(0) scale(0.6);
      opacity: 0;
    }
    18% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    100% {
      transform: translateY(120px) scale(0.85);
      opacity: 0;
    }
  }

  .tw .drip {
    opacity: 1;
    transition: opacity var(--dur) var(--ease);
  }

  .tw .cone {
    fill: color-mix(in srgb, var(--ink) 6%, transparent);
    stroke: color-mix(in srgb, var(--ink) 16%, transparent);
    stroke-width: 2;
  }

  /* ---------- lens ---------- */
  .tw .lens {
    fill: #f7f5f1;
    stroke: color-mix(in srgb, var(--ink) 22%, transparent);
    stroke-width: 3;
  }

  .tw .lenstag {
    font-family: var(--font-mono);
    font-size: 16px;
    fill: var(--ink-3);
  }

  .tw .bodywall {
    fill: url(#twChromeV);
    stroke: #6d747d;
    stroke-width: 2.5;
  }

  .tw .inletfill {
    fill: color-mix(in srgb, var(--brand) 20%, transparent);
  }

  .tw .seat {
    fill: url(#twBrass);
    stroke: #7a5f1f;
    stroke-width: 2;
  }

  .tw .scoring path {
    fill: none;
    stroke: var(--danger);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  /* ---------- spindle assembly ---------- */
  .tw .spindleset {
    transition: transform 0.9s var(--ease);
  }

  .tw .headnut {
    fill: url(#twChrome);
    stroke: #6d747d;
    stroke-width: 2;
  }

  .tw .spindle {
    fill: url(#twBrass);
    stroke: #7a5f1f;
    stroke-width: 2;
  }

  .tw .jumper {
    fill: url(#twBrass);
    stroke: #7a5f1f;
    stroke-width: 2;
  }

  .tw .washer--old {
    fill: url(#twRubberOld);
  }

  .tw .washer--new {
    fill: url(#twRubberNew);
    opacity: 0;
  }

  .tw .washer {
    transition: opacity var(--dur) var(--ease);
  }

  .tw .washercrack {
    fill: none;
    stroke: var(--danger);
    stroke-width: 3;
    stroke-linecap: round;
    transition: opacity var(--dur) var(--ease);
  }

  /* ---------- water ---------- */
  .tw .leak {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .tw .leakline {
    fill: none;
    stroke: color-mix(in srgb, var(--brand) 70%, #6fd0b8);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 12 12;
    animation: tw-flow 0.8s linear infinite;
  }

  @keyframes tw-flow {
    to {
      stroke-dashoffset: -24;
    }
  }

  .tw .sealed {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .tw .sealline {
    fill: none;
    stroke: var(--brand);
    stroke-width: 6;
    stroke-linecap: round;
  }

  /* ---------- labels ---------- */
  .tw .tagbox rect {
    fill: var(--ink);
  }

  .tw .tagbox text {
    fill: #fff;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    text-anchor: middle;
  }

  .tw .tagbox--warn rect {
    fill: var(--accent-deep);
  }
  .tw .tagbox--bad rect {
    fill: var(--danger);
  }
  .tw .tagbox--ok rect {
    fill: var(--brand);
  }

  .tw .lead {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .tw .leaddot {
    fill: var(--ink);
  }

  .tw .lab,
  .tw .labels,
  .tw .watertag {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .tw .done {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.6);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .tw .tickbg {
    fill: var(--brand);
  }

  .tw .tick {
    fill: none;
    stroke: #fff;
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ======================================================================
     Step states
     ====================================================================== */

  /* 0 — it drips with the tap closed, so the seal is the problem */
  :global([data-step='0']) .tw .leak {
    opacity: 1;
  }

  :global([data-step='0']) .tw .labels,
  :global([data-step='0']) .tw .lab--washer {
    opacity: 1;
  }

  :global([data-step='0']) .tw .marker--sm {
    opacity: 1;
  }

  :global([data-step='0']) .tw .lab--seat {
    opacity: 0;
  }

  /* 1 — water off at the isolation valve, plug in the basin */
  :global([data-step='1']) .tw .watertag {
    opacity: 1;
  }

  :global([data-step='1']) .tw .drip {
    opacity: 0;
  }

  /* 2 — lift the head assembly out */
  :global([data-step='2']) .tw .drip {
    opacity: 0;
  }

  :global([data-step='2']) .tw .spindleset {
    transform: translateY(-176px);
  }

  :global([data-step='2']) .tw .labels,
  :global([data-step='2']) .tw .lab--washer {
    opacity: 1;
  }

  :global([data-step='2']) .tw .marker--sm {
    opacity: 1;
  }

  :global([data-step='2']) .tw .lab--seat {
    opacity: 0;
  }

  /* 3 — new washer on, and check the seat while you are in there */
  :global([data-step='3']) .tw .drip {
    opacity: 0;
  }

  :global([data-step='3']) .tw .spindleset {
    transform: translateY(-176px);
  }

  :global([data-step='3']) .tw .washer--old {
    opacity: 0;
  }

  :global([data-step='3']) .tw .washer--new {
    opacity: 1;
  }

  :global([data-step='3']) .tw .washercrack {
    opacity: 0;
  }

  :global([data-step='3']) .tw .scoring path {
    opacity: 1;
  }

  :global([data-step='3']) .tw .labels,
  :global([data-step='3']) .tw .lab--seat {
    opacity: 1;
  }

  :global([data-step='3']) .tw .marker--seat {
    opacity: 1;
  }

  /* 4 — back together, seal is clean, no drip */
  :global([data-step='4']) .tw .washer--old,
  :global([data-step='4']) .tw .washercrack {
    opacity: 0;
  }

  :global([data-step='4']) .tw .washer--new {
    opacity: 1;
  }

  :global([data-step='4']) .tw .sealed {
    opacity: 1;
  }

  :global([data-step='4']) .tw .drip {
    opacity: 0;
  }

  :global([data-step='4']) .tw .done {
    opacity: 1;
    transform: scale(1);
  }
</style>
