---
/**
 * IconLibrary — the full set of TFN walkthrough illustrations, rendered
 * once, hidden, and keyed with data-icon. Walkthrough.astro's inline script
 * clones nodes out of this library by key instead of building SVG markup
 * as strings in JS, so every illustration is real markup authored as its
 * own Astro partial in src/animations/tfn/.
 */
import IconPassportAu from './IconPassportAu.astro';
import IconPassportOther from './IconPassportOther.astro';
import IconVisa from './IconVisa.astro';
import IconNoVisa from './IconNoVisa.astro';
import IconInAu from './IconInAu.astro';
import IconOutAu from './IconOutAu.astro';
import IconLicence from './IconLicence.astro';
import IconMedicare from './IconMedicare.astro';
import IconCert from './IconCert.astro';
import IconNothing from './IconNothing.astro';
import IconPost from './IconPost.astro';
import IconCounter from './IconCounter.astro';
import IconClock from './IconClock.astro';
import IconLetter from './IconLetter.astro';
import IconPhone from './IconPhone.astro';
import IconLaptop from './IconLaptop.astro';
import IconDot from './IconDot.astro';
import IconBolt from './IconBolt.astro';

const icons: Record<string, any> = {
  passportAu: IconPassportAu,
  passportOther: IconPassportOther,
  visa: IconVisa,
  noVisa: IconNoVisa,
  inAu: IconInAu,
  outAu: IconOutAu,
  licence: IconLicence,
  medicare: IconMedicare,
  cert: IconCert,
  nothing: IconNothing,
  post: IconPost,
  counter: IconCounter,
  clock: IconClock,
  letter: IconLetter,
  phone: IconPhone,
  laptop: IconLaptop,
  dot: IconDot,
  bolt: IconBolt,
};
---

<div data-icon-library hidden>
  {
    Object.entries(icons).map(([key, Icon]) => (
      <div data-icon={key}>
        <Icon />
      </div>
    ))
  }
</div>
