---
import { SITE } from '../consts';

interface Props {
  slot?: string;
  layout?: 'in-article' | 'display';
  class?: string;
}

const { slot = '', layout = 'display', class: cls = '' } = Astro.props;
// Keep false until AdSense account approval is confirmed, then switch to true.
const enabled = false;
---
{
  enabled && (
    <aside class:list={['adslot', `adslot--${layout}`, cls]} aria-label="Advertisement">
      <p class="adslot__label">Advertisement</p>
      <ins
        class="adsbygoogle"
        style="display:block;min-height:250px;width:100%;"
        data-ad-client={SITE.adsensePublisherId}
        data-ad-slot={slot || undefined}
        data-ad-format={layout === 'in-article' ? 'fluid' : 'auto'}
        data-full-width-responsive="true"
      />
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </aside>
  )
}
