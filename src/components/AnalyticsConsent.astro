---

<div class="analytics-consent" data-analytics-consent data-copy={JSON.stringify(copy)} data-measurement-id="G-LD0HE7HZ62" lang={language?.lang || 'en-AU'} dir={language?.dir || 'ltr'}>
  <div class="analytics-consent__wrap">
    <section class="analytics-consent__panel" id="analytics-consent-panel" aria-labelledby="analytics-consent-title" aria-describedby="analytics-consent-description">
      <div class="analytics-consent__copy">
        <p class="analytics-consent__eyebrow">{copy.eyebrow}</p>
        <h2 id="analytics-consent-title" tabindex="-1">{copy.title}</h2>
        <p id="analytics-consent-description">{copy.description} <a href="/privacy/">{copy.privacy}</a></p>
      </div>
      <div class="analytics-consent__actions">
        <button type="button" data-analytics-choice="accepted" disabled>{copy.accept}</button>
        <button type="button" data-analytics-choice="essential" disabled>{copy.essentials}</button>
      </div>
      <button class="analytics-consent__close" type="button" data-analytics-close hidden>{copy.close}</button>
      <noscript><p class="analytics-consent__notice">{copy.noScript}</p></noscript>
    </section>
    <div class="analytics-consent__toolbar">
      <button class="analytics-consent__trigger" type="button" data-analytics-open aria-controls="analytics-consent-panel" aria-expanded="true" disabled>{copy.choices}</button>
      <p class="analytics-consent__status" data-analytics-status role="status" aria-live="polite" aria-atomic="true">{copy.off}</p>
    </div>
    <div class="analytics-consent__reload" data-analytics-reload-notice hidden>
      <p>{copy.reloadNotice}</p>
      <button type="button" data-analytics-reload>{copy.reload}</button>
    </div>
  </div>
</div>

<script>
  import {initAnalyticsConsent} from '../scripts/analytics-consent.mjs';
  initAnalyticsConsent();
</script>
