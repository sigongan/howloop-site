---
import logos from '../data/bank-logos.json';
interface Props { id: string }
const {id}=Astro.props;
const logo=logos[id as keyof typeof logos];
---
<span class:list={['hl-bank-logo',{'is-reversed':logo?.dark}]} aria-hidden="true">
  {logo ? <img src={logo.src} alt="" width="64" height="48" loading="lazy" decoding="async" /> : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m3 9 9-6 9 6H3Zm2 3v7m7-7v7m7-7v7M3 22h18" /></svg>}
</span>
