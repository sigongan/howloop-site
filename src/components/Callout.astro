---
interface Props {
  type?: 'tip' | 'warn' | 'stop';
  title?: string;
}
const { type = 'tip', title } = Astro.props;

const defaults = {
  tip: 'Good to know',
  warn: 'Watch out',
  stop: 'Stop and call a pro',
} as const;

const heading = title ?? defaults[type];
---

<aside class:list={['callout', `callout--${type}`]}>
  <p class="callout__title">
    <span class="callout__glyph" aria-hidden="true">
      {type === 'tip' ? '★' : type === 'warn' ? '!' : '✕'}
    </span>
    {heading}
  </p>
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout {
    margin-block: 1.8rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    border-inline-start-width: 4px;
    background: var(--surface);
  }

  .callout--tip {
    border-inline-start-color: var(--brand);
    background: color-mix(in srgb, var(--brand-tint) 45%, var(--surface));
  }

  .callout--warn {
    border-inline-start-color: var(--accent);
    background: color-mix(in srgb, var(--accent-tint) 55%, var(--surface));
  }

  .callout--stop {
    border-inline-start-color: var(--danger);
    background: color-mix(in srgb, var(--danger-tint) 55%, var(--surface));
  }

  .callout__title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    letter-spacing: -0.015em;
  }

  .callout__glyph {
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    flex: none;
    border-radius: 50%;
    font-size: 0.8rem;
    line-height: 1;
    color: #fff;
  }

  .callout--tip .callout__glyph {
    background: var(--brand);
  }
  .callout--warn .callout__glyph {
    background: var(--accent);
  }
  .callout--stop .callout__glyph {
    background: var(--danger);
  }

  .callout__body :global(p) {
    margin: 0;
    color: var(--ink-2);
  }

  .callout__body :global(p + p) {
    margin-block-start: 0.6rem;
  }

  .callout__body :global(ul) {
    margin: 0.5rem 0 0;
    padding-inline-start: 1.2rem;
    color: var(--ink-2);
  }
</style>
