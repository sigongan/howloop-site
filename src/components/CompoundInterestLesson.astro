---
interface Props { context?: 'calculator' | 'guide'; }
const { context = 'guide' } = Astro.props;
const titleId = `compound-lesson-${context}`;
const steps = [
  { time: 'You start', note: '$100', total: '$100', caption: 'The money you put in.', breakdown: 'Your starting savings' },
  { time: 'One year later', note: '$100', total: '$105', caption: 'You earn $5. Keep it in.', breakdown: '$100 + $5 interest', interest: true },
  { time: 'Another year', note: '$105', total: '$110.25', caption: 'Now all $105 earns interest.', breakdown: '$105 + $5.25 interest', interest: true, extra: true },
];
---
<section class="compound-lesson" aria-labelledby={titleId}>
  <header class="compound-lesson-heading">
    <span class="compound-lesson-kicker">A LITTLE MONEY LESSON</span>
    <h2 id={titleId}>Your interest earns interest.</h2>
    <p>Leave the interest with your savings. Next year, both can earn a little more.</p>
  </header>
  <ol class="compound-lesson-steps" role="list">
    {steps.map((step, i) => <li class="compound-lesson-step">
      <h3><span class="compound-lesson-number" aria-hidden="true">0{i + 1}</span>{step.time}</h3>
      <div class="compound-lesson-art" aria-hidden="true">
        <span class="compound-lesson-note">{step.note}</span>
        {step.interest && <span class="compound-lesson-coin">+$5</span>}
        {step.extra && <span class="compound-lesson-coin compound-lesson-quarter">+25¢</span>}
      </div>
      <p class="compound-lesson-total">{step.total}</p>
      <p class="compound-lesson-caption">{step.caption}</p>
      <p class="compound-lesson-breakdown">{step.breakdown}</p>
    </li>)}
  </ol>
  <details class="compound-lesson-reveal">
    <summary>Where did the extra 25¢ come from?<span aria-hidden="true">+</span></summary>
    <div class="compound-lesson-answer">
      <p>Your original <strong>$100 earns $5</strong> again.</p>
      <p>Last year’s <strong>$5 interest earns another 25¢</strong>.</p>
      <p>Interest earning interest. That’s <strong>compound interest</strong>.</p>
    </div>
  </details>
  <p class="compound-lesson-assumptions">AUD · Teaching example: 5% a year, added once a year and left in the account. No extra deposits, withdrawals, fees or tax. This is not a bank offer or a guaranteed return.</p>
  <p class="compound-lesson-next">{context === 'calculator'
    ? <>The calculator above adds interest monthly, so its results will differ from this yearly example. <a href="/learn/how-compound-interest-works/">See more simple examples →</a></>
    : <>Our calculator adds interest monthly. This yearly example keeps the idea simple.</>}
  </p>
</section>
<style>
  .compound-lesson { margin: 28px 0; padding: clamp(20px, 3vw, 32px); border: 1px solid var(--ui-line, #dfe5e9); border-radius: 24px; background: #fff; color: var(--ui-ink, #102329); }
  .compound-lesson * { box-sizing: border-box; }
  .compound-lesson-kicker { display: block; color: #52606d; font-size: .875rem; font-weight: 700; letter-spacing: .08em; margin-bottom: 14px; }
  .compound-lesson-heading h2 { margin: 0; font-size: clamp(1.75rem, 3.2vw, 2.4rem); font-weight: 700; line-height: 1.16; letter-spacing: -.04em; }
  .compound-lesson-heading p { max-width: 48ch; color: #52606d; font-size: 1.125rem; line-height: 1.65; margin: 14px 0 24px; }
  .compound-lesson-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; list-style: none; margin: 0; padding: 0; }
  .compound-lesson-step { min-width: 0; padding: 20px 16px; background: #f5f7f6; border-radius: 18px; display: flex; flex-direction: column; }
  .compound-lesson-step h3 { display: flex; align-items: baseline; gap: 8px; font-size: 1.0625rem; font-weight: 600; line-height: 1.4; letter-spacing: -.02em; margin: 0 0 18px; }
  .compound-lesson-number { color: #62736f; font-size: .875rem; font-variant-numeric: tabular-nums; }
  .compound-lesson-art { position: relative; width: 160px; max-width: 100%; height: 130px; margin: 0 auto 16px; display: grid; place-items: center; }
  .compound-lesson-note { display: grid; place-items: center; width: 110px; height: 76px; border-radius: 11px; background: #dceec9; color: #244536; font-size: 1.75rem; font-weight: 700; transform: rotate(-7deg); box-shadow: 0 5px 0 #bed7a8; }
  .compound-lesson-coin { position: absolute; right: 0; bottom: 3px; width: 53px; height: 53px; display: grid; place-items: center; border-radius: 50%; background: #dce8ff; color: #254878; font-size: 1.125rem; font-weight: 700; box-shadow: 0 4px 0 #bed0ed; }
  .compound-lesson-quarter { width: 44px; height: 44px; right: 0; top: 0; bottom: auto; background: #eadffa; color: #593c7e; box-shadow: 0 4px 0 #d3c2ea; font-size: 1rem; }
  .compound-lesson-total { margin: 0 0 8px; font-size: clamp(1.875rem, 3vw, 2.375rem); font-weight: 700; line-height: 1.2; letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
  .compound-lesson-caption { color: #405653; font-size: 1.0625rem; line-height: 1.5; margin: 0 0 12px; }
  .compound-lesson-breakdown { color: #52606d; font-size: 1rem; line-height: 1.5; margin: auto 0 0; }
  .compound-lesson-reveal { margin-top: 18px; border-radius: 16px; background: #f5f7f6; }
  .compound-lesson-reveal summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 20px; min-height: 58px; border-radius: 16px; background: var(--ui-lime, #dfff82); color: #102329; list-style: none; font-size: 1.125rem; font-weight: 700; line-height: 1.5; cursor: pointer; }
  .compound-lesson-reveal summary::-webkit-details-marker { display: none; }
  .compound-lesson-reveal summary::marker { content: ''; }
  .compound-lesson-reveal summary > span { font-size: 1.5rem; font-weight: 400; flex: none; }
  .compound-lesson-reveal[open] summary > span { transform: rotate(45deg); }
  .compound-lesson-reveal summary:focus-visible, .compound-lesson-next a:focus-visible { outline: 3px solid #102329; outline-offset: 4px; }
  .compound-lesson-answer { padding: 20px; }
  .compound-lesson-answer p { font-size: 1.125rem; line-height: 1.65; margin: 0; }
  .compound-lesson-answer p + p { margin-top: 10px; }
  .compound-lesson-assumptions, .compound-lesson-next { color: #52606d; font-size: 1rem; line-height: 1.65; margin: 18px 0 0; }
  .compound-lesson-next a { color: #244536; text-decoration: underline; text-underline-offset: .2em; font-weight: 600; }
  @media (max-width: 700px) {
    .compound-lesson-steps { grid-template-columns: 1fr; gap: 12px; }
    .compound-lesson-step { display: grid; grid-template-columns: 116px minmax(0, 1fr); gap: 0 20px; padding: 20px; }
    .compound-lesson-step h3 { grid-column: 1 / -1; margin-bottom: 14px; }
    .compound-lesson-art { grid-column: 1; grid-row: 2 / 5; height: 116px; margin: 0; align-self: center; }
    .compound-lesson-note { width: 92px; height: 65px; font-size: 1.5rem; }
    .compound-lesson-coin { width: 44px; height: 44px; right: -2px; font-size: 1rem; }
    .compound-lesson-quarter { width: 38px; height: 38px; font-size: .875rem; }
    .compound-lesson-total { margin: 0 0 5px; align-self: end; }
    .compound-lesson-caption { margin: 0 0 8px; }
    .compound-lesson-breakdown { margin: 0; }
  }
  @media (max-width: 400px) {
    .compound-lesson { padding: 18px 14px; border-radius: 20px; }
    .compound-lesson-step { padding: 16px 12px; grid-template-columns: 86px minmax(0, 1fr); column-gap: 14px; }
    .compound-lesson-note { width: 74px; height: 58px; font-size: 1.25rem; }
    .compound-lesson-total { font-size: 1.75rem; }
    .compound-lesson-reveal summary { padding: 16px; }
  }
</style>
