---
import Logo from './Logo.astro';
import { SITE } from '../consts';
---
<footer class="hl-footer">
  <div class="hl-wrap">
    <div class="hl-footer-grid">
      <div class="hl-footer-brand">
        <a href="/" aria-label="Howloop home"><Logo size={32} /></a>
        <p style="margin-top:12px;font-size:0.9rem;color:#94A3B8;max-width:34ch;">
          Free Australian financial calculators, public CDR bank snapshots, and plain-English money guides.
        </p>
        <p style="margin-top:8px;font-size:0.825rem;color:#5EEAD4;">Contact: {SITE.email}</p>
      </div>
      <div>
        <h2>Financial Tools</h2>
        <a href="/tools/cash-flow/">13-Week Payday &amp; Bills Planner</a>
        <a href="/calculators/salary/">Take-Home Pay Calculator</a>
        <a href="/calculators/compound-interest/">Compound Interest Calculator</a>
        <a href="/tools/">All Financial Tools Directory</a>
      </div>
      <div>
        <h2>Guides &amp; Data</h2>
        <a href="/start/">Start Here Roadmap</a>
        <a href="/banks/">CDR Bank Rate Explorer</a>
        <a href="/learn/">Learn About Money</a>
        <a href="/guides/">Practical Guides Archive</a>
        <a href="/updates/">Data &amp; Policy Updates</a>
      </div>
      <div>
        <h2>Trust &amp; Policies</h2>
        <a href="/about/">About Howloop</a>
        <a href="/methodology/">Calculation Methodology</a>
        <a href="/editorial-policy/">Editorial Policy</a>
        <a href="/privacy/">Privacy &amp; Cookie Policy</a>
        <a href="/terms/">Terms of Use</a>
        <a href="/contact/">Contact &amp; Corrections</a>
      </div>
    </div>
    <div class="hl-footer-bottom">
      <span>© {new Date().getFullYear()} {SITE.name} ({SITE.domain}). All rights reserved.</span>
      <p>General Information Only: Educational modelling tools and factual data, not personal financial or tax advice.</p>
    </div>
  </div>
</footer>
