---
import Logo from './Logo.astro';
import { languageForPath } from '../lib/languages.mjs';
import { SITE } from '../consts';

const language = languageForPath(Astro.url.pathname);
---
<footer class:list={['hl-footer', language && 'language-footer']}>
  <div class="hl-wrap">
    <div class="hl-footer-grid">
      <div class="hl-footer-brand">
        <a class="hl-brand" href="/" lang="en" aria-label="Howloop home"><Logo size={32} /></a>
        <p >
          Free Australian financial calculators, public CDR bank snapshots, and plain-English money guides.
        </p>
        <p ><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
      <div>
        <h2>Tools</h2>
        <a href="/tools/cash-flow/">Payday &amp; bills planner</a>
        <a href="/calculators/salary/">Take-home pay calculator</a>
        <a href="/calculators/compound-interest/">Compound interest calculator</a>
        <a href="/tools/">Tool directory</a>
      </div>
      <div>
        <h2>Howloop</h2>
        <a href="/start/">Start here</a>
        <a href="/banks/">Bank explorer</a>
        <a href="/learn/">Learn about money</a>
        <a href="/about/">About Howloop</a>
        <a href="/contact/">Contact &amp; feedback</a>
      </div>
      <div>
        <h2>The details</h2>
        <a href="/methodology/">How we calculate</a>
        <a href="/editorial-policy/">Editorial policy</a>
        <a href="/privacy/">Privacy policy</a>
        <a href="/privacy/#analytics-choices">Analytics choices</a>
        <a href="/terms/">Terms of use</a>
      </div>
    </div>
    <div class="hl-footer-bottom">
      <span>© {new Date().getFullYear()} Howloop</span>
      <p>Educational tools, not personal financial advice.</p>
    </div>
  </div>
</footer>
