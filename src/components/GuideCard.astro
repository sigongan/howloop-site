---
import { TOPICS } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  guide: CollectionEntry<'guides'>;
  size?: 'default' | 'large';
  headingLevel?: 'h2' | 'h3';
}

const { guide, size = 'default', headingLevel: Heading = 'h3' } = Astro.props;
const { data, id } = guide;
const topic = TOPICS[data.topic];
---

<article class:list={['card', size === 'large' && 'card--large']}>
  <div class="card__meta">
    <a class="chip chip--brand" href={`/topics/${topic.id}`}>{topic.label}</a>
    <span class="chip">{data.timeNeeded}</span>
    <span class="chip">{data.difficulty}</span>
  </div>

  <Heading class="card__title">
    <a href={`/guides/${id}`}>{data.cardTitle ?? data.title}</a>
  </Heading>

  <p class="card__desc">{data.description}</p>

  <p class="card__steps">
    <span class="card__stepcount">{data.steps.length}</span>
    animated steps
  </p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.4rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: transform 0.16s ease, box-shadow 0.16s ease,
      border-color 0.16s ease;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--brand-tint-2);
  }

 .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    min-width: 0;
  }
  .card__meta :global(.chip) {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card__title {
    font-size: var(--step-1);
    letter-spacing: -0.025em;
  }

  .card--large .card__title {
    font-size: var(--step-2);
  }

  .card__title a {
    color: var(--ink);
    text-decoration: none;
  }

  /* whole-card click target without nesting interactive elements */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

.card {
    position: relative;
    min-width: 0;
  }

  .card__title a:hover {
    color: var(--brand-deep);
  }

  .card__desc {
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.6;
    margin: 0;
  }

  .card__steps {
    margin: auto 0 0;
    padding-block-start: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-3);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .card__stepcount {
    display: grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding-inline: 0.35rem;
    border-radius: 999px;
    background: var(--accent-tint);
    color: var(--accent-deep);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
  }
</style>
