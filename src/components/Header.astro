---
import Logo from './Logo.astro';
import ToolIcon from './ToolIcon.astro';
const path=Astro.url.pathname.replace(/\/+$/,'')||'/';
import { NAV } from '../consts';
const current=(item:typeof NAV[number])=>item.matches.some(route=>path===route||path.startsWith(route+'/'))?(path===item.href.replace(/\/$/,'')?'page':'location'):undefined;
---
<header class="hl-header"><div class="hl-wrap hl-nav">
<a class="hl-brand" href="/" aria-label="Howloop home"><Logo /></a>
<nav class="hl-desktop-nav" aria-label="Main navigation">{NAV.map(item=><a href={item.href} data-money-area={item.id} aria-current={current(item)}><ToolIcon name={item.icon}/><span>{item.label}</span></a>)}<a class="hl-all-tools" href="/calculators/" aria-current={path==='/calculators'?'page':undefined}>All tools <ToolIcon name="arrow"/></a></nav>

<details class="hl-mobile-menu"><summary aria-label="Navigation menu">Menu <svg class="menu-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg><svg class="menu-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></summary><nav aria-label="Mobile navigation">{NAV.map(item=><a href={item.href} data-money-area={item.id} aria-current={current(item)}><span class="money-area-icon"><ToolIcon name={item.icon}/></span><span class="hl-menu-copy"><strong>{item.label}</strong><small>{item.hint}</small></span><span aria-hidden="true">→</span></a>)}<div class="hl-menu-utilities"><a href="/calculators/">All calculators →</a><a href="/banks/">All bank rates →</a></div></nav></details>
</div></header>
<script>
const menu=document.querySelector<HTMLDetailsElement>('.hl-mobile-menu');
if(menu){
 document.addEventListener('keydown',event=>{if(event.key==='Escape'&&menu.open){menu.open=false;menu.querySelector('summary')?.focus();}});
 document.addEventListener('pointerdown',event=>{if(menu.open&&!menu.contains(event.target as Node))menu.open=false;});
 menu.addEventListener('focusout',event=>{if(menu.open&&!menu.contains(event.relatedTarget as Node|null))menu.open=false;});
 menu.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{menu.open=false;}));
}
</script>
