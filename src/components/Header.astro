---
import Logo from './Logo.astro';
import ToolIcon from './ToolIcon.astro';
const path=Astro.url.pathname.replace(/\/+$/,'')||'/';
import { NAV } from '../consts';
const current=(item:typeof NAV[number])=>item.matches.some(route=>path===route||path.startsWith(route+'/'))?(path===item.href.replace(/\/$/,'')?'page':'location'):undefined;
---
<header class="hl-header"><div class="hl-wrap hl-nav">
<a class="hl-brand" href="/" aria-label="Howloop home"><Logo /></a>
<nav class="hl-desktop-nav" aria-label="Main navigation">{NAV.map(item=><a href={item.href} data-money-area={item.id} aria-current={current(item)}><ToolIcon name={item.icon}/><span>{item.label}</span></a>)}<a class="hl-all-tools" href="/calculators/" aria-current={path==='/calculators'?'page':undefined}>All tools</a></nav>

<details class="hl-mobile-menu"><summary aria-label="Open navigation">Menu <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></summary><nav aria-label="Mobile navigation">{NAV.map(item=><a href={item.href} data-money-area={item.id} aria-current={current(item)}><span class="money-area-icon"><ToolIcon name={item.icon}/></span><span class="hl-menu-copy"><strong>{item.label}</strong><small>{item.hint}</small></span><span aria-hidden="true">→</span></a>)}<div class="hl-menu-utilities"><a href="/calculators/">All calculators →</a><a href="/banks/">All bank rates →</a></div></nav></details>
</div></header>
