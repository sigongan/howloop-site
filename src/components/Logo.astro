---
interface Props {
  size?: number;
  showWordmark?: boolean;
  class?: string;
}
const { size = 30, showWordmark = true, class: cls = '' } = Astro.props;
---

<span class:list={['logo', cls]} style={`--mark: ${size}px`}>
  <svg
    class="logo__mark"
    viewBox="0 0 40 40"
    aria-hidden="true"
    focusable="false"
  >
    <!-- the loop -->
    <path
      class="logo__ring"
      d="M20 4a16 16 0 1 1-13.4 7.3"
      fill="none"
      stroke="currentColor"
      stroke-width="4.2"
      stroke-linecap="round"
    ></path>
    <!-- the arrowhead that closes the loop -->
    <path
      class="logo__tip"
      d="M4.2 3.4 L8.4 12.6 L17.4 8.2"
      fill="none"
      stroke="currentColor"
      stroke-width="4.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <!-- play -->
    <path class="logo__play" d="M16.6 13.4 L28 20 L16.6 26.6 Z" fill="currentColor"></path>
  </svg>
  {
    showWordmark && (
      <span class="logo__word">
        how<span class="logo__word-accent">loop</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
    line-height: 1;
  }

  .logo__mark {
    width: var(--mark);
    height: var(--mark);
    flex: none;
    color: var(--brand);
  }

  .logo__play {
    color: var(--accent);
    fill: var(--accent);
  }

  .logo__word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(var(--mark) * 0.72);
    letter-spacing: -0.035em;
  }

  .logo__word-accent {
    color: var(--brand-deep);
  }

  /* A gentle nudge on hover — the mark is a loop, so it loops. */
  a:hover .logo__ring,
  a:hover .logo__tip {
    animation: logo-spin 0.9s cubic-bezier(0.65, 0, 0.35, 1);
    transform-origin: 50% 50%;
  }

  @keyframes logo-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
