---
const {name,label,value,min=0,max=100000000,step=0.01,prefix='$',hint}=Astro.props;
const isMoney = prefix === '$';
---
<label class="hl-field">
  <span>{label}</span>
  <div class="hl-input-wrap">
    {prefix && <span>{prefix}</span>}
    <input name={name} aria-label={label} type={isMoney ? 'text' : 'number'} data-money-input={isMoney ? '' : undefined} data-min={min} data-max={max} inputmode="decimal" value={value} min={min} max={max} step={step} required />
  </div>
  {hint && <small>{hint}</small>}
</label>
