---
import MoneyScene from './MoneyScene.astro';
import '../styles/money-lesson.css';

interface Props {
  topic: 'compound' | 'offset' | 'salary';
  id?: string;
}
const {topic, id = `money-lesson-${Astro.props.topic}`} = Astro.props;
const lessons = {
  compound: {
    title: 'How does interest grow?',
    intro: 'Interest is money the bank pays you for keeping savings in an account.',
    example: 'Made-up example: 10% a year. This is not a bank offer.',
    takeaway: 'Leave the interest in. It can earn interest too. That is compound interest.',
    note: 'The example adds 10% once a year. No deposits, withdrawals, tax or fees. Real savings rates can change. The coins are pictures, not a count of dollars.',
    steps: [
      {title: 'Put $100 in savings.', text: 'You put your money in the account. For this example, leave it there for a year.', label: 'Your money', amount: '$100', detail: 'Start here'},
      {title: 'The bank adds $10.', text: 'At 10%, your $100 earns $10 in one year. Keep that $10 in the account.', label: 'After one year', amount: '$110', detail: '$100 + $10 = $110'},
      {title: 'Next year, you earn $11.', text: 'Your first $100 earns $10. Last year’s $10 earns $1 more. Together, that is $11.', label: 'After two years', amount: '$121', detail: '$110 + $11 = $121'},
    ],
  },
  offset: {
    title: 'How does an offset work?',
    intro: 'An offset is a bank account linked to a home loan. Money in it can reduce the interest you pay.',
    example: 'This example uses a full offset: all $40,000 counts when the bank works out interest.',
    takeaway: 'Your savings stay separate. The bank uses a smaller amount to work out loan interest.',
    note: 'A full offset reduces the balance used to calculate interest. It does not pay off the loan. Your cash stays in the separate offset account. Check fees and loan terms; some accounts only provide a partial offset.',
    steps: [
      {title: 'You owe $600,000.', text: 'This is your home loan: money you still need to pay back.', label: 'Your loan debt', amount: '$600,000', detail: 'Money you owe'},
      {title: 'Keep $40,000 in the offset.', text: 'The bank account is linked to your loan. The $40,000 is still your cash. You have not paid it into the loan.', label: 'Your separate savings', amount: '$40,000', detail: 'Loan debt is still $600,000'},
      {title: 'Pay interest on a smaller amount.', text: 'The bank subtracts the offset savings when it works out interest. You still owe $600,000.', label: 'Amount used for interest', amount: '$560,000', detail: '$600,000 − $40,000 = $560,000'},
    ],
  },
  salary: {
    title: 'What is salary plus super?',
    intro: 'Super is money your employer pays into a fund for your retirement.',
    example: 'A simple explanation. Check the breakdown of your job offer.',
    takeaway: 'Salary is pay before tax. Super goes to your retirement fund, not your everyday bank account.',
    note: 'This shows cash salary and employer super only. Tax and other deductions reduce take-home pay. A real package can contain other benefits. Super is generally kept for retirement and access rules apply.',
    steps: [
      {title: 'Your pay has different parts.', text: 'Salary is pay before tax. After tax and other deductions, the rest goes to your bank account. Super goes to your retirement fund.', label: 'Two places for money', amount: 'Salary + super', detail: 'Salary before tax · Super for retirement'},
      {title: '“Including super” means inside.', text: 'The quoted package already contains salary and super. The whole package is not money paid to your bank account.', label: 'One package contains both', amount: 'Salary + super', detail: 'Both inside the quote'},
      {title: '“Plus super” means added on top.', text: 'The quoted salary is pay before tax. Employer super is extra, and goes to your retirement fund.', label: 'Super is extra', amount: 'Salary, plus super', detail: 'Salary before tax · Super for retirement'},
    ],
  },
};
const lesson = lessons[topic];
if (!lesson) throw new Error('MoneyLesson needs a supported topic.');
---
<section class="money-lesson" data-money-lesson data-topic={topic} id={id} aria-labelledby={`${id}-title`}>
  <header class="money-lesson__header">
    <p class="money-lesson__eyebrow">Money in pictures</p>
    <h2 id={`${id}-title`}>{lesson.title}</h2>
    <p class="money-lesson__intro">{lesson.intro}</p>
    <p class="money-lesson__example">{lesson.example}</p>
  </header>
  <div class="money-lesson__mode" data-lesson-mode hidden>
    <button type="button" data-lesson-start aria-label={`Watch the lesson: ${lesson.title}`} aria-controls={`${id}-steps`}>Watch step by step</button>
    <button type="button" data-lesson-all hidden aria-controls={`${id}-steps`}>Show all steps</button>
  </div>
  <div class="money-lesson__progress" data-lesson-progress hidden>
    <span data-lesson-count>Step 1 of 3</span>
    <div class="money-lesson__tracks" aria-hidden="true">{lesson.steps.map((_, index) => <span data-lesson-track data-step={index}></span>)}</div>
  </div>
  <div class="money-lesson__steps" id={`${id}-steps`}>
    {lesson.steps.map((step, index) => <section class="money-lesson__step" data-lesson-step aria-labelledby={`${id}-step-${index + 1}`}>
      <h3 id={`${id}-step-${index + 1}`}><span class="money-lesson__step-number" aria-label={`Step ${index + 1}`}>{index + 1}</span> {step.title}</h3>
      <figure class={`money-lesson__art money-lesson__art--${topic}`}>
        <MoneyScene topic={topic} step={index}/>
        <figcaption>
          <span class="money-lesson__amount-label">{step.label}</span>
          <strong class="money-lesson__amount">{step.amount}</strong>
          <span class="money-lesson__equation">{step.detail}</span>
          {topic === 'offset' && index === 2 && <span class="money-lesson__debt-reminder">You still owe <strong>$600,000</strong>.</span>}
        </figcaption>
      </figure>
      <p class="money-lesson__copy">{step.text}</p>
    </section>)}
  </div>
  <div class="money-lesson__controls" data-lesson-controls hidden role="group" aria-label={`${lesson.title} Lesson controls`}>
    <button type="button" data-lesson-back aria-label="Previous lesson step" aria-controls={`${id}-steps`}>Back</button>
    <button type="button" data-lesson-play aria-label={`Play the lesson: ${lesson.title}`} aria-controls={`${id}-steps`}>Play</button>
    <button type="button" data-lesson-next aria-label="Next lesson step" aria-controls={`${id}-steps`}>Next</button>
  </div>
  <aside class="money-lesson__takeaway"><strong>Remember this</strong><p>{lesson.takeaway}</p></aside>
  <details class="money-lesson__about"><summary>About this example</summary><p class="money-lesson__note">{lesson.note}</p></details>
  <p class="money-lesson__sr-only" role="status" aria-live="polite" aria-atomic="true" data-lesson-announcement></p>
</section>
<script>import '../scripts/money-lesson.js';</script>
