---
import {randomUUID} from 'node:crypto';

interface Props {
  topic: 'compound' | 'offset' | 'salary';
  step?: 0 | 1 | 2;
  compact?: boolean;
}
const {topic, step = 0, compact = false} = Astro.props;
const prefix = `money-scene-${randomUUID()}`;
const shape = (name: string) => `#${prefix}-${name}`;
---

<svg class:list={['money-scene', {'money-scene--compact': compact}]} viewBox="0 0 480 250" fill="none" stroke="#344f51" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" data-scene-topic={topic} data-scene-step={step}>
  <defs>
    <g id={`${prefix}-coin`}>
      <circle r="22" fill="#f3d795"/>
      <circle r="15.5" stroke="#ad8541" stroke-width="2"/>
      <path d="M-4-7v14M4-7v14" stroke="#ad8541" stroke-width="2.5"/>
    </g>
    <g id={`${prefix}-interest-coin`}>
      <circle r="24" fill="#bfdccf"/>
      <circle r="18" stroke="#4c7b6a" stroke-width="2"/>
      <path d="m0-11 8 11-8 11-8-11Z" fill="#edf7ef" stroke="#4c7b6a" stroke-width="2"/>
    </g>
    <g id={`${prefix}-new-interest-coin`}>
      <circle r="21" fill="#cec6e2"/>
      <path d="m0-12 4 8 8 4-8 4-4 8-4-8-8-4 8-4Z" fill="#f8f5fc" stroke="#76668e" stroke-width="2"/>
    </g>
    <g id={`${prefix}-jar`}>
      <path d="M27 24h66v13l12 10a15 15 0 0 1 5 12v69a17 17 0 0 1-17 17H27a17 17 0 0 1-17-17V59a15 15 0 0 1 5-12l12-10V24Z" fill="#e4f0e9"/>
      <path d="M27 24h66M25 54v31M25 95v12" stroke="#fff" stroke-width="6"/>
      <path d="M26 131h66" stroke="#b5d0c2" stroke-width="3"/>
      <g transform="translate(42 112) scale(.72)"><use href={shape('coin')}/></g>
      <g transform="translate(75 111) scale(.72)"><use href={shape('coin')}/></g>
      <g transform="translate(58 92) scale(.72)"><use href={shape('coin')}/></g>
      <rect x="22" y="12" width="76" height="16" rx="5" fill="#a6c8b9"/>
      <path d="M31 17v5M41 17v5M51 17v5M61 17v5M71 17v5M81 17v5M90 17v5" stroke="#678d7c" stroke-width="2"/>
    </g>
    <g id={`${prefix}-house`}>
      <path d="M16 72h112v92H16Z" fill="#f4e9d6"/>
      <path d="m4 75 68-57 69 57-10 13-63-50-54 50Z" fill="#b6cddd"/>
      <path d="M107 27V9h17v32" fill="#f4e9d6"/>
      <rect x="32" y="95" width="29" height="28" rx="3" fill="#fffdf8"/>
      <path d="M46.5 96v26M33 109h27" stroke="#87a4b6" stroke-width="2"/>
      <path d="M83 164v-59a5 5 0 0 1 5-5h20a5 5 0 0 1 5 5v59" fill="#b8d5c5"/>
      <circle cx="103" cy="132" r="2.5" fill="#344f51" stroke="none"/>
      <path d="M10 164h124"/>
    </g>
    <g id={`${prefix}-loan-paper`}>
      <path d="M0 6a6 6 0 0 1 6-6h73l23 23v132a6 6 0 0 1-6 6H6a6 6 0 0 1-6-6Z" fill="#fffdf8"/>
      <path d="M79 0v23h23" fill="#e3e8e3"/>
      <path d="m21 43 18-15 18 15M26 40v21h26V40M35 61V49h9v12" stroke="#658c7b" stroke-width="2.5"/>
      <path d="M19 79h64M19 95h64M19 111h45" stroke="#8ba1a7" stroke-width="4"/>
      <path d="m60 139 6 5 14-16" stroke="#658c7b" stroke-width="3"/>
      <path d="M18 139h25" stroke="#b4bebf" stroke-width="3"/>
    </g>
    <g id={`${prefix}-envelope`}>
      <rect x="15" y="0" width="97" height="84" rx="7" fill="#fffdf8"/>
      <path d="M33 19h59M33 34h43" stroke="#9aabb0" stroke-width="4"/>
      <path d="M0 46a6 6 0 0 1 6-6h121a6 6 0 0 1 6 6v80a6 6 0 0 1-6 6H6a6 6 0 0 1-6-6Z" fill="#f2ddac"/>
      <path d="m3 44 63 46 64-46M3 127l44-48M130 127 86 79" stroke="#947b51" stroke-width="2.5"/>
    </g>
    <g id={`${prefix}-wallet`}>
      <path d="M5 22V14a8 8 0 0 1 7-8l89-6v25" fill="#95b4c8"/>
      <path d="M25 23V6h58v17" fill="#dfeddf"/>
      <path d="M34 12h38" stroke="#8ba993" stroke-width="2"/>
      <rect x="0" y="20" width="112" height="70" rx="11" fill="#bcd3e1"/>
      <path d="M110 45H86a12 12 0 0 0 0 24h24Z" fill="#e6f0f5"/>
      <circle cx="88" cy="57" r="3" fill="#344f51" stroke="none"/>
      <path d="M12 31h48M13 78h42" stroke="#92b2c5" stroke-width="2"/>
    </g>
    <g id={`${prefix}-retirement-pot`}>
      <path d="M14 33h85l-7 76a13 13 0 0 1-13 12H34a13 13 0 0 1-13-12Z" fill="#d8d0e6"/>
      <rect x="8" y="21" width="97" height="17" rx="6" fill="#b9aecd"/>
      <path d="M37 28h38" stroke="#756784" stroke-width="3"/>
      <path d="M57 2c-10 0-17 8-17 19h35C75 10 68 2 57 2Z" fill="#f3d795"/>
      <circle cx="57" cy="76" r="23" fill="#faf7fc" stroke="#887899" stroke-width="2"/>
      <path d="M57 61v16l10 6" stroke="#887899" stroke-width="3"/>
      <path d="M31 46v15" stroke="#f5effa" stroke-width="5"/>
    </g>
  </defs>

  {!compact && <g stroke="none">
    <path d="M41 181c-24-56 10-123 77-133 47-7 63 23 105 10 71-23 139-22 188 27 34 34 33 88 11 113H61Z" fill="#f2f6f3"/>
    <circle cx="434" cy="42" r="5" fill="#c3d8cc"/><circle cx="41" cy="81" r="4" fill="#d7cfe5"/>
  </g>}
  <ellipse cx="239" cy="228" rx="211" ry="10" fill="#e4ece7" stroke="none"/>
  <path d="M29 220h421" stroke="#a7bbb3" stroke-width="2"/>

  {topic === 'compound' && <g>
    <g transform="translate(101 29) scale(1.29)"><use href={shape('jar')}/></g>
    {step === 0 && <g class="money-scene__action">
      <path d="M296 185h65v16c0 9-65 9-65 0Z" fill="#f0d493"/>
      <ellipse cx="328.5" cy="185" rx="32.5" ry="9" fill="#f8e5b9"/>
      <path d="M297 195c15 8 47 8 63 0" stroke="#b4904f" stroke-width="2"/>
      <g transform="translate(352 158)"><use href={shape('coin')}/></g>
      <path d="M337 116c-18-37-66-54-107-40" stroke="#688f7c" stroke-width="3"/>
      <path d="m239 64-10 13 17 4" stroke="#688f7c" stroke-width="3"/>
    </g>}
    {step === 1 && <g class="money-scene__action">
      <g transform="translate(340 89) scale(1.18)"><use href={shape('interest-coin')}/></g>
      <path d="M304 81c-26-22-59-29-85-12" stroke="#4c7b6a"/>
      <path d="m222 53-5 18 18 1" stroke="#4c7b6a"/>
      <path d="M343 44v-9M383 78l9-3M313 43l-6-7" stroke="#7a9c88" stroke-width="2.5"/>
    </g>}
    {step === 2 && <g>
      <g transform="translate(202 114) scale(.81)"><use href={shape('interest-coin')}/></g>
      <path d="m220 104 77-34" stroke="#79958a" stroke-width="2" stroke-dasharray="4 6"/>
      <g transform="translate(317 65)"><use href={shape('interest-coin')}/></g>
      <path d="M344 64c27 0 44 20 42 38" stroke="#827099"/>
      <path d="m376 95 10 10 10-10" stroke="#827099"/>
      <g class="money-scene__action">
        <g transform="translate(386 137) scale(1.05)"><use href={shape('new-interest-coin')}/></g>
        <path d="M361 151c-39 30-93 24-126 0" stroke="#827099"/>
        <path d="m239 165-7-16 18-2" stroke="#827099"/>
        <path d="M425 128h8M411 107l6-6M413 166l7 5" stroke="#a193b1" stroke-width="2.5"/>
      </g>
    </g>}
  </g>}

  {topic === 'offset' && <g>
    <g transform="translate(25 51) scale(1.01)"><use href={shape('house')}/></g>
    <g transform="translate(190 40)"><use href={shape('loan-paper')}/></g>
    {step === 0 && <g>
      <path d="m339 187 28-86 15 5-28 86-11 13Z" fill="#b9d1c1"/>
      <path d="m339 187 15 5-11 13Z" fill="#f4e6cb"/>
      <path d="m367 101 3-9a6 6 0 0 1 7-4l4 1a6 6 0 0 1 4 8l-3 9Z" fill="#d5c9e2"/>
      <path d="m343 200-1 5" stroke="#344f51"/>
    </g>}
    {step > 0 && <g class:list={{'money-scene__action':step === 1}}>
      <g transform="translate(339 33) scale(.77)"><use href={shape('jar')}/></g>
      <path d="M283 29c20-12 43-11 61 3" stroke="#81a191" stroke-width="2" stroke-dasharray="4 5"/>
      <path d="m307 31 4-4a5 5 0 0 1 7 7l-4 4m-7-6-4 4a5 5 0 0 0 7 7l4-4" stroke="#628d78" stroke-width="2.5"/>
    </g>}
    {step === 1 && <path d="M348 162h79" stroke="#aac3b4" stroke-width="2"/>}
    {step === 2 && <g class="money-scene__action">
      <path d="M293 185h21M305 179l9 6-9 6M385 150v13M379 156l6 7 6-7" stroke="#6486a0" stroke-width="2.5"/>
      <rect x="326" y="168" width="111" height="53" rx="8" fill="#eaf1f7"/>
      <rect x="336" y="177" width="91" height="16" rx="3" fill="#fff" stroke="#93acbf" stroke-width="2"/>
      <path d="M344 185h34" stroke="#7a9bb2" stroke-width="3"/>
      <path d="M339 205h11M344.5 200v10M361 205h11" stroke="#6486a0" stroke-width="2"/>
      <circle cx="394" cy="201" r="3" stroke="#6486a0" stroke-width="2"/>
      <circle cx="408" cy="210" r="3" stroke="#6486a0" stroke-width="2"/>
      <path d="m395 214 11-16" stroke="#6486a0" stroke-width="2"/>
    </g>}
  </g>}

  {topic === 'salary' && <g>
    <g transform="translate(27 86) scale(.93)"><use href={shape('envelope')}/></g>
    {step === 0 && <g class="money-scene__action">
      <path d="M159 135c26-40 38-54 64-54M215 75l9 6-9 7M159 155c41 0 88 42 165 42M316 190l10 7-10 7" stroke="#789b89"/>
      <g transform="translate(233 47) scale(1.06)"><use href={shape('wallet')}/></g>
      <g transform="translate(340 114) scale(.82)"><use href={shape('retirement-pot')}/></g>
      <path d="M374 74h28M391 60v28" stroke="#b5c5ce" stroke-width="2"/>
    </g>}
    {step === 1 && <g class="money-scene__action">
      <rect x="190" y="25" width="257" height="195" rx="17" fill="#f7faf7" stroke="#87a395" stroke-dasharray="7 6"/>
      <path d="M160 144h21M173 137l9 7-9 7" stroke="#789b89"/>
      <g transform="translate(211 55) scale(1.02)"><use href={shape('wallet')}/></g>
      <path d="M325 122h15M332.5 114.5v15" stroke="#799282" stroke-width="2.5"/>
      <g transform="translate(348 115) scale(.77)"><use href={shape('retirement-pot')}/></g>
      <path d="M207 192h95" stroke="#d6e3d9" stroke-width="3"/>
    </g>}
    {step === 2 && <g>
      <rect x="190" y="48" width="146" height="148" rx="17" fill="#f7faf7" stroke="#87a395" stroke-dasharray="7 6"/>
      <path d="M160 144h21M173 137l9 7-9 7" stroke="#789b89"/>
      <g transform="translate(207 76)"><use href={shape('wallet')}/></g>
      <path d="M346 147h18M355 138v18" stroke="#799282" stroke-width="3"/>
      <g class="money-scene__action"><g transform="translate(371 92) scale(.77)"><use href={shape('retirement-pot')}/></g></g>
      <path d="M351 204h94" stroke="#d6e3d9" stroke-width="3"/>
    </g>}
  </g>}
</svg>

<style>
  .money-scene{display:block;width:100%;height:auto;max-width:680px;margin-inline:auto;overflow:visible}
  .money-scene--compact{max-height:210px}
</style>
