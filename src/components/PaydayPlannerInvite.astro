---
import '../styles/cash-flow.css';
const {placement='calculators'} = Astro.props;
---
<aside class="planner-callout" aria-label="Try the cash-flow planner">
  <div><p class="planner-kicker">NEW · FREE WORKING PREVIEW</p><h2>Do your paydays line up with your bills?</h2><p>Put weekly, fortnightly and monthly payments on one 13-week timeline. Start with example numbers.</p></div>
  <a class="planner-btn" href="/tools/cash-flow/" data-planner-link="planner_demo_open" data-placement={placement}>Try the payday planner</a>
</aside>
<script>import '../scripts/product-events.mjs';</script>
