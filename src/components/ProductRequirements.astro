---
import {productRequirements} from '../lib/product-requirements.mjs';
const {product}=Astro.props;
const notices=productRequirements(product);
---
{notices.length>0&&<div class="comparison-requirements">
 <h4>Eligibility to check</h4>
 <ul>{notices.map(notice=><li><strong>{notice.label}: </strong><span>{notice.text}</span></li>)}</ul>
 <p class="comparison-requirements-note">From the bank's published feed. This is a summary; check the full terms below and with the bank.</p>
</div>}
