---
import { QUICK_ANSWERS, QUICK_ANSWER_TOPICS } from '../data/quick-answers.mjs';
import { formatDate } from '../lib/content-status.mjs';
import '../styles/quick-answers.css';

interface Props {
  id?: string;
  topics?: string[];
  title?: string;
  description?: string;
}

const {
  id = 'quick-answers',
  topics: requestedTopics,
  title = 'A question? Start here.',
  description = 'Choose a question. Get a plain-English answer and a useful next step.',
} = Astro.props;
const answers = QUICK_ANSWERS.filter(answer => !requestedTopics || requestedTopics.includes(answer.topic));
const availableTopics = QUICK_ANSWER_TOPICS.filter(topic => answers.some(answer => answer.topic === topic.id));
const topicLabels = Object.fromEntries(QUICK_ANSWER_TOPICS.map(topic => [topic.id, topic.label]));
const taxOnly = availableTopics.some(topic => topic.id === 'tax') && availableTopics.every(topic => ['tax','using'].includes(topic.id));
const placeholders = {saving:'Try: interest, bonus, rate', home:'Try: offset, deposit, LVR', pay:'Try: salary, super, fortnight'};
const searchPlaceholder = taxOnly ? 'Try: uniform, phone, commute' : availableTopics.length === 1 ? placeholders[availableTopics[0].id] || 'Type a few letters' : 'Try: uniform, offset, super';
const listId = `${id}-questions`;
const searchId = `${id}-search`;
const hintId = `${id}-search-hint`;
---

{answers.length > 0 && (
  <section class="quick-answers" id={id} data-quick-answers aria-labelledby={`${id}-title`}>
    <div class="quick-answers__panel">
      <header class="quick-answers__heading">
        <p class="quick-answers__eyebrow">QUICK ANSWERS</p>
        <h2 id={`${id}-title`}>{title}</h2>
        <p class="quick-answers__description">{description}</p>
      </header>

      <div class="quick-answers__controls" data-quick-controls hidden>
        <form class="quick-answers__search" data-quick-search-form role="search" aria-label="Search quick answers">
          <label for={searchId}>Find a question</label>
          <div class="quick-answers__search-row">
            <input
              id={searchId}
              data-quick-search
              type="search"
              name="question"
              maxlength="120"
              autocomplete="off"
              placeholder={searchPlaceholder}
              aria-describedby={hintId}
              aria-controls={listId}
            />
            <button class="quick-answers__reset" type="button" data-quick-reset>Show all</button>
          </div>
        </form>

        {availableTopics.length > 1 && <div class="quick-answers__topics" role="group" aria-label="Filter questions by topic">
          <button type="button" data-quick-topic="all" aria-pressed="true" aria-controls={listId}>All topics</button>
          {availableTopics.map(topic => (
            <button type="button" data-quick-topic={topic.id} aria-pressed="false" aria-controls={listId}>{topic.label}</button>
          ))}
        </div>}
        <p class="quick-answers__count" data-quick-count role="status" aria-live="polite" aria-atomic="true">{answers.length} questions to explore.</p>
      </div>

      <p class="quick-answers__hint" id={hintId}>Answers are written in advance. Your search stays in your browser.</p>

      <div class="quick-answers__list" id={listId}>
        {answers.map(answer => (
          <details
            class="quick-answers__question"
            id={`${id}-${answer.id}`}
            data-quick-question
            data-topic={answer.topic}
            data-id={answer.id}
            data-search={[answer.question, answer.answer, answer.example || '', ...(answer.keywords || [])].join(' ')}
          >
            <summary>
              <span class="quick-answers__summary-copy">
                <span class="quick-answers__category" data-category={answer.topic}>{topicLabels[answer.topic]}</span>
                <span class="quick-answers__question-text">{answer.question}</span>
              </span>
              <span class="quick-answers__toggle" aria-hidden="true">+</span>
            </summary>
            <div class="quick-answers__body">
              <p class="quick-answers__answer">{answer.answer}</p>
              {answer.example && <p class="quick-answers__example"><strong>For example</strong>{answer.example}</p>}
              <a class="quick-answers__next" href={answer.next.href}>{answer.next.label}<span aria-hidden="true"> →</span></a>
              {answer.source && (
                <div class="quick-answers__source">
                  <a href={answer.source.url} target="_blank" rel="noopener noreferrer">{answer.source.label}<span aria-hidden="true"> ↗</span><span class="quick-answers__sr-only"> (opens in a new tab)</span></a>
                  {answer.source.checkedAt && <span>Source checked <time datetime={answer.source.checkedAt}>{formatDate(answer.source.checkedAt)}</time>.</span>}
                </div>
              )}
            </div>
          </details>
        ))}
      </div>

      <p class="quick-answers__empty" data-quick-empty hidden>No questions match this search. Try a shorter word, or choose Show all to see every question.</p>
      {requestedTopics && <p class="quick-answers__browse"><a href="/help/">Browse all money questions <span aria-hidden="true">→</span></a></p>}
    </div>
  </section>
)}

<script>
  import '../scripts/quick-answers.mjs';
</script>
