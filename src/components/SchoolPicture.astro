---
const {scene,description='An illustrated money example'}=Astro.props;
---
<svg class="school-picture" viewBox="0 0 600 320" role="img" aria-label={description} xmlns="http://www.w3.org/2000/svg">
 <rect x="0" y="0" width="600" height="320" rx="24" fill="#f0eddf"/>
 <circle cx="510" cy="65" r="100" fill="#e1e8d4"/><circle cx="70" cy="295" r="80" fill="#f2d6bf"/>
 <g stroke="#183b33" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
 {scene==='money'&&<>
  <rect x="45" y="92" width="140" height="100" rx="18" fill="#e1ba96"/><path d="M45 113h140M145 132h40v40h-40z" fill="#faf8f1"/><circle cx="159" cy="151" r="3" fill="#183b33"/>
  <path d="M220 145h72m-13-12 13 12-13 12" fill="none"/>
  <path d="M342 125c-40-27-62 12-42 49 10 20 22 25 42 15 20 10 33 5 43-15 20-37-2-76-43-49Z" fill="#d97e58"/><path d="M342 126v-24m0 4q17-24 32-5-16 14-32 5" fill="#91a67a"/>
  <circle cx="486" cy="146" r="41" fill="#e8c467"/>
 </>}
 {scene==='choices'&&<>
  <rect x="68" y="90" width="173" height="123" rx="18" fill="#d9e3ca"/>
  <path d="m103 166 50-52 51 52z" fill="#e1ba96"/><path d="m103 166 50-25 51 25" fill="#8fa775"/>
  <rect x="345" y="78" width="155" height="137" rx="12" fill="#faf8f1" transform="rotate(5 420 140)"/>
  <path d="m388 104 7 15 16 2-12 11 3 17-14-8-15 8 3-17-12-11 17-2z" fill="#e8c467"/>
  <circle cx="454" cy="165" r="24" fill="#e1ba96"/><path d="M442 167q12 13 24 0" fill="none"/><circle cx="446" cy="157" r="1"/><circle cx="462" cy="157" r="1"/>
 </>}
 {scene==='budget'&&[0,1,2].map((n)=><g transform={`translate(${60+n*180} 80)`}><rect x="12" y="0" width="96" height="17" rx="6" fill="#183b33"/><rect x="0" y="19" width="120" height="144" rx="22" fill={['#e1ba96','#d9e3ca','#e8c467'][n]}/>{Array.from({length:[5,4,1][n]},(_,i)=><circle cx={35+(i%2)*48} cy={123-Math.floor(i/2)*33} r="14" fill="#faf8f1"/>)}</g>)}
 {scene==='goal'&&<>
  {[8,11,14,17,20].map((n,i)=><g><rect x={32+i*113} y={230-i*32} width="83" height={32+i*32} rx="12" fill={i===4?'#91a67a':'#e1ba96'}/><text x={73+i*113} y={215-i*32} text-anchor="middle" stroke="none" fill="#183b33" font-size="25">${n}</text></g>)}
  <path d="M524 65V26l36 12-36 12" fill="#d97e58"/>
 </>}
 {scene==='interest'&&<>
  {[0,1,2].map(n=><g transform={`translate(${68+n*190} 0)`}><path d="M0 208h85l-12 52H12z" fill="#e1ba96"/><path d={`M42 208V${135-n*32}`} fill="none"/><path d={`M42 ${168-n*24}q-50 0-38-35 35-4 38 35M42 ${145-n*24}q50 0 38-35-35-4-38 35`} fill="#91a67a"/><circle cx="42" cy={95-n*25} r="28" fill="#e8c467"/></g>)}
  <path d="M178 180h37m-10-10 10 10-10 10M368 180h37m-10-10 10 10-10 10" fill="none"/>
 </>}
 </g>
 <g font-family="Arial, sans-serif" fill="#183b33" text-anchor="middle" font-weight="700">
 {scene==='money'&&<><text x="115" y="240" font-size="24">Start: $5</text><text x="339" y="240" font-size="24">Pay: $3</text><text x="486" y="155" font-size="25">$2</text><text x="486" y="240" font-size="24">Left: $2</text></>}
 {scene==='choices'&&<><text x="155" y="253" font-size="24">Lunch · $6</text><text x="425" y="253" font-size="24">Stickers · $5</text><text x="300" y="42" font-size="20">$10 to spend. $11 to buy both.</text></>}
 {scene==='budget'&&['Spend · $5','Save · $4','Share · $1'].map((label,i)=><text x={120+i*180} y="283" font-size="23">{label}</text>)}
 {scene==='goal'&&['Start','Week 1','Week 2','Week 3','Week 4'].map((label,i)=><text x={73+i*113} y="291" font-size="18">{label}</text>)}
 {scene==='interest'&&['$20','$21','$22.05'].map((label,i)=><><text x={110+i*190} y={102-i*25} font-size={i===2?15:21}>{label}</text><text x={110+i*190} y="292" font-size="19">{['Start','Year 1','Year 2'][i]}</text></>)}
 </g>
</svg>
