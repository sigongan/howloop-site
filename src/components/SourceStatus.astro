---
import {reviewStatus,formatDate} from '../lib/content-status.mjs';
const {checked,days=30}=Astro.props;
const status=reviewStatus(checked,days);
---
<div class="source-status" data-source-status data-checked={checked} data-days={days}>
<span>Sources checked <time datetime={checked}>{formatDate(checked)}</time></span>
<span>{status.due?'Next review '+formatDate(status.due):'Review date unavailable'}</span>
<strong data-review-warning hidden={!status.needsReview}>Recheck needed — use the official source before acting.</strong>
</div>
<script>
import {reviewStatus} from '../lib/content-status.mjs';
for(const el of document.querySelectorAll<HTMLElement>('[data-source-status]')){
 const warning=el.querySelector<HTMLElement>('[data-review-warning]');
 if(warning)warning.hidden=!reviewStatus(el.dataset.checked,Number(el.dataset.days)).needsReview;
}
</script>
