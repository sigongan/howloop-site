---
import ToolIcon from './ToolIcon.astro';
const {calculatorsOnly=false}=Astro.props;
const tasks=[
  {href:'/calculators/compound-interest',title:'Grow my savings',type:'Compound interest',detail:'See your future balance and interest.',icon:'growth'},
  {href:'/calculators/mortgage',title:'Work out repayments',type:'Mortgage & offset',detail:'See monthly payments and potential savings.',icon:'home'},
  {href:'/calculators/savings-goal',title:'Reach a savings goal',type:'Savings goal',detail:'Find how much to put aside each month.',icon:'target'},
  {href:'/calculators/emergency-fund',title:'Build a cash buffer',type:'Emergency fund',detail:'Set a target for unexpected expenses.',icon:'shield'},
  {href:'/tax-return',title:'Prepare my tax return',type:'Employee tax checklist',detail:'Organise expenses and get ready for myTax.',icon:'checklist'},
  {href:'/banks',title:'Find my bank’s rates',type:'Australian bank directory',detail:'Look up published products and conditions.',icon:'bank'},
];
---
<div class:list={['hl-task-grid',{'calculators-only':calculatorsOnly}]}>
{tasks.slice(0,calculatorsOnly?4:6).map(t=><a class="hl-task" href={t.href}>
  <span class="hl-task-icon"><ToolIcon name={t.icon}/></span>
  <div class="hl-task-copy"><span class="hl-task-type">{t.type}</span><h2>{t.title}</h2><p>{t.detail}</p></div>
  <span class="hl-task-arrow" aria-hidden="true">→</span>
</a>)}
</div>
