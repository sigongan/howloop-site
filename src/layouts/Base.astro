---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import { SITE } from '../consts';
import { isIndexableRoute } from '../lib/search-indexing.mjs';
import { LANGUAGES, languageForPath } from '../lib/languages.mjs';
import '../styles/global.css';
import '../styles/finance.css';
import '../styles/focus.css';
import '../styles/mobile-readability.css';
import '../styles/money-areas.css';
import '../styles/modern-foundation.css';
import '../styles/modern-content.css';
import '../styles/modern-calculators.css';
import '../styles/languages.css';
import '../styles/modern-redesign.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  jsonLd?: unknown;
}

const {
  title,
  description,
  canonical,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = !isIndexableRoute(Astro.url.pathname),
  jsonLd,
} = Astro.props;

const canonicalURL = canonical
  ? new URL(canonical, Astro.site)
  : new URL(Astro.url.pathname, Astro.site);
const pageLanguage = languageForPath(Astro.url.pathname);

// Match astro.config.mjs trailingSlash: 'always' so canonical URLs match sitemap URLs 100%
if (canonicalURL.pathname !== '/' && !canonicalURL.pathname.endsWith('/') && !/\.[a-z0-9]+$/i.test(canonicalURL.pathname)) {
  canonicalURL.pathname = `${canonicalURL.pathname}/`;
}
canonicalURL.search = '';
canonicalURL.hash = '';

const fullTitle =
  title === SITE.name ? `${SITE.name} – ${SITE.tagline}` : `${title} | ${SITE.name}`;

const publisherId = /^ca-pub-\d{16}$/.test(SITE.adsensePublisherId) ? SITE.adsensePublisherId : '';
// Prevent AdSense script from loading on 404, noindex, or utility-only routes
const isUtilityOrLegalRoute = /^\/(?:404|privacy|terms|contact)(?:\/|$)/.test(Astro.url.pathname);
const allowAdSenseScript = Boolean(publisherId && !noindex && !isUtilityOrLegalRoute);

const ogImage = new URL('og-default.svg', Astro.site);

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.locale,
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    email: SITE.email,
  },
};
---
<!doctype html>
<html lang={pageLanguage?.lang || SITE.locale} dir={pageLanguage?.dir || 'ltr'} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {pageLanguage && LANGUAGES.map(language => (
      <link rel="alternate" hreflang={language.lang} href={new URL(`/languages/${language.code}/`, Astro.site)} />
    ))}
    {pageLanguage && <link rel="alternate" hreflang="x-default" href={new URL('/languages/en/', Astro.site)} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {publisherId && <meta name="google-adsense-account" content={publisherId} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="icon" href="/favicon.ico?v=money-loop-20260920" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-48.png?v=money-loop-20260920" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=money-loop-20260920" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=money-loop-20260920" sizes="180x180" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} – Australian money guides`} href="/rss.xml" />

    <meta name="theme-color" content="#0B4F3E" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('hl-theme');
        if (savedTheme === 'dark' || savedTheme === 'light') {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch (_) {}
    </script>
    {
      allowAdSenseScript && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${publisherId}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <div class="hl-trust-ribbon" role="region" aria-label="Site transparency notice">
      <div class="hl-wrap hl-trust-ribbon__inner">
        <span><strong>Australian Financial Tools</strong> · 100% browser-local calculations · Zero personal data stored</span>
        <span>ATO 2025–26 &amp; 2026–27 Rules · Public CDR Banking Feeds</span>
      </div>
    </div>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <AnalyticsConsent />
  </body>
</html>
