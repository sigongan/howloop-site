---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import {LANGUAGES,languageForPath} from '../lib/languages.mjs';
import '../styles/global.css';
import '../styles/finance.css';
import '../styles/focus.css';
import '../styles/mobile-readability.css';
import '../styles/money-areas.css';
import '../styles/modern-foundation.css';
import '../styles/modern-content.css';
import '../styles/modern-calculators.css';
import '../styles/languages.css';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative canonical path; defaults to current URL */
  canonical?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  jsonLd?: unknown;
}

const {
  title,
  description,
  canonical,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);
const pageLanguage=languageForPath(Astro.url.pathname);
if (canonicalURL.pathname !== '/') canonicalURL.pathname = canonicalURL.pathname.replace(/\/?$/, '/');
canonicalURL.search = '';
canonicalURL.hash = '';
const fullTitle =
  title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} | ${SITE.name}`;

const publisherId = /^ca-pub-\d{16}$/.test(SITE.adsensePublisherId) ? SITE.adsensePublisherId : '';
const ogImage = new URL('/og-default.svg', Astro.site);

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
};
---

<!doctype html>
<html lang={pageLanguage?.lang||SITE.locale} dir={pageLanguage?.dir||'ltr'}>
  <head>
    <!-- Google Analytics 4: site visits and engagement. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LD0HE7HZ62"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LD0HE7HZ62');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {pageLanguage && LANGUAGES.map(language=><link rel="alternate" hreflang={language.lang} href={new URL(`/languages/${language.code}/`,Astro.site)}/>)}
    {pageLanguage && <link rel="alternate" hreflang="x-default" href={new URL('/languages/en/',Astro.site)}/>}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.ico?v=money-loop-20260920" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-48.png?v=money-loop-20260920" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=money-loop-20260920" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=money-loop-20260920" sizes="180x180" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — new guides`}
      href="/rss.xml"
    />

    <meta name="theme-color" content="#f5f6f8" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Display face: one weight range, swapped in, never blocking. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(orgLd)}
    />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    {publisherId && <meta name="google-adsense-account" content={publisherId} />}
  </head>

  <body>
    <a class="skip-link" href="#main">{pageLanguage?.copy.skip||'Skip to content'}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
