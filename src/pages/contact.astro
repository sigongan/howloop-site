---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
---
<Base
  title="Contact & Feedback"
  description="Contact the Howloop team regarding calculator formulas, Australian CDR bank data updates, or editorial corrections."
>
  <div class="hl-wrap hl-prose-wrap">
    <article class="hl-prose">
      <h1>Contact Howloop</h1>
      <p>
        We welcome bug reports, formula verification questions, CDR bank coverage feedback, and editorial corrections from readers across Australia.
      </p>

      <div class="hl-policy-callout">
        <strong>Direct Email:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
        <span>Typical response window: 1–2 Australian business days (AEST/AEDT).</span>
      </div>

      <h2>How to Report a Calculation or Rate Issue</h2>
      <ul>
        <li><strong>Calculator Formula Check:</strong> Include the page URL (e.g., <code>/calculators/salary/</code>), the approximate input figures tested, and the expected ATO or lender rule.</li>
        <li><strong>CDR Bank Snapshot Feedback:</strong> Mention the banking brand name and product name as listed on our <a href="/banks/">Bank Explorer</a> page.</li>
        <li><strong>Editorial or Accessibility Issue:</strong> Let us know your device/browser and the guide URL so we can reproduce and fix any layout or readability issue promptly.</li>
      </ul>

      <h2>Important Privacy Reminder</h2>
      <p>
        Please do not include sensitive personal identifiers such as Tax File Numbers (TFNs), bank account numbers, or full financial statements when emailing us.
      </p>
    </article>
  </div>
</Base>
