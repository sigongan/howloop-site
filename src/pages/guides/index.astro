---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/GuideCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { TOPICS } from '../../consts';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);
---

<Base
  title="All guides"
  description="Every Howloop guide: short looping animations that show you how to fix common household and device problems, step by step."
>
  <header class="pagehead">
    <div class="wrap">
      <p class="eyebrow">{guides.length} guides</p>
      <h1>Every loop we've made</h1>
      <p class="lede">
        Ordinary problems that come back every few months. Each one is an
        animation you can pause on the step you're stuck at, plus the same
        instructions in writing.
      </p>
      <nav class="filters" aria-label="Filter by topic">
        <span class="chip chip--brand">All</span>
        {
          Object.values(TOPICS).map((t) => (
            <a class="chip" href={`/topics/${t.id}`}>
              {t.label}
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <div class="wrap listing">
    <div class="grid">
      {guides.map((g) => <GuideCard guide={g} />)}
    </div>
    <AdSlot layout="display" />
  </div>
</Base>

<style>
  .pagehead {
    padding-block: 2.5rem 2rem;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--brand-tint) 60%, var(--paper)),
      var(--paper)
    );
    border-bottom: 1px solid var(--line-soft);
  }

  .pagehead h1 {
    font-size: var(--step-4);
    margin-block-start: 0.4rem;
  }

  .lede {
    margin-block-start: 0.9rem;
    max-width: 56ch;
    font-size: var(--step-1);
    color: var(--ink-2);
    line-height: 1.55;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: 1.4rem;
  }

  .listing {
    padding-block: 2.5rem 4rem;
  }

  .grid {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
</style>
