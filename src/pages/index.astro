---
import Base from '../layouts/Base.astro';
import TaskPicker from '../components/TaskPicker.astro';
import BankLogo from '../components/BankLogo.astro';
const featuredBanks=[
  {id:'25233bad-e494-ea11-a831-000d3a8842e1',name:'CommBank'},
  {id:'fc9352a8-ad27-eb11-a834-000d3a8842e1',name:'ING'},
  {id:'f4562bb8-e394-ea11-a831-000d3a8842e1',name:'ANZ'},
  {id:'25797662-e294-ea11-a831-000d3a8842e1',name:'NAB'},
  {id:'bf1c01af-789d-eb11-a821-000d3a884a20',name:'Up'},
];
---
<Base title="Howloop" description="Free Australian money tools. Calculate savings and mortgage repayments, find bank rates, or prepare an employee tax checklist. No sign-up needed.">
<div class="hl-wrap hl-task-home">
  <header class="hl-task-heading"><h1>What do you need?</h1><p>Free Australian money tools. No sign-up.</p></header>
  <TaskPicker/>
  <section class="hl-bank-shortcuts" aria-label="Quick bank lookup"><span>Find a bank</span><div>{featuredBanks.map(b=><a href={'/calculators/compound-interest?bank='+b.id} aria-label={'Explore '+b.name+' products'}><BankLogo id={b.id}/></a>)}</div><a class="hl-text-link" href="/banks">All banks →</a></section>
  <aside class="hl-help-strip"><p>Want to understand the numbers?</p><a href="/learn">Read a money guide →</a><a href="/methodology">How we calculate →</a></aside>
</div>
</Base>
