---
import Base from '../layouts/Base.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { SITE } from '../consts';
import { savings } from '../lib/finance.mjs';
import guides from '../data/learning.json';
import '../styles/home.css';
const example = savings({principal:1000,contribution:200,annualRate:4,years:5});
const money = n => new Intl.NumberFormat('en-AU',{style:'currency',currency:'AUD',maximumFractionDigits:0}).format(n);
const tasks = [
 {icon:'wallet',title:'Understand your pay',text:'See what reaches your bank account. Compare two offers, with tax and super explained.',href:'/calculators/salary/',action:'Calculate take-home pay',tag:'PAY & SUPER',colour:'peach'},
 {icon:'growth',title:'Give your savings a plan',text:'See where regular deposits could take you. Separate your contributions from interest.',href:'/calculators/compound-interest/',action:'Explore your savings',tag:'SAVING & GOALS',colour:'sage'},
 {icon:'checklist',title:'Stay ahead of your bills',text:'Put income and bills on a 13-week calendar. Spot the tight weeks before they happen.',href:'/tools/cash-flow/',action:'Plan your paydays',tag:'EVERYDAY MONEY',colour:'sand'},
];
const reading = ['salary-including-super-vs-plus-super','how-compound-interest-works','offset-vs-extra-repayments'].map(slug=>guides.find(g=>g.slug===slug));
---
<Base title={SITE.name} description="Make sense of your money with free Australian calculators and practical guides. Compare take-home pay, explore your savings and plan bills around payday. No account needed.">
<div class="home-studio">
 <section class="studio-hero hl-wrap" aria-labelledby="home-title">
  <div class="studio-intro">
   <p class="studio-eyebrow"><span class="studio-dot"></span> Free Australian money tools</p>
   <h1 id="home-title">Your money.<br/>A little <em>clearer.</em></h1>
   <p class="studio-lead">Less wondering. More working it out.<br/>Simple tools for your pay, savings and everyday life in Australia.</p>
   <div class="studio-actions"><a class="studio-primary" href="/calculators/salary/">Work out my take-home pay <span aria-hidden="true">↗</span></a><a class="studio-text-link" href="/tools/">Explore all tools <span aria-hidden="true">→</span></a></div>
   <div class="studio-assurance"><span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-8"/></svg>Free to use</span><span>No account needed</span><span>Made for Australia</span></div>
  </div>
  <aside class="studio-lab" aria-labelledby="lab-title" data-home-lab>
   <div class="lab-top"><p class="studio-eyebrow">SMALL STEPS, REAL POSSIBILITIES</p><span class="lab-stamp" aria-hidden="true"><ToolIcon name="growth"/></span></div>
   <h2 id="lab-title">What could a little<br/>each month become?</h2>
   <p class="lab-context">Start with $1,000. Try a monthly saving.</p>
   <form data-lab-form>
    <div class="lab-controls" data-lab-controls hidden><label for="home-deposit">Add each month <span>AUD</span></label><div class="lab-amount"><span aria-hidden="true">$</span><input id="home-deposit" name="deposit" type="number" inputmode="decimal" value="200" min="0" max="10000" step="any" required aria-describedby="lab-assumptions"/><span>/ month</span></div><input class="lab-slider" data-lab-slider type="range" min="0" max="1000" step="25" value="200" aria-label="Adjust monthly saving up to 1,000 dollars"/><div class="lab-periods" role="group" aria-label="Savings timeframe">{[1,3,5,10].map(year=><button type="button" data-lab-years={year} aria-pressed={year===5?'true':'false'}>{year} {year===1?'year':'years'}</button>)}</div></div>
    <p class="lab-error" role="alert" data-lab-error hidden></p>
   </form>
   <div class="lab-result" role="status" aria-live="polite" aria-atomic="true"><span data-lab-label>Illustrative balance after 5 years</span><strong data-lab-total>{money(example.balance)}</strong><span class="lab-result-detail"><span data-lab-deposits>{money(example.deposits)}</span> saved by you + <span data-lab-interest>{money(example.interest)}</span> interest</span></div>
   <div class="lab-bars" aria-hidden="true" data-lab-chart>{example.rows.slice(1).map(row=><div><span style={`height:${row.balance/example.balance*100}%`}><i style={`height:${row.interest/row.balance*100}%`}></i></span><small>Y{row.year}</small></div>)}</div>
   <p class="lab-legend"><span>Your deposits</span><span>Interest</span></p>
   <p id="lab-assumptions" class="lab-assumptions">Example: $1,000 to start, $200 added at each month’s end, 4% a year compounded monthly. Before tax, fees and inflation. Rates can change.</p>
   <a href="/calculators/compound-interest/" class="lab-link" data-lab-continue>Change the rate &amp; see the full picture <span aria-hidden="true">↗</span></a>
  </aside>
 </section>
 <section class="studio-tools hl-wrap" id="choose" aria-labelledby="choose-title">
  <div class="studio-section-head"><div><p class="studio-eyebrow">START WHERE YOU ARE</p><h2 id="choose-title">One question. A useful next step.</h2></div><a href="/tools/">All tools <span aria-hidden="true">↗</span></a></div>
  <div class="studio-tool-grid">{tasks.map(task=><a class={`studio-tool ${task.colour}`} href={task.href}><div class="studio-tool-top"><span class="studio-tool-icon"><ToolIcon name={task.icon}/></span><span>{task.tag}</span></div><h3>{task.title}</h3><p>{task.text}</p><span class="studio-tool-action">{task.action}<span aria-hidden="true">↗</span></span></a>)}</div>
  <div class="studio-shortcuts"><span>Something else on your mind?</span><a href="/calculators/mortgage/">Home loan &amp; offset ↗</a><a href="/calculators/emergency-fund/">Emergency buffer ↗</a><a href="/tax-return/">Tax checklist ↗</a></div>
 </section>
 <section class="studio-principles" aria-labelledby="principles-title"><div class="hl-wrap studio-principles-inner"><div><p class="studio-eyebrow">THE HOWLOOP WAY</p><h2 id="principles-title">Understand the number.<br/>Then make your next move.</h2></div><ol><li><span>01</span><div><h3>Start with your situation</h3><p>Enter only the details the tool needs. No account, bank connection or sales call.</p></div></li><li><span>02</span><div><h3>See what changes the answer</h3><p>Try a different amount or timeframe. We show the assumptions and where the estimate stops.</p></div></li><li><span>03</span><div><h3>Leave with a clearer picture</h3><p>Use the worked examples and linked sources to understand what to check next.</p></div></li></ol></div></section>
 <section class="studio-reading hl-wrap" aria-labelledby="reading-title"><div class="studio-section-head"><div><p class="studio-eyebrow">A FEW MINUTES WELL SPENT</p><h2 id="reading-title">Make the numbers make sense.</h2></div><a href="/learn/">All money guides <span aria-hidden="true">↗</span></a></div><div class="studio-reading-grid">{reading.map((guide,i)=><a class="studio-guide" href={`/learn/${guide.slug}/`}><div class={`studio-guide-art art-${i}`} aria-hidden="true">{i===0?<><span>YOUR SALARY</span><div class="art-pay"><b>Pay</b><i>Super</i></div><small>One offer. Two different amounts.</small></>:i===1?<><span>SMALL AMOUNTS ADD UP</span><div class="art-growth">{[23,39,58,78,100].map(h=><i style={`height:${h}%`}></i>)}</div><small>Your money, plus time.</small></>:<><span>THE OFFSET EFFECT</span><div class="art-offset"><b>Loan</b><span>−</span><i>Savings</i></div><small>Interest on a smaller balance.</small></>}</div><div class="studio-guide-copy"><small>{guide.category} <span>· {guide.minutes} min read</span></small><h3>{guide.title}</h3><p>{guide.summary}</p><span class="studio-guide-link">Read the guide <span aria-hidden="true">↗</span></span></div></a>)}</div></section>
 <section class="studio-note hl-wrap" aria-labelledby="note-title"><div class="studio-note-symbol" aria-hidden="true">✳</div><div><p class="studio-eyebrow">USEFUL NUMBERS. CLEAR LIMITS.</p><h2 id="note-title">A helping hand, not a sales pitch.</h2><p>Howloop is an independent money education project. We connect practical calculators with original worked examples and public sources. We do not accept payment to rank bank products.</p><p>These are educational estimates, not personal financial advice. Our content has not been reviewed by a licensed financial adviser. Optional saved plans stay on your device.</p><div><a href="/about/#publisher">Meet Howloop ↗</a><a href="/methodology/">How we calculate ↗</a><a href="/editorial-policy/">How we check our work ↗</a></div></div></section>
</div>
</Base>
<script>import '../scripts/home-lab.mjs';</script>
