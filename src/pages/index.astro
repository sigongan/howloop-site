---
import Base from '../layouts/Base.astro';
import BankLogo from '../components/BankLogo.astro';
import ToolIcon from '../components/ToolIcon.astro';
import QuickSavings from '../components/QuickSavings.astro';
import '../styles/home.css';
const banks=[
{id:'25233bad-e494-ea11-a831-000d3a8842e1',name:'CommBank'},
{id:'fc9352a8-ad27-eb11-a834-000d3a8842e1',name:'ING'},
{id:'f4562bb8-e394-ea11-a831-000d3a8842e1',name:'ANZ'},
{id:'25797662-e294-ea11-a831-000d3a8842e1',name:'NAB'},
{id:'bf1c01af-789d-eb11-a821-000d3a884a20',name:'Up'},
];
---
<Base title="Howloop" description="Make sense of your money in Australia. Try a free savings calculator, work out home-loan repayments, and prepare your employee tax checklist. No sign-up.">
<div class="home-page">
<section class="home-hero home-wrap" aria-labelledby="home-title">
  <div class="home-intro">
    <p class="home-eyebrow"><span aria-hidden="true"></span> Money made simple. For Australia.</p>
    <h1 id="home-title">See what your<br />money <em>can do.</em></h1>
    <p class="home-description">Grow your savings. Understand your home loan. Get ready for tax time.</p>
    <p class="home-promise">Free to use · No sign-up</p>
    <nav class="home-paths" aria-label="Choose your money goal">
      <a href="#try-savings"><ToolIcon name="growth"/> Save money <span aria-hidden="true">↗</span></a>
      <a href="#home-loan"><ToolIcon name="home"/> Home loans <span aria-hidden="true">↗</span></a>
      <a href="#tax-time"><ToolIcon name="checklist"/> Tax time <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
  <QuickSavings />
</section>
<section class="home-bank-strip home-wrap" aria-label="Australian bank product directory">
  <div><h2>Know what your bank pays.</h2><p>Published rates, with the conditions explained.</p></div>
  <div class="home-bank-logos">{banks.map(b=><a href={'/calculators/compound-interest/?bank='+b.id} aria-label={'See '+b.name+' products'}><BankLogo id={b.id}/></a>)}</div>
  <a class="home-inline-link" href="/banks/">Find your bank →</a>
</section>
<section class="home-next home-wrap" aria-labelledby="next-title">
  <div class="home-section-heading"><div><p class="home-eyebrow">ONE QUESTION. A CLEARER NEXT STEP.</p><h2 id="next-title">A little less guessing.</h2></div><a class="home-inline-link" href="/calculators/">All calculators →</a></div>
  <div class="home-features">
    <article class="home-feature home-feature-house" id="home-loan">
      <div class="home-feature-icon"><ToolIcon name="home"/></div><p class="home-feature-label">BUYING A HOME</p>
      <h3>What would my<br />home loan cost?</h3><p>See your monthly repayments, then try an offset or extra payments.</p>
      <a class="home-action" href="/calculators/mortgage/">Work out my repayments <span aria-hidden="true">→</span></a>
      <div class="home-related"><a href="/calculators/lvr/">Check my deposit & LVR</a><a href="/learn/offset-vs-extra-repayments/">Explain offset accounts</a></div>
    </article>
    <article class="home-feature home-feature-tax" id="tax-time">
      <div class="home-feature-icon"><ToolIcon name="checklist"/></div><p class="home-feature-label">EMPLOYEE TAX RETURNS</p>
      <h3>Tax time.<br />Where do I start?</h3><p>Find records to gather and expenses to check before you use myTax.</p>
      <a class="home-action" href="/tax-return/">Make my tax checklist <span aria-hidden="true">→</span></a>
      <p class="home-feature-note">A preparation guide. You lodge your own return.</p>
    </article>
  </div>
  <div class="home-small-tools">
    <a href="/calculators/savings-goal/"><ToolIcon name="target"/><span><strong>Saving for something?</strong><span>Find your monthly savings target.</span></span><span aria-hidden="true">→</span></a>
    <a href="/calculators/emergency-fund/"><ToolIcon name="shield"/><span><strong>Need a safety net?</strong><span>Work out your emergency fund.</span></span><span aria-hidden="true">→</span></a>
  </div>
</section>
<section class="home-learn home-wrap" aria-labelledby="learn-title">
  <div class="home-section-heading"><div><p class="home-eyebrow">YOU DON'T NEED TO BE A MONEY EXPERT</p><h2 id="learn-title">Learn one useful thing.</h2></div><a class="home-inline-link" href="/learn/">Explore the guides →</a></div>
  <div class="home-lessons">
    <a href="/learn/how-compound-interest-works/"><span class="home-lesson-art home-lesson-growth" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><span class="home-lesson-topic">SAVING</span><h3>How does interest earn more interest?</h3><p>A simple example, with real numbers.</p><span class="home-inline-link">Understand compound interest →</span></a>
    <a href="/learn/planning-a-home-deposit/"><span class="home-lesson-art home-lesson-house" aria-hidden="true"><ToolIcon name="home"/></span><span class="home-lesson-topic">YOUR FIRST HOME</span><h3>How much cash do I need to buy a home?</h3><p>Look beyond the deposit.</p><span class="home-inline-link">Understand the upfront costs →</span></a>
    <a href="/learn/super-basics/"><span class="home-lesson-art home-lesson-super" aria-hidden="true"><ToolIcon name="shield"/></span><span class="home-lesson-topic">SUPERANNUATION</span><h3>What is my super actually doing?</h3><p>Your future money, explained simply.</p><span class="home-inline-link">Get to know your super →</span></a>
  </div>
  <div class="home-source-note"><p>Built for learning, with links to official sources.</p><a href="/updates/">See rule updates & corrections →</a><a href="/about/">Meet Howloop →</a></div>
</section>
</div>
</Base>
