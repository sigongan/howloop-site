---
import Base from '../layouts/Base.astro';
import BankLogo from '../components/BankLogo.astro';
import ToolIcon from '../components/ToolIcon.astro';
import QuickSavings from '../components/QuickSavings.astro';
import { NAV } from '../consts';
import '../styles/home.css';
const homeTopics=NAV.map(item=>({...item,...({savings:{label:'Savings',hint:'Interest & rates'},pay:{label:'Pay after tax',hint:'Pay calculator'},home:{label:'Home loans',hint:'Repayments'},tax:{label:'Tax checklist',hint:'Before myTax'},learn:{label:'Money lessons',hint:'See it in 3 steps'}}[item.id]||{})}));
const banks=[
{id:'25233bad-e494-ea11-a831-000d3a8842e1',name:'CommBank'},
{id:'fc9352a8-ad27-eb11-a834-000d3a8842e1',name:'ING'},
{id:'f4562bb8-e394-ea11-a831-000d3a8842e1',name:'ANZ'},
{id:'25797662-e294-ea11-a831-000d3a8842e1',name:'NAB'},
{id:'bf1c01af-789d-eb11-a821-000d3a884a20',name:'Up'},
{id:'ffe2945b-e094-ea11-a831-000d3a8842e1',name:'Westpac'},
{id:'d64b7811-21bc-eb11-a823-000d3a884a20',name:'Macquarie'},
];
---
<Base title="Howloop" description="Free money tools for Australia. Calculate savings, take-home pay and home-loan repayments, prepare a tax checklist, or learn with simple examples.">
<div class="home-page">
  <div class="home-stage">
    <section class="home-hero home-wrap" aria-labelledby="home-title">
      <div class="home-intro">
        <p class="home-eyebrow">CALCULATE · COMPARE · LEARN</p>
        <h1 id="home-title">Free money tools<br/>for Australia.</h1>
        <p class="home-description">Calculate the numbers. Understand what they mean.</p>
        <p class="home-nav-label">Choose what you need</p>
        <nav class="home-paths" aria-label="Choose a money topic">
          {homeTopics.map(item=><a href={item.href} data-money-area={item.id}>
            <span class="home-path-icon"><ToolIcon name={item.icon}/></span>
            <span class="home-path-copy"><strong>{item.label}</strong><small>{item.hint}</small></span>
            <ToolIcon name="arrow"/>
          </a>)}
        </nav>
        <p class="home-promise"><ToolIcon name="shield"/> Free to use. No sign-up.</p>
      </div>
      <div class="home-demo"><QuickSavings /></div>
    </section>
  </div>

  <section class="home-bank-section home-wrap" data-money-area="savings" aria-labelledby="bank-title">
    <div class="home-section-heading">
      <div><p class="home-section-kicker"><ToolIcon name="bank"/> Savings · bank rates</p><h2 id="bank-title">Compare savings rates.</h2></div>
      <a class="home-text-action" href="/compare/savings/">Compare savings <ToolIcon name="arrow"/></a>
    </div>
    <p class="home-section-description">See estimated interest and the conditions behind it. Howloop is independent of these banks.</p>
    <div class="home-bank-logos">{banks.map(b=><a href={'/calculators/compound-interest/?bank='+b.id} aria-label={'See '+b.name+' products'}><BankLogo id={b.id}/><span class="home-bank-name">{b.name}</span></a>)}</div>
    <div class="home-small-tools">
      <a href="/calculators/savings-goal/"><ToolIcon name="target"/><span><strong>Savings goal</strong><span>Find what to save each month.</span></span><ToolIcon name="arrow"/></a>
      <a href="/calculators/emergency-fund/"><ToolIcon name="shield"/><span><strong>Emergency fund</strong><span>Plan a buffer for essential bills.</span></span><ToolIcon name="arrow"/></a>
    </div>
  </section>

  <div class="home-learn-band">
    <section class="home-learn home-wrap" data-money-area="learn" aria-labelledby="learn-title">
      <div class="home-learn-intro">
        <p class="home-section-kicker"><ToolIcon name="book"/> Learn</p>
        <h2 id="learn-title">See it.<br/>Understand it.</h2>
        <p>Start with a short picture story. Then try the numbers yourself.</p>
        <a class="home-text-action" href="/learn/">Open money lessons <ToolIcon name="arrow"/></a>
      </div>
      <div class="home-lessons">
        <a href="/learn/how-compound-interest-works/" data-money-area="savings"><span class="home-lesson-symbol"><ToolIcon name="growth"/></span><div class="home-lesson-copy"><span class="home-lesson-topic">Savings · 3 simple steps</span><h3>How does interest earn interest?</h3><p>Follow $100 as it earns a little more.</p><span class="home-read-guide">See the lesson <ToolIcon name="arrow"/></span></div></a>
        <a href="/learn/offset-vs-extra-repayments/" data-money-area="home"><span class="home-lesson-symbol"><ToolIcon name="home"/></span><div class="home-lesson-copy"><span class="home-lesson-topic">Home loans · 3 simple steps</span><h3>What does an offset do?</h3><p>See what changes, and what you still owe.</p><span class="home-read-guide">See the lesson <ToolIcon name="arrow"/></span></div></a>
        <a href="/learn/salary-including-super-vs-plus-super/" data-money-area="pay"><span class="home-lesson-symbol"><ToolIcon name="wallet"/></span><div class="home-lesson-copy"><span class="home-lesson-topic">Pay · 3 simple steps</span><h3>Is super inside your salary?</h3><p>See cash pay and super in separate pots.</p><span class="home-read-guide">See the lesson <ToolIcon name="arrow"/></span></div></a>
      </div>
    </section>
  </div>
  <aside class="home-public-info home-wrap" aria-labelledby="home-about-title"><div><h2 id="home-about-title">Free tools. Clear sources.</h2><p>Howloop is an independent education project. You can use the tools without an account. Advertising may help support the site in future.</p></div><nav aria-label="About these free tools"><a href="/about/">Who makes Howloop?</a><a href="/methodology/">How the numbers work</a><a href="/contact/">Contact & corrections</a></nav></aside>
  <div class="home-source-note home-wrap"><p><ToolIcon name="checklist"/> Simple explanations. Official sources.</p><a href="/updates/">Rule updates & corrections <ToolIcon name="arrow"/></a><a href="/about/">About Howloop <ToolIcon name="arrow"/></a></div>
</div>
</Base>

