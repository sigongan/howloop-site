---
import Base from '../layouts/Base.astro';
import BankLogo from '../components/BankLogo.astro';
import ToolIcon from '../components/ToolIcon.astro';
import QuickSavings from '../components/QuickSavings.astro';
import { NAV } from '../consts';
import '../styles/home.css';
const banks=[
{id:'25233bad-e494-ea11-a831-000d3a8842e1',name:'CommBank'},
{id:'fc9352a8-ad27-eb11-a834-000d3a8842e1',name:'ING'},
{id:'f4562bb8-e394-ea11-a831-000d3a8842e1',name:'ANZ'},
{id:'25797662-e294-ea11-a831-000d3a8842e1',name:'NAB'},
{id:'bf1c01af-789d-eb11-a821-000d3a884a20',name:'Up'},
{id:'ffe2945b-e094-ea11-a831-000d3a8842e1',name:'Westpac'},
{id:'d64b7811-21bc-eb11-a823-000d3a884a20',name:'Macquarie'},
];
---
<Base title="Howloop" description="Free money tools for Australia. Calculate savings, take-home pay and home-loan repayments, prepare a tax checklist, or learn with simple examples.">
<div class="home-page">
  <div class="home-stage">
    <section class="home-hero home-wrap" aria-labelledby="home-title">
      <div class="home-intro">
        <p class="home-eyebrow"><span class="home-status-dot" aria-hidden="true"></span> Free money tools. Made for Australia.</p>
        <h1 id="home-title">Your money.<br/><em>Made clearer.</em></h1>
        <p class="home-description">Understand your pay, grow your savings, and plan what comes next.</p>
        <p class="home-nav-label">What would you like to work out?</p>
        <nav class="home-paths" aria-label="Choose a money topic">
          {NAV.map(item=><a href={item.id==='savings'?'#try-savings':item.href} data-money-area={item.id}>
            <span class="home-path-icon"><ToolIcon name={item.icon}/></span>
            <span class="home-path-copy"><strong>{item.label}</strong><small>{item.hint}</small></span>
            <ToolIcon name="arrow"/>
          </a>)}
        </nav>
        <p class="home-promise"><ToolIcon name="shield"/> Free to use. No sign-up.</p>
      </div>
      <div class="home-demo"><QuickSavings /></div>
    </section>
  </div>

  <section class="home-bank-section home-wrap" data-money-area="savings" aria-labelledby="bank-title">
    <div class="home-section-heading">
      <div><p class="home-section-kicker"><ToolIcon name="bank"/> Savings · bank rates</p><h2 id="bank-title">Know what your bank pays.</h2></div>
      <a class="home-text-action" href="/compare/savings/">Compare savings <ToolIcon name="arrow"/></a>
    </div>
    <p class="home-section-description">Published products and rates, with the conditions that matter.</p>
    <div class="home-bank-logos">{banks.map(b=><a href={'/calculators/compound-interest/?bank='+b.id} aria-label={'See '+b.name+' products'}><BankLogo id={b.id}/><span class="home-bank-name">{b.name}</span></a>)}</div>
    <div class="home-small-tools">
      <a href="/calculators/savings-goal/"><ToolIcon name="target"/><span><strong>Savings goal</strong><span>Find what to save each month.</span></span><ToolIcon name="arrow"/></a>
      <a href="/calculators/emergency-fund/"><ToolIcon name="shield"/><span><strong>Emergency fund</strong><span>Plan a buffer for essential bills.</span></span><ToolIcon name="arrow"/></a>
    </div>
  </section>

  <section class="home-next home-wrap" aria-labelledby="next-title">
    <div class="home-section-heading home-next-heading">
      <div><p class="home-section-kicker">Tools for everyday decisions</p><h2 id="next-title">A clearer next step.</h2></div>
      <a class="home-text-action" href="/calculators/">All calculators <ToolIcon name="arrow"/></a>
    </div>
    <div class="home-features">
      <article class="home-feature" id="take-home-pay" data-money-area="pay">
        <div class="home-feature-heading"><span class="home-feature-icon"><ToolIcon name="wallet"/></span><h3>Take-home pay</h3></div>
        <p class="home-feature-question">What lands in{' '}<br/>my bank account?</p>
        <p class="home-feature-description">See your pay after tax, with employer super shown separately.</p>
        <p class="home-feature-detail">Weekly · Every 2 weeks · Monthly</p>
        <a class="home-tool-action" href="/calculators/salary/"><span>Calculate my pay</span><span class="home-action-arrow"><ToolIcon name="arrow"/></span></a>
        <p class="home-feature-note">Compare your salary with published occupation pay bands.</p>
      </article>
      <article class="home-feature" id="home-loan" data-money-area="home">
        <div class="home-feature-heading"><span class="home-feature-icon"><ToolIcon name="home"/></span><h3>Home loans</h3></div>
        <p class="home-feature-question">What will my{' '}<br/>repayments be?</p>
        <p class="home-feature-description">Work out repayments, then try an offset or extra payments.</p>
        <a class="home-tool-action" href="/calculators/mortgage/"><span>Calculate repayments</span><span class="home-action-arrow"><ToolIcon name="arrow"/></span></a>
        <div class="home-related"><a href="/calculators/lvr/">Check my deposit & LVR <ToolIcon name="arrow"/></a><a href="/learn/offset-vs-extra-repayments/">Understand offset accounts <ToolIcon name="arrow"/></a></div>
      </article>
      <article class="home-feature" id="tax-time" data-money-area="tax">
        <div class="home-feature-heading"><span class="home-feature-icon"><ToolIcon name="checklist"/></span><h3>Tax returns</h3></div>
        <p class="home-feature-question">What do I need{' '}<br/>for tax time?</p>
        <p class="home-feature-description">Find records to gather and work expenses to check before lodging.</p>
        <a class="home-tool-action" href="/tax-return/"><span>Build my tax checklist</span><span class="home-action-arrow"><ToolIcon name="arrow"/></span></a>
        <p class="home-feature-note">For employees. A preparation guide; you lodge through myTax.</p>
      </article>
    </div>
  </section>

  <div class="home-learn-band">
    <section class="home-learn home-wrap" data-money-area="learn" aria-labelledby="learn-title">
      <div class="home-learn-intro">
        <p class="home-section-kicker"><ToolIcon name="book"/> Learn</p>
        <h2 id="learn-title">Small print.<br/>Real money.</h2>
        <p>See what an offer really means. Simple explanations, worked examples and numbers you can change.</p>
        <a class="home-text-action" href="/learn/">Explore all guides <ToolIcon name="arrow"/></a>
      </div>
      <div class="home-lessons">
        <a href="/learn/savings-rate-reality-check/" data-money-area="savings"><span class="home-lesson-symbol"><ToolIcon name="growth"/></span><div class="home-lesson-copy"><span class="home-lesson-topic">Savings · try the numbers</span><h3>Will the bigger rate earn more?</h3><p>Compare bonus, welcome and steady rates over one year.</p><span class="home-read-guide">Read & try <ToolIcon name="arrow"/></span></div></a>
        <a href="/learn/when-an-offset-pays-for-itself/" data-money-area="home"><span class="home-lesson-symbol"><ToolIcon name="home"/></span><div class="home-lesson-copy"><span class="home-lesson-topic">Home loans · try the numbers</span><h3>Does an offset cover its costs?</h3><p>Include the higher rate and fees before counting the saving.</p><span class="home-read-guide">Read & try <ToolIcon name="arrow"/></span></div></a>
        <a href="/learn/salary-including-super-vs-plus-super/" data-money-area="pay"><span class="home-lesson-symbol"><ToolIcon name="wallet"/></span><div class="home-lesson-copy"><span class="home-lesson-topic">Pay · try the numbers</span><h3>Is super inside your salary?</h3><p>Split the same salary quote into cash pay and employer super.</p><span class="home-read-guide">Read & try <ToolIcon name="arrow"/></span></div></a>
      </div>
    </section>
  </div>
  <div class="home-source-note home-wrap"><p><ToolIcon name="checklist"/> Simple explanations. Official sources.</p><a href="/updates/">Rule updates & corrections <ToolIcon name="arrow"/></a><a href="/about/">About Howloop <ToolIcon name="arrow"/></a></div>
</div>
</Base>

