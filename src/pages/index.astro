---
import Base from '../layouts/Base.astro';
import ToolIcon from '../components/ToolIcon.astro';
import {calculateCashFlow} from '../lib/cash-flow.mjs';
import {createHomeExampleModel, HOME_EXAMPLE_PRESET_ID} from '../lib/cash-flow-examples.mjs';
import '../styles/home.css';
import '../styles/cash-flow.css';
const example=calculateCashFlow(createHomeExampleModel());
---
<Base title="Will your money last until payday?" description="Add money you have now, your paydays and your bills. See when cash could run short with Howloop's free Australian payday planner. No account or bank connection.">
<div class="home-page">
  <div class="home-stage"><section class="home-hero home-wrap" aria-labelledby="home-title">
    <div class="home-intro">
      <p class="home-eyebrow">FREE PAYDAY &amp; BILLS PLANNER · AUSTRALIA</p>
      <h1 id="home-title">Will your money last until payday?</h1>
      <p class="home-description">Add the money you have, the money coming in and the money going out. See which day could come up short.</p>
      <a class="planner-btn planner-btn--primary" href="/tools/cash-flow/" data-planner-link="planner_demo_open" data-placement="home">Plan my pay and bills <ToolIcon name="arrow"/></a>
      <p class="home-promise"><ToolIcon name="shield"/> Free. No sign-up. No bank connection.</p>
    </div>
    <aside class="quick-savings" aria-labelledby="home-example-title">
      <p class="home-section-kicker">A SIMPLE EXAMPLE · AUD</p><h2 id="home-example-title">Pay comes Wednesday. Rent leaves Monday.</h2>
      <div class="planner-timeline">
        <div class="planner-day"><span>START</span><strong>A$400</strong><small>Money you have</small></div>
        <div class="planner-day planner-day--bill"><span>MONDAY</span><strong>−A$250</strong><small>After A$650 rent</small></div>
        <div class="planner-day"><span>WEDNESDAY</span><strong>A$1,950</strong><small>After A$2,200 pay</small></div>
      </div>
      <p class="planner-small">Illustrative dates: 12–14 October 2026. These entries finish with A${(example.closingBalanceCents/100).toLocaleString('en-AU')}, but Monday is A$250 short. The planner checks days, not just totals.</p>
      <a class="home-text-action" href={`/tools/cash-flow/?preset=${HOME_EXAMPLE_PRESET_ID}#planner`}>Run this exact example &amp; try your numbers →</a>
    </aside>
  </section></div>
  <section class="home-wrap" style="padding-block:2rem" aria-labelledby="home-steps"><h2 id="home-steps">Three things to add.</h2><div class="planner-steps">
    <article><span class="planner-step-number">01</span><h3>Money you have now</h3><p>Your balance before the first payment.</p></article>
    <article><span class="planner-step-number">02</span><h3>Money coming in</h3><p>Your pay or other money, its amount and the date it arrives.</p></article>
    <article><span class="planner-step-number">03</span><h3>Money going out</h3><p>Bills and everyday spending, with the dates they leave.</p></article>
  </div><p class="planner-small" style="margin-top:1rem">The plan covers 13 weeks in Australian dollars. It uses only your entries and does not add tax, interest or fees. It is a planning tool, not a guarantee that payments will clear.</p></section>
  <section class="home-wrap" style="padding-block:1rem 3rem" aria-labelledby="home-support"><h2 id="home-support">Need a different number?</h2><details class="planner-faq"><summary>Other free money tools</summary><div class="home-small-tools">
    <a href="/calculators/salary/"><ToolIcon name="wallet"/><span><strong>Pay after tax</strong><span>Estimate the pay you receive.</span></span><ToolIcon name="arrow"/></a>
    <a href="/calculators/compound-interest/"><ToolIcon name="growth"/><span><strong>Savings</strong><span>Try a savings projection.</span></span><ToolIcon name="arrow"/></a>
    <a href="/calculators/mortgage/"><ToolIcon name="home"/><span><strong>Home-loan payments</strong><span>Estimate repayments.</span></span><ToolIcon name="arrow"/></a>
  </div><p><a href="/help/">All tools and help →</a></p></details><p class="planner-small" style="margin-top:1rem">Independent education project. <a href="/about/">About Howloop</a> · <a href="/methodology/#cash-flow">How the planner works</a> · <a href="/contact/">Contact &amp; corrections</a></p></section>
</div>
<script>import '../scripts/product-events.mjs';</script>
</Base>

