---
import Base from '../../layouts/Base.astro';
import guides from '../../data/learning.json';
---
<Base title="Australian money guides" description="Plain-English guides to savings, compound interest, bonus rates, home deposits, offset accounts and emergency funds. Understand the numbers before your next decision."><header class="hl-page-head hl-wrap"><div class="hl-breadcrumb"><a href="/">Home</a> / Money guides</div><span class="hl-eyebrow">A LITTLE KNOW-HOW GOES A LONG WAY</span><h1>Money, made<br/>a little clearer.</h1><p>Practical explanations, worked examples and sources you can check. Start with the question on your mind.</p></header><div class="hl-wrap hl-page-main"><div class="hl-guide-grid">{guides.map((g,i)=><a class="hl-tool-card" href={'/learn/'+g.slug} style="min-height:240px"><span class="hl-card-kicker">{g.category} · {g.minutes} MIN READ</span><h2 style="font-size:26px;line-height:1.2;margin:20px 0">{g.title}</h2><p>{g.summary}</p><span class="hl-card-link">Read the guide <span>↗</span></span></a>)}</div><p class="hl-advert-note">General education, not personal financial advice. <a href="/editorial-policy">How our content is prepared →</a></p></div></Base>
