---
import Base from '../../layouts/Base.astro';
import guides from '../../data/learning.json';
const groups=[
{title:'Build your savings',description:'Separate the money you contribute from the interest it earns. Start with a savings habit, then test the assumptions behind the result.',slugs:['how-compound-interest-works','read-a-savings-projection','building-an-emergency-fund']},
{title:'Understand the account',description:'The headline rate is only one part of a product. Learn how conditions, time limits and fees change the comparison.',slugs:['bonus-interest-conditions']},
{title:'Plan for a home',description:'Turn a deposit target into a contribution plan, or explore how repayments and an offset affect an existing loan.',slugs:['planning-a-home-deposit','offset-vs-extra-repayments']}
];
---
<Base title="Australian money guides" description="Understand saving, bank-rate conditions, home deposits and mortgage offsets through worked examples, scenario comparisons and primary sources.">
<header class="hl-page-head hl-wrap"><div class="hl-breadcrumb"><a href="/">Home</a> / Money guides</div><h1>Money guides.</h1><p>Practical answers, worked examples and tools to try.</p></header>
<div class="hl-wrap hl-page-main">
<nav class="hl-topic-nav" aria-label="Guide topics">{groups.map((group,i)=><a href={'#topic-'+i}>{group.title} ↓</a>)}</nav>
{groups.map((group,i)=><section class="hl-guide-group" id={'topic-'+i}><div class="hl-section-head"><div><h2>{group.title}</h2></div></div><div class="hl-guide-grid">{group.slugs.map(slug=>{const g=guides.find(g=>g.slug===slug)!;return <a class="hl-tool-card" href={'/learn/'+g.slug}><span class="hl-card-kicker">{g.category} · {g.minutes} MIN READ</span><h3>{g.title}</h3><p>{g.summary}</p><span class="hl-card-link">Read the guide <span aria-hidden="true">↗</span></span></a>;})}</div></section>)}
<aside class="hl-help-strip"><a href="/editorial-policy">Editorial policy →</a><a href="/methodology">Calculation methods →</a><a href="/contact">Report a correction →</a></aside>
</div></Base>
