---
import Base from '../../layouts/Base.astro';
import SchoolPicture from '../../components/SchoolPicture.astro';
import {lessons,schoolReview} from '../../data/money-school.mjs';
import '../../styles/money-school.css';
export function getStaticPaths(){return lessons.map((lesson,index)=>({params:{slug:lesson.slug},props:{lesson,index}}));}
const {lesson,index}=Astro.props;const next=lessons[index+1];
---
<Base title={`${lesson.title} — Money School lesson ${index+1}`} description={`${lesson.short} A simple illustrated lesson with a worked example, an activity and a quick question. Free Howloop Money School.`} type="article" publishedTime={new Date(schoolReview.published)} modifiedTime={new Date(schoolReview.checked)}>
<article class="school school-lesson hl-wrap">
 <nav class="school-breadcrumb" aria-label="Breadcrumb"><a href="/money-school/">Money School</a><span aria-hidden="true"> / </span><span>Lesson {index+1} of 5</span></nav>
 <nav class="school-steps" aria-label="Five beginner lessons">{lessons.map((item,i)=><a href={`/money-school/${item.slug}/`} aria-label={`Lesson ${i+1}: ${item.title}`} aria-current={i===index?'page':undefined}>{i+1}</a>)}</nav>
 <header class="school-lesson-head"><p class="school-eyebrow">LESSON {index+1} · {lesson.minutes} MIN · BEGINNER</p><h1>{lesson.title}</h1><p class="school-lead">{lesson.intro}</p></header>
 <figure class="school-figure"><SchoolPicture scene={lesson.scene} description={lesson.caption}/><figcaption>{lesson.caption}</figcaption></figure>
 <div class="school-body"><div class="school-big-idea"><span class="school-eyebrow">THE BIG IDEA</span><p>{lesson.idea}</p></div>
 {lesson.steps.map((step,i)=><section class="school-explanation"><span class="school-step-number" aria-hidden="true">0{i+1}</span><div><h2>{step.title}</h2><p>{step.text}</p></div></section>)}
 <aside class="school-remember"><h2>Keep this little idea.</h2><p>{lesson.remember}</p></aside>
 <section class="school-quiz" data-school-quiz data-answer={lesson.answer} data-explanation={lesson.why}><p class="school-eyebrow">YOUR TURN</p><h2>One quick question.</h2><form><fieldset><legend>{lesson.question}</legend>{lesson.options.map((option,i)=><label><input type="radio" name="answer" value={i}/><span>{option}</span></label>)}</fieldset><button class="school-button" type="submit" data-check hidden>Check my answer →</button><p data-feedback role="status" aria-live="polite" aria-atomic="true"></p></form><details class="school-answer"><summary>Read the answer and explanation</summary><p>{lesson.why}</p></details><p class="school-small">Your answer stays on this page. It is not saved or sent to us.</p></section>
 <section class="school-activity"><p class="school-eyebrow">TRY IT AWAY FROM THE SCREEN</p><h2>A tiny activity.</h2><p>{lesson.activity}</p></section>
 <footer class="school-sources"><p>Written and illustrated by <a href="/about/#publisher">Howloop</a> · Published and sources checked <time datetime={schoolReview.checked}>16 October 2026</time>.</p><h2>Explore the source</h2><ul>{lesson.sources.map(source=><li><a href={source.url}>{source.label} ↗</a></li>)}</ul><p>Fictional examples for learning. General education, not personal financial advice. <a href="/editorial-policy/">How we check our work</a> · <a href="/contact/">Suggest a correction</a></p></footer>
 <nav class="school-next" aria-label="Continue learning">{index>0&&<a href={`/money-school/${lessons[index-1].slug}/`}>← Previous lesson</a>}{next?<a class="school-button" href={`/money-school/${next.slug}/`}>Next: {next.title} →</a>:<div><h2>You’ve reached the end of the first five.</h2><p>Explain one idea to someone else, or revisit any lesson.</p><a class="school-button" href="/money-school/">Back to all five lessons →</a><a class="school-after" href="/learn/how-compound-interest-works/">Explore a deeper interest example ↗</a></div>}</nav>
 </div>
</article>
</Base>
<script>import {initSchoolQuizzes} from '../../scripts/money-school.mjs';initSchoolQuizzes(document);</script>
