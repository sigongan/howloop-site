---
import Base from '../../layouts/Base.astro';
import CashFlowWalkthrough from '../../components/CashFlowWalkthrough.astro';
import { calculateCashFlow, createSampleModel, formatMoney } from '../../lib/cash-flow.mjs';
import '../../styles/cash-flow.css';
const sample = calculateCashFlow(createSampleModel('2026-10-05'));
const dateLabel = (date) => new Intl.DateTimeFormat('en-AU', {day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}).format(new Date(date+'T00:00:00Z'));
---
<Base title="Free fortnightly budget & cash-flow planner Australia" description="Plan weekly or fortnightly pay around monthly bills. See 13 weeks of daily cash balances, follow a worked example, and export your plan. Free, no sign-up.">
<div class="planner-page planner-wrap" data-cash-flow>
  <header class="planner-hero">
    <div><p class="planner-kicker">FREE PAYDAY &amp; BILLS PLANNER</p><h1>Will your money last until payday?</h1><p class="planner-lead">See when cash could run low between paydays. Put weekly, fortnightly and monthly payments on one 13-week calendar, then try your own numbers.</p><p class="planner-small" style="margin-top:.8rem">13 weeks · Australian dollars · No account or bank connection</p></div>
    <div class="planner-note"><strong>Your numbers stay in this browser.</strong><p>No account or bank connection. Nothing saves unless you choose to save it.</p><p class="planner-small">Use the money you receive after tax. The planner does not add tax, interest or fees.</p></div>
  </header>
  <nav class="planner-page-links planner-no-print" aria-label="On this planner"><a href="#planner">Use the planner</a><a href="#worked-example">Follow a worked example</a><a href="/methodology/#cash-flow">Calculation method &amp; sources</a></nav>
  <noscript><div class="planner-note">JavaScript is needed to edit and calculate a plan. The worked example below remains readable. No financial entries are sent to a server.</div></noscript>
  <div class="planner-workspace" id="planner">
    <section class="planner-panel planner-input-panel" data-cash-inputs hidden aria-labelledby="cash-input-title">
      <span class="planner-mode" data-cash-mode>EXAMPLE NUMBERS</span><h2 id="cash-input-title">Add your money and payments.</h2>
      <p class="planner-small">Use labels like “Pay 1” and “Rent”. Don't enter account numbers or other identifying details.</p>
      <div class="planner-actions"><button type="button" class="planner-btn planner-btn--primary" data-cash-blank>Enter my numbers</button><button type="button" class="planner-btn" data-cash-example>Use example</button></div>
      <form data-cash-form novalidate autocomplete="off">
        <div class="planner-fields">
          <label class="planner-field planner-field--wide" for="cash-start">First day<input id="cash-start" name="startDate" type="date" min="2000-01-01" max="2099-10-02" required/><small>Includes this date and the next 90 days.</small></label>
          <label class="planner-field" for="cash-opening">Money you have now (A$)<input id="cash-opening" name="openingBalance" inputmode="decimal" type="text" required/><small>Your balance before the first payment. Use a minus sign if you owe money.</small></label>
          <label class="planner-field" for="cash-buffer">Money to keep aside (A$)<input id="cash-buffer" name="buffer" inputmode="decimal" type="text" required/><small>A target you choose. Enter 0 to skip it. This money is not taken out.</small></label>
        </div>
        <fieldset class="planner-group"><legend>1. Money coming in</legend><p class="planner-small">Add the amount you receive and the day it arrives.</p><div data-cash-income></div><button type="button" class="planner-btn" data-cash-add="income">Add pay or other money</button></fieldset>
        <fieldset class="planner-group"><legend>2. Money going out</legend><p class="planner-small">Add bills, groceries and other spending. Only these payments count.</p><div data-cash-bills></div><button type="button" class="planner-btn" data-cash-add="bills">Add a bill or expense</button></fieldset>
        <p class="planner-small" data-cash-row-count></p>
        <div class="planner-error" data-cash-error role="alert" tabindex="-1" hidden></div>
        <div class="planner-actions"><button class="planner-btn planner-btn--primary" type="submit">Show my plan</button></div>
      </form>
      <div class="planner-note"><strong>Your entries stay here.</strong><p class="planner-small">Nothing saves automatically. “Save on this device” keeps one plan in this browser, without encryption. Anyone using this browser profile may be able to restore it.</p></div>
      <div class="planner-actions"><button class="planner-btn" type="button" data-cash-save>Save on this device</button><button class="planner-btn" type="button" data-cash-restore>Restore saved plan</button><button class="planner-btn" type="button" data-cash-delete>Delete saved plan</button></div>
      <p class="planner-small" data-cash-storage role="status" style="margin-top:.7rem"></p>
    </section>
    <section class="planner-panel" aria-labelledby="cash-result-title" data-cash-results>
      <p class="planner-print-only">Howloop Payday Planner preview · howloop.how/tools/cash-flow/</p>
      <span class="planner-mode" data-cash-result-mode>WORKED EXAMPLE</span><h2 id="cash-result-title" tabindex="-1">Your money over the next 13 weeks.</h2>
      <p class="planner-small" data-cash-period>{dateLabel(sample.startDate)} – {dateLabel(sample.endDate)} · 91 days</p>
      <p class="planner-note" data-cash-status role="status">Illustrative numbers only. Edit the example to build your own plan.</p>
      <div data-cash-output>
      <dl class="planner-summary">
        <div class="planner-metric"><dt>Lowest balance at the end of a day</dt><dd data-cash-low>{formatMoney(sample.minimumClosingBalance.amountCents)}</dd><small data-cash-low-date>{dateLabel(sample.minimumClosingBalance.date)}</small></div>
        <div class="planner-metric"><dt>Money left after 13 weeks</dt><dd data-cash-closing>{formatMoney(sample.closingBalanceCents)}</dd><small>After every listed payment</small></div>
        <div class="planner-metric"><dt>Total money in</dt><dd data-cash-total-in>{formatMoney(sample.totalIncomeCents)}</dd><small>Expected take-home amounts</small></div>
        <div class="planner-metric"><dt>Total money out</dt><dd data-cash-total-out>{formatMoney(sample.totalExpenseCents)}</dd><small>Only the payments you include</small></div>
      </dl>
      <p class="planner-small" aria-hidden="true">Weekly closing balances. Above the line is positive; below is negative.</p><div class="planner-chart" data-cash-chart aria-hidden="true"></div><div class="planner-chart-label" aria-hidden="true"><span>Week 1 closing balance</span><span>Week 13</span></div>
      <div class="planner-note planner-note--warning" data-cash-warning>Check payment timing. Bills may leave before pay arrives on the same day.</div>
      <p class="planner-small" data-cash-buffer-result>Check your chosen buffer against the daily balances below.</p>
      <div class="planner-actions planner-no-print" data-cash-exports hidden><button type="button" class="planner-btn" data-cash-export>Download daily CSV</button><button type="button" class="planner-btn" data-cash-print>Print plan</button></div>
      <p class="planner-small planner-no-print" data-cash-export-note hidden style="margin-top:.7rem">Downloads and printouts contain your entries. Keep them private.</p>
      </div>
    </section>
  </div>
  <section class="planner-section" aria-labelledby="cash-weeks-title"><h2 id="cash-weeks-title">All 13 weeks.</h2><p class="planner-small">Weeks are seven-day blocks starting on your chosen first day. “Low if bills leave first” includes the opening balance and assumes that day's bills clear before that day's income.</p>
    <div class="planner-table-scroll" role="region" aria-label="13-week cash-flow table, scroll horizontally on small screens" tabindex="0"><table class="planner-table"><caption>Weekly cash-flow summary (AUD)</caption><thead><tr><th scope="col">Week / dates</th><th scope="col">Money in</th><th scope="col">Money out</th><th scope="col">Low if bills leave first</th><th scope="col">Closing balance</th></tr></thead><tbody data-cash-weeks>{sample.weeks.map(week=><tr><td>Week {week.weekNumber}<small>{dateLabel(week.startDate)} – {dateLabel(week.endDate)}</small></td><td>{formatMoney(week.incomeCents)}</td><td>{formatMoney(week.expenseCents)}</td><td>{formatMoney(week.conservativeMinimum.amountCents)}</td><td>{formatMoney(week.closingBalanceCents)}</td></tr>)}</tbody></table></div>
  </section>
  <details class="planner-faq planner-no-print" data-cash-daily><summary>Inspect every day and the payments behind it</summary><div class="planner-table-scroll" role="region" aria-label="Daily cash-flow table, scroll horizontally on small screens" tabindex="0"><table class="planner-table"><caption>Daily cash-flow detail (AUD)</caption><thead><tr><th scope="col">Date / payments</th><th scope="col">Money in</th><th scope="col">Money out</th><th scope="col">Low if bills leave first</th><th scope="col">Closing balance</th></tr></thead><tbody data-cash-days>{sample.days.map(day=><tr><td>{dateLabel(day.date)}<small>{day.transactions.map(t=>t.label).join(', ')||'No listed payments'}</small></td><td>{formatMoney(day.incomeCents)}</td><td>{formatMoney(day.expenseCents)}</td><td>{formatMoney(day.withinDayMinimumCents)}</td><td>{formatMoney(day.closingBalanceCents)}</td></tr>)}</tbody></table></div></details>
  <CashFlowWalkthrough><div class="planner-actions"><button type="button" class="planner-btn" data-cash-timing hidden>Try this exact example in the planner</button></div></CashFlowWalkthrough>
  <details class="planner-faq planner-no-print"><summary id="cash-assumptions">Calculation assumptions &amp; limits</summary><ul><li>Dates and amounts are supplied by you. It does not connect to a bank or verify an expected payment.</li><li>Weekly means every 7 days; fortnightly means every 14 days. Monthly payments keep their original day, or use the month's last day when that day does not exist. A 31 January anchor becomes 28/29 February, then 31 March.</li><li>Weekends and public holidays do not shift payments. Enter separate one-off dates when actual timing differs.</li><li>Amounts stay constant on a recurring schedule. For variable pay, add separate one-off entries or edit and recalculate.</li><li>No interest, tax, grants, inflation or fees are added. A positive result does not establish affordability or guarantee that bills will clear.</li></ul></details>

</div>
<script>import '../../scripts/cash-flow.mjs';import '../../scripts/product-events.mjs';</script>
</Base>
