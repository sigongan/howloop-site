---
import Base from '../../layouts/Base.astro';
import TaskPicker from '../../components/TaskPicker.astro';
---
<Base title="Free Australian money tools" description="Find the right free tool for take-home pay, savings goals, bills, home loans or tax preparation. Clear estimates, practical examples and no account required.">
  <header class="finder-page-head hl-wrap">
    <nav class="finder-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">All tools</span></nav>
    <p class="finder-eyebrow">A little clarity goes a long way</p>
    <div class="finder-page-intro"><h1>Your money.<br /><em>Made clearer.</em></h1><p>A pay rise. A first home. A rainy-day fund. Start with the question on your mind, and find a useful next step.</p></div>
  </header>
  <div class="hl-wrap finder-page-main">
    <TaskPicker/>
    <aside class="finder-footnote" aria-label="About these tools">
      <p><strong>A helpful estimate, with the workings.</strong> All amounts are in AUD. Our calculators run in your browser, and optional saved plans stay on your device. Results are educational estimates, not personal financial advice.</p>
      <div><a href="/methodology/">See how we calculate <span aria-hidden="true">↗</span></a><a href="/learn/">Learn with a worked example <span aria-hidden="true">↗</span></a></div>
    </aside>
  </div>
</Base>
