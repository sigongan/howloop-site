---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/GuideCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { TOPICS } from '../../consts';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return Object.values(TOPICS).map((topic) => ({
    params: { topic: topic.id },
    props: {
      topic,
      guides: guides
        .filter((g) => g.data.topic === topic.id)
        .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf()),
    },
  }));
}

const { topic, guides } = Astro.props;
---

<Base
  title={topic.label}
  description={`${topic.blurb} ${guides.length} animated Howloop guides.`}
>
  <header class="pagehead">
    <div class="wrap">
      <p class="eyebrow">{guides.length} guides</p>
      <h1>{topic.label}</h1>
      <p class="lede">{topic.blurb}</p>
      <nav class="filters" aria-label="Filter by topic">
        <a class="chip" href="/guides">All</a>
        {
          Object.values(TOPICS).map((t) => (
            <a
              class:list={['chip', t.id === topic.id && 'chip--brand']}
              href={`/topics/${t.id}`}
            >
              {t.label}
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <div class="wrap listing">
    <div class="grid">
      {guides.map((g) => <GuideCard guide={g} />)}
    </div>
    <AdSlot layout="display" />
  </div>
</Base>

<style>
  .pagehead {
    padding-block: 2.5rem 2rem;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--brand-tint) 60%, var(--paper)),
      var(--paper)
    );
    border-bottom: 1px solid var(--line-soft);
  }

  .pagehead h1 {
    font-size: var(--step-4);
    margin-block-start: 0.4rem;
  }

  .lede {
    margin-block-start: 0.9rem;
    max-width: 56ch;
    font-size: var(--step-1);
    color: var(--ink-2);
    line-height: 1.55;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: 1.4rem;
  }

  .listing {
    padding-block: 2.5rem 4rem;
  }

  .grid {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
</style>
